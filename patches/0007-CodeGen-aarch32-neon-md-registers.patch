+//-----------------------------------------------------------------------------
+// 128-bit values may live in NEON registers (q8-q15, allocated by the
+// register allocator) or in memory (relative/temporary). The helpers below
+// give emitters a register for each operand either way: memory operands are
+// loaded into / stored from a work register (q0-q3, r12 for addresses).
+//-----------------------------------------------------------------------------
+
+void CCodeGen_AArch32::LoadMemory128InRegister(CAArch32Assembler::QUAD_REGISTER dstReg, CSymbol* symbol)
+{
+	LoadMemory128AddressInRegister(g_md128AddressRegister, symbol);
+	m_assembler.Vld1_32x4(dstReg, g_md128AddressRegister);
+}
+
+void CCodeGen_AArch32::StoreRegisterInMemory128(CSymbol* symbol, CAArch32Assembler::QUAD_REGISTER srcReg)
+{
+	LoadMemory128AddressInRegister(g_md128AddressRegister, symbol);
+	m_assembler.Vst1_32x4(srcReg, g_md128AddressRegister);
+}
+
+void CCodeGen_AArch32::MoveMdRegister(CAArch32Assembler::QUAD_REGISTER dstReg, CAArch32Assembler::QUAD_REGISTER srcReg)
+{
+	if(dstReg != srcReg)
+	{
+		m_assembler.Vorr(dstReg, srcReg, srcReg);
+	}
+}
+
+CAArch32Assembler::QUAD_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterDefMd(CSymbol* symbol, CAArch32Assembler::QUAD_REGISTER workRegister)
+{
+	switch(symbol->m_type)
+	{
+	case SYM_REGISTER128:
+		assert(symbol->m_valueLow < MAX_MDREGISTERS);
+		return g_registersMd[symbol->m_valueLow];
+	case SYM_RELATIVE128:
+	case SYM_TEMPORARY128:
+		return workRegister;
+	default:
+		assert(false);
+		return workRegister;
+	}
+}
+
+CAArch32Assembler::QUAD_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterUseMd(CSymbol* symbol, CAArch32Assembler::QUAD_REGISTER workRegister)
+{
+	switch(symbol->m_type)
+	{
+	case SYM_REGISTER128:
+		assert(symbol->m_valueLow < MAX_MDREGISTERS);
+		return g_registersMd[symbol->m_valueLow];
+	case SYM_RELATIVE128:
+	case SYM_TEMPORARY128:
+		LoadMemory128InRegister(workRegister, symbol);
+		return workRegister;
+	default:
+		assert(false);
+		return workRegister;
+	}
+}
+
+CAArch32Assembler::QUAD_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterUseMdCopy(CSymbol* symbol, CAArch32Assembler::QUAD_REGISTER workRegister)
+{
+	//Value in the work register, even if the symbol lives in a register (for
+	//instructions that clobber their sources or need s/d register aliasing).
+	auto reg = PrepareSymbolRegisterUseMd(symbol, workRegister);
+	MoveMdRegister(workRegister, reg);
+	return workRegister;
+}
+
+void CCodeGen_AArch32::CommitSymbolRegisterMd(CSymbol* symbol, CAArch32Assembler::QUAD_REGISTER usedRegister)
+{
+	switch(symbol->m_type)
+	{
+	case SYM_REGISTER128:
+		MoveMdRegister(g_registersMd[symbol->m_valueLow], usedRegister);
+		break;
+	case SYM_RELATIVE128:
+	case SYM_TEMPORARY128:
+		StoreRegisterInMemory128(symbol, usedRegister);
+		break;
+	default:
+		assert(false);
+		break;
+	}
+}
