+#include "StickyFlagsTest.h"
+#include "VuAssembler.h"
+#include <cstdio>
+#include <cstdlib>
+
+void CStickyFlagsTest::Execute(CTestVm& virtualMachine)
+{
+	virtualMachine.Reset();
+
+	auto microMem = reinterpret_cast<uint32*>(virtualMachine.m_microMem);
+
+	//Sticky flags set by FMAC instructions of a block that doesn't read the status
+	//(their sticky pipeline entries can be merged), read by the next block
+
+	CVuAssembler assembler(microMem);
+
+	auto nextBlockLabel = assembler.CreateLabel();
+
+	//Zero result (Z sticky)
+	assembler.Write(
+	    CVuAssembler::Upper::SUB(CVuAssembler::DEST_XYZW, CVuAssembler::VF1, CVuAssembler::VF0, CVuAssembler::VF0),
+	    CVuAssembler::Lower::NOP());
+
+	//Negative result (S sticky)
+	assembler.Write(
+	    CVuAssembler::Upper::SUB(CVuAssembler::DEST_XYZ, CVuAssembler::VF2, CVuAssembler::VF0, CVuAssembler::VF3),
+	    CVuAssembler::Lower::NOP());
+
+	//Positive results (no flags)
+	for(uint32 i = 0; i < 5; i++)
+	{
+		assembler.Write(
+		    CVuAssembler::Upper::ADDbc(CVuAssembler::DEST_XYZW, CVuAssembler::VF4, CVuAssembler::VF3, CVuAssembler::VF3, CVuAssembler::BC_X),
+		    CVuAssembler::Lower::NOP());
+	}
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP(),
+	    CVuAssembler::Lower::B(nextBlockLabel));
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP(),
+	    CVuAssembler::Lower::NOP());
+
+	assembler.MarkLabel(nextBlockLabel);
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP(),
+	    CVuAssembler::Lower::FSAND(CVuAssembler::VI1, 0xFFF));
+
+	for(uint32 i = 0; i < 6; i++)
+	{
+		assembler.Write(
+		    CVuAssembler::Upper::NOP(),
+		    CVuAssembler::Lower::NOP());
+	}
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP(),
+	    CVuAssembler::Lower::FSAND(CVuAssembler::VI2, 0xFFF));
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP() | CVuAssembler::Upper::E_BIT,
+	    CVuAssembler::Lower::NOP());
+
+	assembler.Write(
+	    CVuAssembler::Upper::NOP(),
+	    CVuAssembler::Lower::NOP());
+
+	virtualMachine.m_cpu.m_State.nCOP2[3].nV0 = 0x3F800000; //VF3 = (1, 1, 1, 1)
+	virtualMachine.m_cpu.m_State.nCOP2[3].nV1 = 0x3F800000;
+	virtualMachine.m_cpu.m_State.nCOP2[3].nV2 = 0x3F800000;
+	virtualMachine.m_cpu.m_State.nCOP2[3].nV3 = 0x3F800000;
+
+	virtualMachine.ExecuteTest(0);
+
+	if(getenv("STICKY_TEST_PRINT"))
+	{
+		fprintf(stderr, "sticky test: VI1 %04X VI2 %04X\n", virtualMachine.m_cpu.m_State.nCOP2VI[1], virtualMachine.m_cpu.m_State.nCOP2VI[2]);
+	}
+	TEST_VERIFY(virtualMachine.m_cpu.m_State.nCOP2VI[1] == 0x00C0);
+	TEST_VERIFY(virtualMachine.m_cpu.m_State.nCOP2VI[2] == 0x00C0);
+}
