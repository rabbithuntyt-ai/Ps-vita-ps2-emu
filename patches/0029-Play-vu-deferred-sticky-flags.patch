+//Sticky flags are cumulative: when nothing in the block reads or sets the status,
+//the entries of FMAC instructions that become visible before the block ends can be
+//merged into one (queued after the last of them). Returns that instruction's index.
+uint32 CVuBasicBlock::ComputeDeferStickyHints(const std::vector<uint32>& fmacStallDelays, std::vector<uint32>& hints) const
+{
+	static const bool disabled = (getenv("PLAY_NO_VU_STICKY_DEFER") != nullptr);
+	if(disabled) return -1;
+
+	auto arch = static_cast<CMA_VU*>(m_context.m_pArch);
+	uint32 maxInstructions = static_cast<uint32>(hints.size());
+
+	uint32 maxPipeTime = maxInstructions;
+	for(const auto& fmacStallDelay : fmacStallDelays)
+		maxPipeTime += fmacStallDelay;
+
+	std::vector<uint32> deferred;
+	uint32 relativePipeTime = 0;
+	for(uint32 address = m_begin; address <= m_end; address += 8)
+	{
+		uint32 instructionIndex = (address - m_begin) / 8;
+		uint32 opcodeLo = m_context.m_pMemoryMap->GetInstruction(address + 0);
+		uint32 opcodeHi = m_context.m_pMemoryMap->GetInstruction(address + 4);
+
+		//FSEQ/FSSET/FSAND/FSOR (lower opcodes 0x14-0x17) read or set the status
+		uint32 loOp = (opcodeLo >> 25) & 0x7F;
+		if((loOp >= 0x14) && (loOp <= 0x17)) return -1;
+
+		auto hiOps = arch->GetAffectedOperands(&m_context, address + 4, opcodeHi);
+		relativePipeTime += fmacStallDelays[instructionIndex];
+		if(hiOps.writeMACflags && ((relativePipeTime + VUShared::LATENCY_MAC) < maxPipeTime))
+		{
+			deferred.push_back(instructionIndex);
+		}
+		relativePipeTime++;
+	}
+
+	if(deferred.size() < 2) return -1;
+	for(auto instructionIndex : deferred)
+	{
+		hints[instructionIndex] |= VUShared::COMPILEHINT_DEFER_STICKY;
+	}
+	return deferred.back();
+}
