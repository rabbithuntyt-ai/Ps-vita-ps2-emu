+
+void CTier2Block::Execute()
+{
+	using namespace Tier2;
+	if(!m_interpret)
+	{
+		CBasicBlock::Execute();
+		return;
+	}
+	auto& state = m_context.m_State;
+	g_stats.interpretedRuns++;
+	uint64 temp = 0;
+	CInterpreter interpreter(m_context, temp);
+	const auto& blocks = m_region->blocks;
+	int index = 0;
+	while(true)
+	{
+		const auto& block = blocks[index];
+		for(const auto& inst : block.insts) interpreter.Run(inst);
+		const EDGE* edge = &block.next;
+		switch(block.term)
+		{
+		case TERM_GOTO: break;
+		case TERM_BRANCH:
+			if(CInterpreter::Test(block.cond, interpreter.Get(block.rs), interpreter.Get(block.rt))) edge = &block.taken;
+			break;
+		case TERM_GUARD:
+			if(static_cast<uint32>(interpreter.Get(block.rs)) == block.expected) edge = &block.taken;
+			break;
+		}
+		state.cycleQuota -= edge->cycles;
+		bool stay = (edge->target >= 0) && (!edge->check || ((state.cycleQuota > 0) && (state.nHasException == 0)));
+		if(stay)
+		{
+			index = edge->target;
+			continue;
+		}
+		if(edge->target == EDGE_EXIT_REG)
+			state.nPC = static_cast<uint32>(interpreter.Get(block.rs));
+		else if(edge->target == EDGE_EXIT)
+			state.nPC = edge->pc;
+		else
+			state.nPC = blocks[edge->target].pc;
+		if(state.cycleQuota <= 0) state.nHasException |= MIPS_EXCEPTION_STATUS_QUOTADONE;
+		return;
+	}
+}
