+//--------------------------------------------------------------------------
+
+CTier2Block::CTier2Block(CMIPS& context, uint32 begin, BLOCK_CATEGORY category)
+    : CBasicBlock(context, begin, begin, category)
+{
+}
+
+CTier2Block::~CTier2Block() = default;
+
+void CTier2Block::SetExcluded(std::function<bool(uint32)> excluded)
+{
+	m_excluded = std::move(excluded);
+}
+
+bool CTier2Block::Build()
+{
+	using namespace Tier2;
+	auto start = std::chrono::steady_clock::now();
+	m_region = std::make_unique<REGION>();
+	CBuilder builder(m_context, *m_region);
+	builder.m_excluded = m_excluded;
+	if(!builder.Build(m_begin))
+	{
+		g_stats.failed++;
+		m_region.reset();
+		return false;
+	}
+	//Guest ranges (for invalidation)
+	for(const auto& block : m_region->blocks)
+	{
+		if(block.begin <= block.end) m_ranges.push_back({block.begin, block.end});
+	}
+	m_end = m_region->blocks[0].end >= m_begin ? m_region->blocks[0].end : m_begin;
+
+	MODE mode = GetEffectiveMode();
+	if((mode == MODE_NATIVE) && ((m_begin < g_settings.nativeLow) || (m_begin >= g_settings.nativeHigh))) mode = MODE_INTERPRET;
+	bool compiled = false;
+	//Debugging: the ARM code written to TIER2_DUMP/<address>.bin, whatever the host
+	if(const char* dumpDir = getenv("TIER2_DUMP"))
+	{
+		std::vector<uint8> code;
+		uint32 linkEntryOffset = 0;
+		CArmCompiler compiler(*m_region);
+		if(compiler.Compile(code, linkEntryOffset))
+		{
+			char path[512];
+			snprintf(path, sizeof(path), "%s/%08X.bin", dumpDir, m_begin);
+			if(FILE* file = fopen(path, "wb"))
+			{
+				fwrite(code.data(), 1, code.size(), file);
+				fclose(file);
+			}
+		}
+	}
+	if(mode == MODE_NATIVE)
+	{
+		std::vector<uint8> code;
+		uint32 linkEntryOffset = 0;
+		CArmCompiler compiler(*m_region);
+		if(compiler.Compile(code, linkEntryOffset))
+		{
+			SetNativeCode(code.data(), code.size(), linkEntryOffset);
+			g_stats.codeBytes += code.size();
+			compiled = true;
+		}
+	}
+	if(!compiled)
+	{
+		//Interpreted: the JIT makes an empty function to link to (it returns to the executor,
+		//which calls Execute)
+		m_interpret = true;
+		Compile();
+	}
+	if(g_settings.dumpPath && (m_begin >= g_settings.nativeLow) && (m_begin < g_settings.nativeHigh))
+	{
+		if(FILE* file = fopen(g_settings.dumpPath, "a"))
+		{
+			fprintf(file, "region %08X (nPC %08X, ra %08X, sp %08X)", m_begin, m_context.m_State.nPC, m_context.m_State.nGPR[31].nV0, m_context.m_State.nGPR[29].nV0);
+			fputc(10, file);
+			for(const auto& range : m_ranges)
+			{
+				fprintf(file, "code %08X:", range.begin);
+				for(uint32 address = range.begin; address <= range.end; address += 4) fprintf(file, " %08X", m_context.m_pMemoryMap->GetInstruction(address));
+				fputc(10, file);
+			}
+			Dump(file);
+			fclose(file);
+		}
+	}
+	if(g_stats.regions < 1024) g_stats.entries[g_stats.regions] = m_begin;
+	g_stats.regions++;
+	g_stats.guestInstructions += m_region->instructions;
+	g_stats.compileUs += std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count();
+	return true;
+}
+
+void CTier2Block::Dump(FILE* file) const
+{
+	using namespace Tier2;
+	static const char* opNames[] = {"addu", "subu", "sllv", "srlv", "srav", "and", "or", "xor", "nor", "slt", "sltu", "daddu", "dsubu",
+	                                "dsllv", "dsrlv", "dsrav", "movz", "movn", "sll", "srl", "sra", "dsll", "dsrl", "dsra", "addiu", "daddiu",
+	                                "slti", "sltiu", "andi", "ori", "xori", "li", "lb", "lbu", "lh", "lhu", "lw", "lwu", "ld", "sb", "sh",
+	                                "sw", "sd", "cond", "lq", "sq", "mult", "multu", "mfhi", "mflo", "mthi", "mtlo"};
+	static const char* condNames[] = {"eq", "ne", "lez", "gtz", "ltz", "gez"};
+	if(!m_region)
+	{
+		fprintf(file, "no region\n");
+		return;
+	}
+	auto edgeText = [&](const EDGE& edge, char* text, size_t size) {
+		const char* check = edge.check ? "" : " nocheck";
+		if(edge.target >= 0)
+			snprintf(text, size, "b%d (%08X) c%u%s", edge.target, m_region->blocks[edge.target].pc, edge.cycles, check);
+		else if(edge.target == EDGE_EXIT)
+			snprintf(text, size, "exit %08X c%u%s", edge.pc, edge.cycles, check);
+		else
+			snprintf(text, size, "exit reg c%u%s", edge.cycles, check);
+	};
+	for(size_t i = 0; i < m_region->blocks.size(); i++)
+	{
+		const auto& block = m_region->blocks[i];
+		fprintf(file, "b%u %08X [%08X-%08X] stack %u\n", static_cast<unsigned int>(i), block.pc, block.begin, block.end, static_cast<unsigned int>(block.stack.size()));
+		for(const auto& inst : block.insts)
+		{
+			fprintf(file, "  %-6s rd %u rs %u rt %u sa %u imm %d\n", opNames[inst.op], inst.rd, inst.rs, inst.rt, inst.sa, inst.imm);
+		}
+		char taken[128], next[128];
+		edgeText(block.taken, taken, sizeof(taken));
+		edgeText(block.next, next, sizeof(next));
+		switch(block.term)
+		{
+		case TERM_GOTO: fprintf(file, "  goto %s (reg %u)\n", next, block.rs); break;
+		case TERM_BRANCH: fprintf(file, "  if %s(r%u, r%u) %s else %s\n", condNames[block.cond], block.rs, block.rt, taken, next); break;
+		case TERM_GUARD: fprintf(file, "  if r%u == %08X %s else %s\n", block.rs, block.expected, taken, next); break;
+		}
+	}
+}
