+bool CEeExecutor::IsExcludedFromTier2(uint32 address) const
+{
+	return m_blockFpRoundingModes.count(address) || m_idleLoopBlocks.count(address) || m_blockFpUseAccurateAddSub.count(address) ||
+	       m_context.HasBreakpointInRange(address, address);
+}
+
+//A region at 'address'; replace: a block may be there already (it is dropped)
+bool CEeExecutor::TryTier2(uint32 address, bool replace)
+{
+	if((address < 0x100000) || (address >= PS2::EE_RAM_SIZE) || IsExcludedFromTier2(address)) return false;
+	auto region = std::make_shared<CTier2Block>(m_context, address, m_blockCategory);
+	region->SetExcluded([this](uint32 pc) { return IsExcludedFromTier2(pc); });
+	{
+		EmuProfile::CScope profileScope(EmuProfile::SECTION_JIT);
+		if(!region->Build()) return false;
+	}
+	if(replace && HasBlockAt(address))
+	{
+		CGenericMipsExecutor::ClearActiveBlocksInRange(address, address + 4, false);
+		if(HasBlockAt(address)) return false;
+	}
+	m_pendingTier2 = region;
+	CreateBlock(address, region->GetEndAddress());
+	m_pendingTier2.reset();
+	//No link slots of its own (it leaves through the indirect dispatch); blocks
+	//waiting for this address link to it
+	ResolveIncomingLinks(address, FindBlockStartingAt(address));
+	m_tier2Ranges[address] = region->GetRanges();
+	return true;
+}
+
+void CEeExecutor::RequestTier2(uint32 address)
+{
+	std::lock_guard<std::mutex> lock(m_tier2RequestMutex);
+	if(m_tier2Requests.size() < 64) m_tier2Requests.push_back(address);
+	m_hasTier2Requests = true;
+}
+
+void CEeExecutor::ProcessTier2Requests()
+{
+	std::vector<uint32> requests;
+	{
+		std::lock_guard<std::mutex> lock(m_tier2RequestMutex);
+		requests.swap(m_tier2Requests);
+		m_hasTier2Requests = false;
+	}
+	if(Tier2::GetEffectiveMode() == Tier2::MODE_OFF) return;
+	for(uint32 address : requests)
+	{
+		address &= m_addressMask;
+		if((address & 3) != 0) continue;
+		if(m_tier2Ranges.count(address) && HasBlockAt(address)) continue; //already
+		TryTier2(address, true);
+	}
+}
+
+int CEeExecutor::Execute(int cycles)
+{
+	if(m_hasTier2Requests.load(std::memory_order_relaxed)) ProcessTier2Requests();
+	return CGenericMipsExecutor::Execute(cycles);
 }
 
