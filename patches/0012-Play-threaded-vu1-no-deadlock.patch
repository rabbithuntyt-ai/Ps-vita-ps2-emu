+bool CVpu::SyncFor(uint32 timeoutMs)
+{
+	if(!m_threaded) return true;
+	bool idle = false;
+	{
+		std::unique_lock<std::mutex> lock(m_workerMutex);
+		idle = m_idleCondition.wait_for(lock, std::chrono::milliseconds(timeoutMs),
+		                                [this]() { return !m_workPending && (m_vuState != VU_STATE_RUNNING); });
+	}
+	FlushPendingXgKicks();
+	RaisePendingInterrupt();
+	return idle;
+}
+
+uint32 CVpu::GetProgramRunMs() const
+{
+	if(m_vuState != VU_STATE_RUNNING) return 0;
+	auto now = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	return static_cast<uint32>(now - m_programStartMs.load());
+}
