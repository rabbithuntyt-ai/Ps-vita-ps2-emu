+
 void CPS2VM::ReloadFrameRateLimit()
 {
 	uint32 hRefreshRate = PS2::GS_NTSC_HSYNC_FREQ;
@@ -252,7 +258,7 @@ void CPS2VM::ReloadFrameRateLimit()
 	//At 1x scale, IOP runs 8 times slower than EE
 	//64-bit: EE_CLOCK_FREQ * numerator overflows 32 bits for ratios like 100/100
 	uint32 eeFreqScaled = static_cast<uint32>(static_cast<uint64>(PS2::EE_CLOCK_FREQ) * m_eeFreqScaleNumerator / m_eeFreqScaleDenominator);
-	m_iopTickStep = (m_eeTickStep / 8) * m_eeFreqScaleDenominator / m_eeFreqScaleNumerator;
+	m_iopTickStep = (m_eeTickStep / 8) * m_eeFreqScaleDenominator / m_eeFreqScaleNumerator * m_iopRatePercent / 100;
 
 	m_hblankTicksTotal = eeFreqScaled / hRefreshRate;
 
