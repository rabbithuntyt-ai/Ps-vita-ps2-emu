+	// For whole PSMT4 pages: the source nibble of every nibble of a page, as an
+	// index from the page's first source pixel in a transfer 'rrw' pixels wide
+	// (y * rrw + x). Rebuilt when rrw changes (GS thread only).
+	inline const uint32* GetPsmt4PageSources(uint32 rrw)
+	{
+		typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+		static uint32 tableRrw = 0;
+		static uint32 table[Storage::PAGEWIDTH * Storage::PAGEHEIGHT];
+		if(tableRrw != rrw)
+		{
+			const uint32* pageOffsets = CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets();
+			for(uint32 y = 0; y < Storage::PAGEHEIGHT; y++)
+				for(uint32 x = 0; x < Storage::PAGEWIDTH; x++)
+					table[pageOffsets[y * Storage::PAGEWIDTH + x]] = y * rrw + x;
+			tableRrw = rrw;
+		}
+		return table;
+	}
+
+	// One row of whole PSMT4 pages (128 transfer rows): every byte of each page
+	// is built from its two source nibbles, a word at a time (no per pixel read,
+	// modify, write). False if the pages are not all inside GS memory.
+	inline bool WritePsmt4PageRow(uint8* ram, uint32 ramSize, uint32 pointer, uint32 bufferWidth, uint32 x, uint32 y, uint32 rrw,
+	                              const uint8* source, bool& dirty)
+	{
+		typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+		uint32 rowPage = ((y / Storage::PAGEHEIGHT) * (bufferWidth * 64)) / Storage::PAGEWIDTH;
+		uint32 pages = rrw / Storage::PAGEWIDTH;
+		for(uint32 k = 0; k < pages; k++)
+		{
+			uint32 address = pointer + (rowPage + x / Storage::PAGEWIDTH + k) * CGsPixelFormats::PAGESIZE;
+			if(address + CGsPixelFormats::PAGESIZE > ramSize) return false;
+		}
+		const uint32* sources = GetPsmt4PageSources(rrw);
+		for(uint32 k = 0; k < pages; k++)
+		{
+			uint32* page = reinterpret_cast<uint32*>(ram + pointer + (rowPage + x / Storage::PAGEWIDTH + k) * CGsPixelFormats::PAGESIZE);
+			uint32 base = k * Storage::PAGEWIDTH;
+			for(uint32 w = 0; w < CGsPixelFormats::PAGESIZE / 4; w++)
+			{
+				const uint32* nibbleSources = sources + w * 8;
+				uint32 word = 0;
+				for(uint32 j = 0; j < 8; j++)
+				{
+					uint32 n = base + nibbleSources[j];
+					word |= ((source[n >> 1] >> ((n & 1) * 4)) & 0x0F) << (j * 4);
+				}
+				if(page[w] != word)
+				{
+					page[w] = word;
+					dirty = true;
+				}
+			}
+		}
+		return true;
+	}
