+void CEeExecutor::PartitionFunction(uint32 startAddress)
+{
+	//Inside a region already compiled (entered there after a quota exit, or by a
+	//branch from elsewhere): a block, not another overlapping region (each would
+	//compile the same code again: loop programs spent seconds compiling)
+	bool insideRegion = false;
+	for(auto it = m_regionRanges.begin(); it != m_regionRanges.end();)
+	{
+		auto block = FindBlockStartingAt(it->first);
+		if(block->IsEmpty() || (block->GetEndAddress() != it->second))
+		{
+			it = m_regionRanges.erase(it); //cleared since
+			continue;
+		}
+		if((startAddress > it->first) && (startAddress <= it->second)) insideRegion = true;
+		++it;
+	}
+	if(g_regions && !insideRegion && (startAddress >= 0x100000) && (startAddress < PS2::EE_RAM_SIZE))
+	{
+		auto parts = CEeRegionBlock::Find(m_context, startAddress, 32, 256);
+		//Per-block settings and breakpoints keep their blocks
+		for(const auto& part : parts)
+		{
+			if(m_blockFpRoundingModes.count(part.begin) || m_idleLoopBlocks.count(part.begin) || m_blockFpUseAccurateAddSub.count(part.begin) ||
+			   m_context.HasBreakpointInRange(part.begin, part.end))
+			{
+				parts.clear();
+				break;
+			}
+		}
+		if(!parts.empty())
+		{
+			uint32 endAddress = parts.back().end;
+			m_pendingRegion = std::move(parts);
+			CreateBlock(startAddress, endAddress);
+			m_pendingRegion.clear();
+			//No link slots of its own (it leaves through the indirect dispatch);
+			//blocks waiting for this address link to it.
+			ResolveIncomingLinks(startAddress, FindBlockStartingAt(startAddress));
+			m_regionRanges[startAddress] = endAddress;
+			return;
+		}
+	}
+	CGenericMipsExecutor::PartitionFunction(startAddress);
+}
+
 BasicBlockPtr CEeExecutor::BlockFactory(CMIPS& context, uint32 start, uint32 end)
 {
 	EmuProfile::CScope profileScope(EmuProfile::SECTION_JIT);
 	uint32 blockSize = (end - start) + 4;
 
+	if(!m_pendingRegion.empty() && (m_pendingRegion.front().begin == start))
+	{
+		if(start >= 0x100000 && start < PS2::EE_RAM_SIZE)
+		{
+			SetMemoryProtected(m_ram + start, blockSize, true);
+		}
+		auto region = std::make_shared<CEeRegionBlock>(context, m_pendingRegion, m_blockCategory);
+		region->Compile(); //not in the JIT caches: compiled each run
+		EmuProfile::g_regions++;
+		EmuProfile::g_regionInstructions += blockSize / 4;
+		return region;
+	}
+
 	//Kernel area is below 0x100000 and isn't protected. Some games will write code in there
 	//but it is safe to assume that it won't change (code writes some data just besides itself
 	//so it keeps generating exceptions, making the game slower)
