+CEeRegionBlock::CEeRegionBlock(CMIPS& context, std::vector<PART> parts, BLOCK_CATEGORY category)
+    : CEeBasicBlock(context, parts.front().begin, parts.back().end, category)
+    , m_parts(std::move(parts))
+{
+}
