+//Tier 2: consecutive blocks of a function compiled as one unit. Each part is
+//compiled like a block of its own (same instructions, cycles counted per part,
+//exception test after each), but branches between parts jump straight to a
+//label: no exit, link or dispatch between them. Loops back check the cycle
+//quota (interrupts). Only the last part may end with a call, return or jalr.
+class CEeRegionBlock : public CEeBasicBlock
+{
+public:
+	struct PART
+	{
+		uint32 begin = 0;
+		uint32 end = 0;      //the delay slot
+		int target = -1;     //index of the part the branch goes to, -1: none inside
+		bool unconditional = false;
+	};
+
+	CEeRegionBlock(CMIPS&, std::vector<PART>, BLOCK_CATEGORY);
+	void CompileRange(CMipsJitter*) override;
+
+	//Parts of a region starting at 'start', or empty when there is none worth
+	//making (no branch between parts, or code a region cannot hold).
+	static std::vector<PART> Find(CMIPS&, uint32 start, uint32 maxParts, uint32 maxInstructions);
+
+private:
+	std::vector<PART> m_parts;
+};
