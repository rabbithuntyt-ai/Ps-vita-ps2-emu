+
+namespace
+{
+	enum BRANCH_KIND
+	{
+		BRANCH_STATIC,        //conditional or j: a target known at compile time
+		BRANCH_LAST,          //jal, jr, jalr, branch and link: only as the last part
+		BRANCH_NOT_IN_REGION, //likely branches (they skip their delay slot): no region holds them
+	};
+
+	BRANCH_KIND ClassifyBranch(uint32 opcode)
+	{
+		uint32 op = opcode >> 26;
+		uint32 rt = (opcode >> 16) & 0x1F;
+		uint32 rs = (opcode >> 21) & 0x1F;
+		switch(op)
+		{
+		case 0x00: //jr, jalr
+			return BRANCH_LAST;
+		case 0x01: //REGIMM
+			if((rt == 0x00) || (rt == 0x01)) return BRANCH_STATIC;              //bltz, bgez
+			if((rt == 0x10) || (rt == 0x11)) return BRANCH_LAST;                //bltzal, bgezal
+			return BRANCH_NOT_IN_REGION;                                          //likely forms
+		case 0x02: //j
+			return BRANCH_STATIC;
+		case 0x03: //jal
+			return BRANCH_LAST;
+		case 0x04: //beq
+		case 0x05: //bne
+		case 0x06: //blez
+		case 0x07: //bgtz
+			return BRANCH_STATIC;
+		case 0x11: //COP1 bc1f/bc1t (bc1fl/bc1tl are likely)
+		case 0x12: //COP2 bc2f/bc2t
+			if((rs == 0x08) && ((rt & 0x02) == 0)) return BRANCH_STATIC;
+			return BRANCH_NOT_IN_REGION;
+		default:
+			return BRANCH_NOT_IN_REGION;
+		}
+	}
+}
