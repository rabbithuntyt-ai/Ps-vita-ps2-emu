+std::vector<CEeRegionBlock::PART> CEeRegionBlock::Find(CMIPS& context, uint32 start, uint32 maxParts, uint32 maxInstructions)
+{
+	std::vector<PART> parts;
+	std::vector<uint32> targets;
+	uint32 address = start;
+	uint32 instructions = 0;
+	bool last = false;
+	while(!last && (parts.size() < maxParts) && (instructions < maxInstructions))
+	{
+		//One part: to the first branch and its delay slot (CGenericMipsExecutor::PartitionFunction)
+		uint32 branchAddress = MIPS_INVALID_PC;
+		for(uint32 scan = address; scan < address + 0x400; scan += 4)
+		{
+			uint32 opcode = context.m_pMemoryMap->GetInstruction(scan);
+			auto type = context.m_pArch->IsInstructionBranch(&context, scan, opcode);
+			if(type == MIPS_BRANCH_NODELAY) break; //syscall, eret...: not in a region
+			if(type == MIPS_BRANCH_NORMAL)
+			{
+				branchAddress = scan;
+				break;
+			}
+		}
+		if(branchAddress == MIPS_INVALID_PC) break;
+		uint32 branchOpcode = context.m_pMemoryMap->GetInstruction(branchAddress);
+		uint32 delayOpcode = context.m_pMemoryMap->GetInstruction(branchAddress + 4);
+		if(context.m_pArch->IsInstructionBranch(&context, branchAddress + 4, delayOpcode) != MIPS_BRANCH_NONE) break;
+		auto kind = ClassifyBranch(branchOpcode);
+		if(kind == BRANCH_NOT_IN_REGION) break;
+		PART part;
+		part.begin = address;
+		part.end = branchAddress + 4;
+		if(IsIdleLoopRange(context, part.begin, part.end)) break; //idle loop detection works per block
+		if(kind == BRANCH_STATIC)
+		{
+			targets.push_back(context.m_pArch->GetInstructionEffectiveAddress(&context, branchAddress, branchOpcode));
+			part.unconditional = ((branchOpcode >> 26) == 0x02);
+		}
+		else
+		{
+			targets.push_back(MIPS_INVALID_PC);
+			last = true;
+		}
+		parts.push_back(part);
+		instructions += ((part.end - part.begin) / 4) + 1;
+		address = part.end + 4;
+	}
+	//Branches between parts
+	bool internal = false;
+	for(size_t i = 0; i < parts.size(); i++)
+	{
+		for(size_t j = 0; j < parts.size(); j++)
+		{
+			if(targets[i] == parts[j].begin)
+			{
+				parts[i].target = static_cast<int>(j);
+				internal = true;
+			}
+		}
+	}
+	if(!internal || (parts.size() < 2)) parts.clear();
+	return parts;
+}
+
+void CEeRegionBlock::CompileRange(CMipsJitter* jitter)
+{
+	auto arch = static_cast<CMA_MIPSIV*>(m_context.m_pArch);
+	m_context.m_pArch->SetCompileHints(m_blockCompileHints);
+	CompileProlog(jitter);
+	jitter->MarkFirstBlockLabel();
+
+	std::vector<Jitter::CJitter::LABEL> labels;
+	for(size_t i = 0; i < m_parts.size(); i++) labels.push_back(jitter->CreateLabel());
+	auto exitLabel = jitter->CreateLabel();
+
+	//nPC holds the region's start while it runs: instructions compute addresses from it
+	auto setPcOffset = [&](uint32 address) {
+		jitter->PushRel(offsetof(CMIPS, m_State.nPC));
+		jitter->PushCst(address - m_begin);
+		jitter->Add();
+		jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+	};
+	//Leave with nPC set: to the next block when the quota allows, else to the executor
+	auto leave = [&]() {
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(0);
+		jitter->BeginIf(Jitter::CONDITION_GT);
+		{
+			jitter->JumpToDynamic(reinterpret_cast<void*>(&RegionExitTrampoline));
+		}
+		jitter->EndIf();
+		jitter->Goto(exitLabel);
+	};
+
+	for(size_t i = 0; i < m_parts.size(); i++)
+	{
+		const auto& part = m_parts[i];
+		jitter->MarkLabel(labels[i]);
+		//Other parts jump here: nothing is known about the registers
+		arch->ResetBlockKnowledge();
+		for(uint32 address = part.begin; address <= part.end; address += 4)
+		{
+			m_context.m_pArch->CompileInstruction(address, jitter, &m_context, address - m_begin);
+			assert(jitter->IsStackEmpty());
+		}
+
+		//Cycles, as if this part were a block
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(((part.end - part.begin) / 4) + 1);
+		jitter->Sub();
+		jitter->PullRel(offsetof(CMIPS, m_State.cycleQuota));
+
+		//An exception (syscall-like instruction, VU0 call...): leave as a block would
+		jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+		jitter->PushCst(0);
+		jitter->BeginIf(Jitter::CONDITION_NE);
+		{
+			jitter->PushRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+			jitter->PushCst(MIPS_INVALID_PC);
+			jitter->Cmp(Jitter::CONDITION_NE);
+			jitter->PushRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+			jitter->PushRel(offsetof(CMIPS, m_State.nPC));
+			jitter->PushCst(part.end + 4 - m_begin);
+			jitter->Add();
+			jitter->Select();
+			jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+			jitter->PushCst(MIPS_INVALID_PC);
+			jitter->PullRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+			jitter->Goto(exitLabel);
+		}
+		jitter->EndIf();
+
+		bool hasNext = (i + 1) < m_parts.size();
+		if(part.target >= 0)
+		{
+			//Branch inside the region
+			const auto& target = m_parts[part.target];
+			auto goInside = [&]() {
+				jitter->PushCst(MIPS_INVALID_PC);
+				jitter->PullRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+				if(static_cast<size_t>(part.target) <= i)
+				{
+					//Loop back: interrupts need the quota checked
+					jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+					jitter->PushCst(0);
+					jitter->BeginIf(Jitter::CONDITION_LE);
+					{
+						setPcOffset(target.begin);
+						jitter->Goto(exitLabel);
+					}
+					jitter->EndIf();
+				}
+				jitter->Goto(labels[part.target]);
+			};
+			if(part.unconditional)
+			{
+				goInside();
+				continue;
+			}
+			jitter->PushRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+			jitter->PushCst(MIPS_INVALID_PC);
+			jitter->BeginIf(Jitter::CONDITION_NE);
+			{
+				goInside();
+			}
+			jitter->EndIf();
+		}
+		else
+		{
+			//Branch out of the region (static target outside, or call/return as the last part)
+			jitter->PushRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+			jitter->PushCst(MIPS_INVALID_PC);
+			jitter->BeginIf(Jitter::CONDITION_NE);
+			{
+				jitter->PushRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+				jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+				jitter->PushCst(MIPS_INVALID_PC);
+				jitter->PullRel(offsetof(CMIPS, m_State.nDelayedJumpAddr));
+				leave();
+			}
+			jitter->EndIf();
+		}
+		//Not taken: the next part follows, or leave past the end
+		if(!hasNext)
+		{
+			setPcOffset(part.end + 4);
+			leave();
+		}
+	}
+
+	jitter->MarkLastBlockLabel();
+	jitter->MarkLabel(exitLabel);
+	//Back to the executor: flag the quota as done when it is
+	static_assert(MIPS_EXCEPTION_STATUS_QUOTADONE == 0x80, "QUOTADONE must be 0x80");
+	jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+	jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+	jitter->PushCst(0);
+	jitter->Cmp(Jitter::CONDITION_LE);
+	jitter->Shl(7);
+	jitter->Or();
+	jitter->PullRel(offsetof(CMIPS, m_State.nHasException));
+}
