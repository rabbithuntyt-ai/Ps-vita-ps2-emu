diff --git a/Source/app_shared/Log.cpp b/Source/app_shared/Log.cpp
--- a/Source/app_shared/Log.cpp
+++ b/Source/app_shared/Log.cpp
@@ -60,4 +60,44 @@ Framework::CStdStream& CLog::GetLog(const char* logName)
 	return logIterator->second;
 }
 
+#else
+
+#include <cstdio>
+#include <deque>
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+	std::mutex g_warningMutex;
+	std::unordered_map<const char*, unsigned int> g_warningCounts; //by format string
+	std::deque<std::string> g_recentWarnings;
+	constexpr unsigned int g_maxReportsPerWarning = 20;
+	constexpr size_t g_maxRecentWarnings = 8;
+}
+
+void CLog::Warn(const char* logName, const char* format, ...)
+{
+	std::lock_guard<std::mutex> lock(g_warningMutex);
+	unsigned int& count = g_warningCounts[format];
+	if(count >= g_maxReportsPerWarning) return;
+	count++;
+	char message[256];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+	std::string line = std::string(logName) + ": " + message;
+	while(!line.empty() && ((line.back() == '\n') || (line.back() == '\r'))) line.pop_back();
+	std::printf("warning %s%s\n", line.c_str(), (count == g_maxReportsPerWarning) ? " (further reports suppressed)" : "");
+	g_recentWarnings.push_back(line);
+	if(g_recentWarnings.size() > g_maxRecentWarnings) g_recentWarnings.pop_front();
+}
+
+std::vector<std::string> CLog::GetRecentWarnings()
+{
+	std::lock_guard<std::mutex> lock(g_warningMutex);
+	return std::vector<std::string>(g_recentWarnings.begin(), g_recentWarnings.end());
+}
+
 #endif
