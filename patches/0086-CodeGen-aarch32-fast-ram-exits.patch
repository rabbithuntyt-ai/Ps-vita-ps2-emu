+//The handler call of a wide access: after the function's code with the fast RAM path
+//(only reached from its out of line page lookup), else inline after a branch over it
+void CCodeGen_AArch32::Emit_GuestSlowPath(uint32 info, CAArch32Assembler::LABEL slowLabel, CAArch32Assembler::LABEL doneLabel, std::function<void()> body)
+{
+	if(GUEST_MEMOP_INFO::GetFastRam(info) != GUEST_MEMOP_INFO::FAST_RAM_NONE)
+	{
+		auto stackLevel = m_stackLevel;
+		AddColdCode([this, stackLevel, slowLabel, doneLabel, body]() {
+			m_stackLevel = stackLevel;
+			m_assembler.MarkLabel(slowLabel);
+			body();
+			m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+		});
+	}
+	else
+	{
+		m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+		m_assembler.MarkLabel(slowLabel);
+		body();
+	}
+}
