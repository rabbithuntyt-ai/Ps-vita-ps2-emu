+//The pinned read/write register (the cycle quota) minus a constant: subs, and the next
+//compare of it with 0 uses these flags
+bool CCodeGen_AArch32::Emit_PinnedSubs(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src2 = statement.src2->GetSymbol().get();
+	CAArch32Assembler::REGISTER dstReg, src1Reg;
+	if(!GetPinnedRegister(dst, dstReg) || (dstReg != g_pinnedRwRegister)) return false;
+	if(!GetPinnedRegister(src1, src1Reg) || (src1Reg != dstReg)) return false;
+	if(src2->m_type != SYM_CONSTANT) return false;
+	uint8 immediate = 0, shiftAmount = 0;
+	if(!TryGetAluImmediateParams(src2->m_valueLow, immediate, shiftAmount)) return false;
+	m_assembler.Subs(dstReg, dstReg, CAArch32Assembler::MakeImmediateAluOperand(immediate, shiftAmount));
+	m_flagsNextReg = dstReg;
+	return true;
+}
