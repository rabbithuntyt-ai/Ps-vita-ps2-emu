+void CBasicBlock::CompileWithJitCache(uint32 keyCategory, const uint128& hash, uint32 size, bool cacheable)
+{
+	auto& cache = CJitCache::GetInstance();
+	if(!cacheable || !cache.IsOpen())
+	{
+		Compile();
+		return;
+	}
+	CJitCache::KEY key;
+	key.category = keyCategory;
+	key.begin = m_begin;
+	key.size = size;
+	key.hints = m_blockCompileHints;
+	key.hash = hash;
+	CJitCache::ENTRY entry;
+	if(cache.Find(key, entry))
+	{
+		if(ImportFromJitCache(entry))
+		{
+			cache.CountHit();
+			return;
+		}
+		cache.CountFailure();
+	}
+	Compile();
+	CJitCache::ENTRY compiled;
+	if(ExportToJitCache(compiled))
+	{
+		cache.Store(key, std::move(compiled));
+	}
+	else
+	{
+		cache.CountUncacheable();
+	}
+}
