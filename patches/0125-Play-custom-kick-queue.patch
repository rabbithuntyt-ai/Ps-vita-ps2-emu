+void CVpu::QueueCustomKick(std::shared_ptr<void> custom)
+{
+	if(m_threaded)
+	{
+		{
+			std::lock_guard<std::mutex> lock(m_kickMutex);
+			PENDING_KICK kick;
+			kick.custom = std::move(custom);
+			g_asyncStats.customs.fetch_add(1, std::memory_order_relaxed);
+			m_pendingKicks.push_back(std::move(kick));
+			m_hasPendingKicks = true;
+		}
+		FlushPendingXgKicks();
+	}
+	else
+	{
+		g_customKickSubmit(m_gif, custom);
+	}
+}
