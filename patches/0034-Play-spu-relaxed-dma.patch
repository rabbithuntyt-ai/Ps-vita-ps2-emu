diff --git a/Source/iop/Iop_SubSystem.cpp b/Source/iop/Iop_SubSystem.cpp
--- a/Source/iop/Iop_SubSystem.cpp
+++ b/Source/iop/Iop_SubSystem.cpp
@@ -82,11 +82,25 @@ CSubSystem::CSubSystem(bool ps2Mode)
 
 	m_dmac.SetReceiveFunction(CDmac::CHANNEL_SPU0,
 	                          [this](uint8* buffer, uint32 blockSize, uint32 blockAmount, uint32 direction) {
+		                          //Same rule as register reads: the game picks where to write from
+		                          //the playback position it reads, which lags as much as the mixer
+		                          if(m_spuReadAccess)
+		                          {
+			                          uint32 result = 0;
+			                          m_spuReadAccess([&]() { result = m_spuCore0.ReceiveDma(buffer, blockSize, blockAmount, direction); });
+			                          return result;
+		                          }
 		                          SyncSpu();
 		                          return m_spuCore0.ReceiveDma(buffer, blockSize, blockAmount, direction);
 	                          });
 	m_dmac.SetReceiveFunction(CDmac::CHANNEL_SPU1,
 	                          [this](uint8* buffer, uint32 blockSize, uint32 blockAmount, uint32 direction) {
+		                          if(m_spuReadAccess)
+		                          {
+			                          uint32 result = 0;
+			                          m_spuReadAccess([&]() { result = m_spuCore1.ReceiveDma(buffer, blockSize, blockAmount, direction); });
+			                          return result;
+		                          }
 		                          SyncSpu();
 		                          return m_spuCore1.ReceiveDma(buffer, blockSize, blockAmount, direction);
 	                          });
