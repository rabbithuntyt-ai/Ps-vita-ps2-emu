 void CPS2VM::UpdateSpu()
+{
+	if(m_spuThreaded)
+	{
+		{
+			std::lock_guard<std::mutex> lock(m_spuMutex);
+			m_spuPendingBlocks++;
+		}
+		m_spuWorkCondition.notify_one();
+		return;
+	}
+	RenderSpuBlock();
+}
+
+void CPS2VM::SetSpuThreaded(bool threaded, const std::function<void()>& workerInit)
+{
+	if(threaded == m_spuThreaded) return;
+	if(m_spuThreaded)
+	{
+		SyncSpu();
+		{
+			std::lock_guard<std::mutex> lock(m_spuMutex);
+			m_spuStopWorker = true;
+		}
+		m_spuWorkCondition.notify_all();
+		m_spuWorker.join();
+		m_spuThreaded = false;
+		m_iop->m_spuSync = nullptr;
+		return;
+	}
+	m_spuStopWorker = false;
+	m_spuPendingBlocks = 0;
+	m_spuRendering = false;
+	m_spuThreaded = true;
+	m_iop->m_spuSync = [this]() { SyncSpu(); };
+	m_spuWorker = std::thread(
+	    [this, workerInit]() {
+		    if(workerInit) workerInit();
+		    SpuWorkerProc();
+	    });
+}
+
+void CPS2VM::SpuWorkerProc()
+{
+	std::unique_lock<std::mutex> lock(m_spuMutex);
+	while(true)
+	{
+		m_spuWorkCondition.wait(lock, [this]() { return (m_spuPendingBlocks != 0) || m_spuStopWorker; });
+		if(m_spuPendingBlocks == 0) break; //stop requested and nothing left
+		m_spuPendingBlocks--;
+		m_spuRendering = true;
+		lock.unlock();
+		RenderSpuBlock();
+		lock.lock();
+		m_spuRendering = false;
+		if(m_spuPendingBlocks == 0) m_spuIdleCondition.notify_all();
+	}
+}
+
+void CPS2VM::SyncSpu()
+{
+	if(!m_spuThreaded) return;
+	std::unique_lock<std::mutex> lock(m_spuMutex);
+	m_spuIdleCondition.wait(lock, [this]() { return (m_spuPendingBlocks == 0) && !m_spuRendering; });
+}
