+		//After reading 'bytes' at GetDirectReadPointer: a partly read qword goes back into the
+		//buffer, as the per value reads would have left it
+		inline void ConsumeDirect(uint32 bytes)
+		{
+			uint32 next = m_nextAddress + bytes;
