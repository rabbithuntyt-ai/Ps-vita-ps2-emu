+	//Diagnostics (g_ioCounts): accesses and time per I/O register slot
+	struct IO_TIMER
+	{
+		uint64* ns = nullptr;
+		std::chrono::steady_clock::time_point start;
+		void Start(int write, uint32 address)
+		{
+			uint32 slot = ((address & 0xFFFF0000) == 0x10000000) ? ((address & 0xFFFF) >> 4) : ((address & 0xFF000000) == 0x12000000) ? 4096 : 4097;
+			Ee::CSubSystem::g_ioCount[write][slot]++;
+			ns = &Ee::CSubSystem::g_ioNs[write][slot];
+			start = std::chrono::steady_clock::now();
+		}
+		~IO_TIMER()
+		{
+			if(ns) *ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+		}
+	};
+}
