+void CJitter::PromoteLoopMdRegisters()
+{
+	static const unsigned int maxPromotedSetting = []() {
+		const char* value = getenv("JITTER_MD_PROMOTE");
+		return value ? static_cast<unsigned int>(atoi(value)) : 4U;
+	}();
+	static const bool debug = (getenv("JITTER_MD_PROMOTE_DEBUG") != nullptr);
+	if(maxPromotedSetting == 0) return;
+
+	//The extra registers are set before allocation: set them now as Compile will
+	unsigned int mdCount = m_codeGen->GetAvailableMdRegisterCount();
+	const unsigned int keepForTemporaries = 4;
+	if(mdCount <= keepForTemporaries) return;
+	unsigned int maxPromoted = std::min<unsigned int>(mdCount - keepForTemporaries, maxPromotedSetting);
+
+	for(auto tailIterator = m_basicBlocks.begin(); tailIterator != m_basicBlocks.end(); ++tailIterator)
+	{
+		auto& tail = *tailIterator;
+		if(tail.statements.empty()) continue;
+		const auto& backJump = tail.statements.back();
+		if(backJump.op != OP_JMP) continue;
+		uint32 headerId = backJump.jmpBlock;
+
+		auto headerIterator = m_basicBlocks.begin();
+		for(; headerIterator != tailIterator; ++headerIterator)
+		{
+			if(headerIterator->id == headerId) break;
+		}
+		if((headerIterator == tailIterator) && (tail.id != headerId)) continue;
+		if(headerIterator == m_basicBlocks.begin()) continue;
+
+		auto chainEnd = std::next(tailIterator);
+		std::map<uint32, unsigned int> chainIndex;
+		{
+			unsigned int index = 0;
+			for(auto it = headerIterator; it != chainEnd; ++it) chainIndex[it->id] = index++;
+		}
+
+		//Entries: from outside only to the header (redirected to the preheader). Inside: jumps
+		//forward within the chain, the back jump, or out of it (side exits through stubs).
+		const char* reason = nullptr;
+		for(auto it = m_basicBlocks.begin(); it != m_basicBlocks.end(); ++it)
+		{
+			bool inChain = chainIndex.count(it->id) != 0;
+			for(const auto& statement : it->statements)
+			{
+				if((statement.op != OP_JMP) && (statement.op != OP_CONDJMP)) continue;
+				bool targetInChain = chainIndex.count(statement.jmpBlock) != 0;
+				if(!inChain)
+				{
+					if(targetInChain && (statement.jmpBlock != headerId)) reason = "entry into the loop body";
+					continue;
+				}
+				if(&statement == &backJump) continue;
+				if(targetInChain && (chainIndex[statement.jmpBlock] <= chainIndex[it->id])) reason = "backward jump inside";
+			}
+		}
+
+		//No calls, guest memory ops or external jumps inside
+		std::map<uint32, unsigned int> useCounts;
+		std::vector<CSymbol*> otherSymbols;
+		for(auto it = headerIterator; !reason && (it != chainEnd); ++it)
+		{
+			for(const auto& statement : it->statements)
+			{
+				switch(statement.op)
+				{
+				case OP_CALL:
+				case OP_PARAM:
+				case OP_PARAM_RET:
+				case OP_RETVAL:
+				case OP_EXTERNJMP:
+				case OP_EXTERNJMP_DYN:
+				case OP_GOTO:
+				case OP_LABEL:
+				case OP_GUESTLOAD:
+				case OP_GUESTSTORE:
+					reason = "call, external jump or guest memory op inside";
+					break;
+				default:
+					break;
+				}
+				statement.VisitOperands([&](const SymbolRefPtr& symbolRef, bool) {
+					auto symbol = symbolRef->GetSymbol().get();
+					if(symbol->m_type == SYM_RELATIVE128)
+						useCounts[symbol->m_valueLow]++;
+					else if(symbol->IsRelative() || (symbol->m_type == SYM_REL_REFERENCE))
+						otherSymbols.push_back(symbol);
+				});
+			}
+		}
+		if(reason)
+		{
+			if(debug) fprintf(stderr, "md loop promotion: loop at block %u rejected: %s\n", headerId, reason);
+			continue;
+		}
+
+		//Candidates not overlapped by other accesses (lanes, references, other sizes)
+		std::vector<std::pair<unsigned int, uint32>> candidates;
+		for(const auto& useCount : useCounts)
+		{
+			CSymbol candidate(SYM_RELATIVE128, useCount.first, 0);
+			bool aliased = false;
+			for(auto* other : otherSymbols)
+			{
+				if(candidate.Aliases(other)) aliased = true;
+			}
+			if(!aliased && (useCount.second >= 3)) candidates.push_back(std::make_pair(useCount.second, useCount.first));
+		}
+		if(candidates.empty()) continue;
+		std::sort(candidates.begin(), candidates.end(), [](const auto& a, const auto& b) {
+			return (a.first != b.first) ? (a.first > b.first) : (a.second < b.second);
+		});
+		if(candidates.size() > maxPromoted) candidates.resize(maxPromoted);
+
+		//Highest register ids, so the block allocator keeps the low ones
+		std::map<uint32, unsigned int> promoted; //offset -> register id
+		uint32 reservedMask = 0;
+		for(unsigned int i = 0; i < candidates.size(); i++)
+		{
+			unsigned int registerId = mdCount - 1 - i;
+			promoted[candidates[i].second] = registerId;
+			reservedMask |= (1 << registerId);
+		}
+		if(debug)
+		{
+			fprintf(stderr, "md loop promotion: loop at block %u, %zu blocks:", headerId, chainIndex.size());
+			for(const auto& p : promoted) fprintf(stderr, " %x->%u", p.first, p.second);
+			fprintf(stderr, "\n");
+		}
+
+		//Rewrite the chain; remember what it writes
+		std::set<uint32> defined;
+		for(auto it = headerIterator; it != chainEnd; ++it)
+		{
+			auto& block = *it;
+			block.reservedMdRegisters |= reservedMask;
+			for(auto& statement : block.statements)
+			{
+				if(statement.dst)
+				{
+					auto dstSymbol = statement.dst->GetSymbol();
+					if((dstSymbol->m_type == SYM_RELATIVE128) && promoted.count(dstSymbol->m_valueLow)) defined.insert(dstSymbol->m_valueLow);
+				}
+				statement.VisitOperands([&](SymbolRefPtr& symbolRef, bool) {
+					auto symbol = symbolRef->GetSymbol();
+					if(symbol->m_type != SYM_RELATIVE128) return;
+					auto promotedIterator = promoted.find(symbol->m_valueLow);
+					if(promotedIterator == promoted.end()) return;
+					symbolRef = MakeSymbolRef(MakeSymbol(&block, SYM_REGISTER128, promotedIterator->second, 0));
+				});
+			}
+		}
+
+		//Preheader: load everything once; outside jumps to the header go to it
+		uint32 preheaderId = m_nextBlockId++;
+		{
+			BASIC_BLOCK preheader;
+			preheader.id = preheaderId;
+			preheader.optimized = true;
+			preheader.hasJumpRef = true;
+			preheader.reservedMdRegisters = reservedMask;
+			for(const auto& promotedPair : promoted)
+			{
+				STATEMENT statement;
+				statement.op = OP_MOV;
+				statement.dst = MakeSymbolRef(MakeSymbol(&preheader, SYM_REGISTER128, promotedPair.second, 0));
+				statement.src1 = MakeSymbolRef(MakeSymbol(&preheader, SYM_RELATIVE128, promotedPair.first, 0));
+				preheader.statements.push_back(statement);
+			}
+			m_basicBlocks.insert(headerIterator, std::move(preheader));
+		}
+		for(auto& block : m_basicBlocks)
+		{
+			if(chainIndex.count(block.id) != 0) continue;
+			for(auto& statement : block.statements)
+			{
+				if(((statement.op == OP_JMP) || (statement.op == OP_CONDJMP)) && (statement.jmpBlock == headerId)) statement.jmpBlock = preheaderId;
+			}
+		}
+
+		//Exits: jumps out of the chain go through stubs that store what the loop wrote. The
+		//stubs follow the tail, which ends with the back jump (no fall through).
+		auto stubPosition = chainEnd;
+		for(auto it = headerIterator; it != chainEnd; ++it)
+		{
+			for(auto& statement : it->statements)
+			{
+				if((statement.op != OP_CONDJMP) && (statement.op != OP_JMP)) continue;
+				if(&statement == &backJump) continue;
+				if(chainIndex.count(statement.jmpBlock) != 0) continue;
+				BASIC_BLOCK stub;
+				stub.id = m_nextBlockId++;
+				stub.optimized = true;
+				stub.hasJumpRef = true;
+				stub.reservedMdRegisters = reservedMask;
+				for(auto offset : defined)
+				{
+					STATEMENT store;
+					store.op = OP_MOV;
+					store.dst = MakeSymbolRef(MakeSymbol(&stub, SYM_RELATIVE128, offset, 0));
+					store.src1 = MakeSymbolRef(MakeSymbol(&stub, SYM_REGISTER128, promoted[offset], 0));
+					stub.statements.push_back(store);
+				}
+				STATEMENT jump;
+				jump.op = OP_JMP;
