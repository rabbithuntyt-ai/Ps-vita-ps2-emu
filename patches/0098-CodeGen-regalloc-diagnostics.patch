+void CAArch32Assembler::Vsri_32(QUAD_REGISTER qd, QUAD_REGISTER qm, uint8 shiftAmount)
+{
+	//VSHR.U32's encoding with bits 11-8 = 0100
+	uint32 opcode = 0xF3800450;
+	opcode |= (0x40 - (shiftAmount & 0x1F)) << 16;
+	opcode |= FPSIMD_EncodeQd(qd);
+	opcode |= FPSIMD_EncodeQm(qm);
+	WriteWord(opcode);
+}
