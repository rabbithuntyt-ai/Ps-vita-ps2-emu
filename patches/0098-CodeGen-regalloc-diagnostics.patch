+			    if(symbol->m_type != SYM_RELATIVE128) return;
+			    auto& entry = symbols[symbol->m_valueLow];
+			    entry.symbol = symbol;
+			    if(entry.accesses.empty() || (entry.accesses.back().index != index))
+			    {
