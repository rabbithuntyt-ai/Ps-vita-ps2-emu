+
+bool CPS2VM::QueueSpuWrite(uint32 address, uint32 value, bool spu2)
+{
+	//Register writes are applied by the worker in order with the audio
+	//blocks, exactly where they would have happened inline; reads still sync.
+	{
+		std::lock_guard<std::mutex> lock(m_spuMutex);
+		if(m_spuWork.size() >= 8192) return false; //backpressure: caller syncs
+		m_spuWork.push_back(SPU_WORK{address, value, static_cast<uint8>(spu2 ? SPU_WORK_WRITE_SPU2 : SPU_WORK_WRITE_SPU1)});
+	}
+	m_spuWorkCondition.notify_one();
+	return true;
 }
 
