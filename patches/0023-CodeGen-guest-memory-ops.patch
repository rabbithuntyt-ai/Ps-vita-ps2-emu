+bool CJitter::SupportsGuestMemoryOps() const
+{
+	return m_codeGen->SupportsGuestMemoryOps();
+}
+
+void CJitter::GuestLoad(uint32 pageTableOffset, uint32 size, bool signExtend, void* handler)
+{
+	assert(SupportsGuestMemoryOps());
+
+	auto tempType = (size == 16) ? SYM_TEMPORARY128 : ((size == 8) ? SYM_TEMPORARY64 : SYM_TEMPORARY);
+	auto tempSym = MakeSymbol(tempType, m_nextTemporary++);
+
+	STATEMENT statement;
+	statement.op = OP_GUESTLOAD;
+	statement.memInfo = GUEST_MEMOP_INFO::Make(pageTableOffset, size, signExtend);
+	statement.src3 = MakeSymbolRef(MakeConstantPtr(reinterpret_cast<uintptr_t>(handler)));
+	statement.src1 = MakeSymbolRef(m_shadow.Pull());
+	statement.dst = MakeSymbolRef(tempSym);
+	InsertStatement(statement);
+
+	m_shadow.Push(tempSym);
+}
+
+void CJitter::GuestStore(uint32 pageTableOffset, uint32 size, void* handler)
+{
+	assert(SupportsGuestMemoryOps());
+
+	STATEMENT statement;
+	statement.op = OP_GUESTSTORE;
+	statement.memInfo = GUEST_MEMOP_INFO::Make(pageTableOffset, size, false);
+	statement.src3 = MakeSymbolRef(MakeConstantPtr(reinterpret_cast<uintptr_t>(handler)));
+	statement.src2 = MakeSymbolRef(m_shadow.Pull());
+	statement.src1 = MakeSymbolRef(m_shadow.Pull());
+	InsertStatement(statement);
+}
+
+void CJitter::AddGuestMemorySafeRange(uint32 begin, uint32 end)
+{
+	m_guestMemorySafeRanges.emplace_back(begin, end);
+}
+
+bool CJitter::IsGuestMemorySafeSymbol(const CSymbol* symbol) const
+{
+	if(symbol->IsTemporary()) return true;
+	switch(symbol->m_type)
+	{
+	case SYM_RELATIVE:
+	case SYM_FP_RELATIVE32:
+	case SYM_RELATIVE64:
+	case SYM_RELATIVE128:
+		break;
+	default:
+		return false;
+	}
+	uint32 begin = symbol->m_valueLow;
+	uint32 end = begin + symbol->GetSize();
+	for(const auto& range : m_guestMemorySafeRanges)
+	{
+		if((begin >= range.first) && (end <= range.second)) return true;
+	}
+	return false;
+}
