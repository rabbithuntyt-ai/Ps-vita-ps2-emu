+void CAArch32Assembler::Ldrsb(REGISTER rd, REGISTER rbase, REGISTER rm)
+{
+	//LDRSB rd, [rbase, rm]
+	uint32 opcode = (CONDITION_AL << 28) | 0x019000D0;
+	opcode |= static_cast<uint32>(rbase) << 16;
+	opcode |= static_cast<uint32>(rd) << 12;
+	opcode |= static_cast<uint32>(rm);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Ldrsh(REGISTER rd, REGISTER rbase, REGISTER rm)
+{
+	//LDRSH rd, [rbase, rm]
+	uint32 opcode = (CONDITION_AL << 28) | 0x019000F0;
+	opcode |= static_cast<uint32>(rbase) << 16;
+	opcode |= static_cast<uint32>(rd) << 12;
+	opcode |= static_cast<uint32>(rm);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Ubfx(REGISTER rd, REGISTER rn, uint8 lsb, uint8 width)
+{
+	assert((lsb < 32) && (width >= 1) && ((lsb + width) <= 32));
+	uint32 opcode = (CONDITION_AL << 28) | 0x07E00050;
+	opcode |= static_cast<uint32>(width - 1) << 16;
+	opcode |= static_cast<uint32>(rd) << 12;
+	opcode |= static_cast<uint32>(lsb) << 7;
+	opcode |= static_cast<uint32>(rn);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Sxtb(REGISTER rd, REGISTER rm)
+{
+	uint32 opcode = (CONDITION_AL << 28) | 0x06AF0070;
+	opcode |= static_cast<uint32>(rd) << 12;
+	opcode |= static_cast<uint32>(rm);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Sxth(REGISTER rd, REGISTER rm)
+{
+	uint32 opcode = (CONDITION_AL << 28) | 0x06BF0070;
+	opcode |= static_cast<uint32>(rd) << 12;
+	opcode |= static_cast<uint32>(rm);
+	WriteWord(opcode);
+}
