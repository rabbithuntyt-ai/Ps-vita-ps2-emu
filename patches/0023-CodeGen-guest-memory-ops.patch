+void CCodeGen_AArch32::Emit_GuestLoad(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+	uint32 info = statement.memInfo;
+	uint32 size = GUEST_MEMOP_INFO::GetSize(info);
+	bool signExtend = GUEST_MEMOP_INFO::IsSignExtend(info);
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	auto dstReg = PrepareSymbolRegisterDef(dst, CAArch32Assembler::r0);
+	auto pageReg = CAArch32Assembler::r2;
+	auto offsetReg = CAArch32Assembler::r3;
+
+	Emit_GuestMemoryPageLookup(GUEST_MEMOP_INFO::GetPageTableOffset(info), addressReg, pageReg, offsetReg);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_EQ, slowLabel);
+
+	switch(size)
+	{
+	case 4:
+		m_assembler.Ubfx(offsetReg, addressReg, 2, 10);
+		m_assembler.Ldr(dstReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg, CAArch32Assembler::SHIFT_LSL, 2));
+		break;
+	case 2:
+		m_assembler.Ubfx(offsetReg, addressReg, 0, 12);
+		m_assembler.Bic(offsetReg, offsetReg, CAArch32Assembler::MakeImmediateAluOperand(1, 0));
+		if(signExtend)
+			m_assembler.Ldrsh(dstReg, pageReg, offsetReg);
+		else
+			m_assembler.Ldrh(dstReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg));
+		break;
+	case 1:
+		m_assembler.Ubfx(offsetReg, addressReg, 0, 12);
+		if(signExtend)
+			m_assembler.Ldrsb(dstReg, pageReg, offsetReg);
+		else
+			m_assembler.Ldrb(dstReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg));
+		break;
+	default:
+		assert(false);
+		break;
+	}
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	m_assembler.MarkLabel(slowLabel);
+	if(addressReg != CAArch32Assembler::r1)
+	{
+		m_assembler.Mov(CAArch32Assembler::r1, addressReg);
+	}
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+	if(signExtend && (size == 1))
+	{
+		m_assembler.Sxtb(dstReg, CAArch32Assembler::r0);
+	}
+	else if(signExtend && (size == 2))
+	{
+		m_assembler.Sxth(dstReg, CAArch32Assembler::r0);
+	}
+	else if(dstReg != CAArch32Assembler::r0)
+	{
+		m_assembler.Mov(dstReg, CAArch32Assembler::r0);
+	}
+
+	m_assembler.MarkLabel(doneLabel);
+	CommitSymbolRegister(dst, dstReg);
+}
+
+void CCodeGen_AArch32::Emit_GuestStore(const STATEMENT& statement)
+{
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src2 = statement.src2->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+	uint32 info = statement.memInfo;
+	uint32 size = GUEST_MEMOP_INFO::GetSize(info);
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	auto valueReg = PrepareSymbolRegisterUse(src2, CAArch32Assembler::r2);
+	auto pageReg = CAArch32Assembler::r0;
+	auto offsetReg = CAArch32Assembler::r3;
+
+	Emit_GuestMemoryPageLookup(GUEST_MEMOP_INFO::GetPageTableOffset(info), addressReg, pageReg, offsetReg);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_EQ, slowLabel);
+
+	switch(size)
+	{
+	case 4:
+		m_assembler.Ubfx(offsetReg, addressReg, 2, 10);
+		m_assembler.Str(valueReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg, CAArch32Assembler::SHIFT_LSL, 2));
+		break;
+	case 2:
+		m_assembler.Ubfx(offsetReg, addressReg, 0, 12);
+		m_assembler.Bic(offsetReg, offsetReg, CAArch32Assembler::MakeImmediateAluOperand(1, 0));
+		m_assembler.Strh(valueReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg));
+		break;
+	case 1:
+		m_assembler.Ubfx(offsetReg, addressReg, 0, 12);
+		m_assembler.Strb(valueReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(offsetReg));
+		break;
+	default:
+		assert(false);
+		break;
+	}
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	//Handler parameters: context, value, address
+	//(address is in r1 or an allocated register, value in r2 or an allocated register)
+	m_assembler.MarkLabel(slowLabel);
+	m_assembler.Mov(CAArch32Assembler::r3, addressReg);
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	m_assembler.Mov(CAArch32Assembler::r1, valueReg);
+	m_assembler.Mov(CAArch32Assembler::r2, CAArch32Assembler::r3);
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+
+	m_assembler.MarkLabel(doneLabel);
+}
+
+void CCodeGen_AArch32::LoadStackOrContextAddress(CAArch32Assembler::REGISTER dstReg, CAArch32Assembler::REGISTER baseReg, uint32 offset)
+{
+	uint8 immediate = 0, shiftAmount = 0;
+	if(TryGetAluImmediateParams(offset, immediate, shiftAmount))
+	{
+		m_assembler.Add(dstReg, baseReg, CAArch32Assembler::MakeImmediateAluOperand(immediate, shiftAmount));
+	}
+	else
+	{
+		LoadConstantInRegister(dstReg, offset);
+		m_assembler.Add(dstReg, baseReg, dstReg);
+	}
+}
+
+void CCodeGen_AArch32::LoadMemorySymbolAddress(CAArch32Assembler::REGISTER dstReg, CSymbol* symbol)
+{
+	switch(symbol->m_type)
+	{
+	case SYM_RELATIVE64:
+	case SYM_RELATIVE128:
+		LoadStackOrContextAddress(dstReg, g_baseRegister, symbol->m_valueLow);
+		break;
+	case SYM_TEMPORARY64:
+	case SYM_TEMPORARY128:
+		LoadStackOrContextAddress(dstReg, CAArch32Assembler::rSP, symbol->m_stackLocation + m_stackLevel);
+		break;
+	default:
+		assert(false);
+		break;
+	}
+}
+
+//Host address of an 8 or 16 bytes access (address aligned down) in r3. Branches to slowLabel
+//if the page isn't mapped. Uses r2 and r3.
+void CCodeGen_AArch32::Emit_GuestMemoryWideAddress(uint32 info, uint32 size, CAArch32Assembler::REGISTER addressReg, CAArch32Assembler::LABEL slowLabel)
+{
+	auto pageReg = CAArch32Assembler::r2;
+	auto hostAddressReg = CAArch32Assembler::r3;
+	uint8 sizeShift = (size == 16) ? 4 : 3;
+	Emit_GuestMemoryPageLookup(GUEST_MEMOP_INFO::GetPageTableOffset(info), addressReg, pageReg, hostAddressReg);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_EQ, slowLabel);
+	m_assembler.Ubfx(hostAddressReg, addressReg, sizeShift, 12 - sizeShift);
+	m_assembler.Add(hostAddressReg, pageReg, CAArch32Assembler::MakeRegisterAluOperand(hostAddressReg, CAArch32Assembler::MakeConstantShift(CAArch32Assembler::SHIFT_LSL, sizeShift)));
+}
+
+void CCodeGen_AArch32::Emit_GuestLoad64(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	Emit_GuestMemoryWideAddress(statement.memInfo, 8, addressReg, slowLabel);
+	m_assembler.Ldrd(CAArch32Assembler::r0, CAArch32Assembler::r3, CAArch32Assembler::MakeImmediateLdrAddress(0));
+	StoreRegistersInMemory64(dst, CAArch32Assembler::r0, CAArch32Assembler::r1);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	//Handler parameters: context, address, value pointer
+	m_assembler.MarkLabel(slowLabel);
+	if(addressReg != CAArch32Assembler::r1)
+	{
+		m_assembler.Mov(CAArch32Assembler::r1, addressReg);
+	}
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	LoadMemorySymbolAddress(CAArch32Assembler::r2, dst);
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+
+	m_assembler.MarkLabel(doneLabel);
+}
+
+void CCodeGen_AArch32::Emit_GuestStore64(const STATEMENT& statement)
+{
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src2 = statement.src2->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	Emit_GuestMemoryWideAddress(statement.memInfo, 8, addressReg, slowLabel);
+	LoadSymbol64InRegisters(CAArch32Assembler::r0, CAArch32Assembler::r1, src2);
+	m_assembler.Strd(CAArch32Assembler::r0, CAArch32Assembler::r3, CAArch32Assembler::MakeImmediateLdrAddress(0));
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	//Handler parameters: context, address, value pointer
+	m_assembler.MarkLabel(slowLabel);
+	if(src2->m_type == SYM_CONSTANT64)
+	{
+		LoadStackOrContextAddress(CAArch32Assembler::r2, CAArch32Assembler::rSP, m_param128SpillBase + m_stackLevel);
+		LoadConstantInRegister(CAArch32Assembler::r0, src2->m_valueLow);
+		m_assembler.Str(CAArch32Assembler::r0, CAArch32Assembler::r2, CAArch32Assembler::MakeImmediateLdrAddress(0));
+		LoadConstantInRegister(CAArch32Assembler::r0, src2->m_valueHigh);
+		m_assembler.Str(CAArch32Assembler::r0, CAArch32Assembler::r2, CAArch32Assembler::MakeImmediateLdrAddress(4));
+	}
+	else
+	{
+		LoadMemorySymbolAddress(CAArch32Assembler::r2, src2);
+	}
+	if(addressReg != CAArch32Assembler::r1)
+	{
+		m_assembler.Mov(CAArch32Assembler::r1, addressReg);
+	}
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+
+	m_assembler.MarkLabel(doneLabel);
+}
+
+void CCodeGen_AArch32::Emit_GuestLoad128(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	Emit_GuestMemoryWideAddress(statement.memInfo, 16, addressReg, slowLabel);
+	auto dstReg = PrepareSymbolRegisterDefMd(dst, CAArch32Assembler::q0);
+	m_assembler.Vld1_32x4(dstReg, CAArch32Assembler::r3);
+	CommitSymbolRegisterMd(dst, dstReg);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	//Handler parameters: context, address, value pointer
+	m_assembler.MarkLabel(slowLabel);
+	if(addressReg != CAArch32Assembler::r1)
+	{
+		m_assembler.Mov(CAArch32Assembler::r1, addressReg);
+	}
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	bool inRegister = (dst->m_type == SYM_REGISTER128);
+	if(inRegister)
+	{
+		//Result goes through the spill slot (MD registers are restored after the call)
+		LoadStackOrContextAddress(CAArch32Assembler::r2, CAArch32Assembler::rSP, m_param128SpillBase + m_stackLevel);
+	}
+	else
+	{
+		LoadMemorySymbolAddress(CAArch32Assembler::r2, dst);
+	}
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+	if(inRegister)
+	{
+		LoadStackOrContextAddress(CAArch32Assembler::r3, CAArch32Assembler::rSP, m_param128SpillBase + m_stackLevel);
+		m_assembler.Vld1_32x4(g_registersMd[dst->m_valueLow], CAArch32Assembler::r3);
+	}
+
+	m_assembler.MarkLabel(doneLabel);
+}
+
+void CCodeGen_AArch32::Emit_GuestStore128(const STATEMENT& statement)
+{
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src2 = statement.src2->GetSymbol().get();
+	auto src3 = statement.src3->GetSymbol().get();
+
+	auto slowLabel = m_assembler.CreateLabel();
+	auto doneLabel = m_assembler.CreateLabel();
+
+	auto addressReg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	Emit_GuestMemoryWideAddress(statement.memInfo, 16, addressReg, slowLabel);
+	auto valueReg = PrepareSymbolRegisterUseMd(src2, CAArch32Assembler::q0);
+	m_assembler.Vst1_32x4(valueReg, CAArch32Assembler::r3);
+	m_assembler.BCc(CAArch32Assembler::CONDITION_AL, doneLabel);
+
+	//Handler parameters: context, address, value pointer
+	m_assembler.MarkLabel(slowLabel);
+	if(src2->m_type == SYM_REGISTER128)
+	{
+		LoadStackOrContextAddress(CAArch32Assembler::r2, CAArch32Assembler::rSP, m_param128SpillBase + m_stackLevel);
+		m_assembler.Vst1_32x4(g_registersMd[src2->m_valueLow], CAArch32Assembler::r2);
+	}
+	else
+	{
+		LoadMemorySymbolAddress(CAArch32Assembler::r2, src2);
+	}
+	if(addressReg != CAArch32Assembler::r1)
+	{
+		m_assembler.Mov(CAArch32Assembler::r1, addressReg);
+	}
+	m_assembler.Mov(CAArch32Assembler::r0, g_baseRegister);
+	Emit_GuestMemoryHandlerCall(src3->GetConstantPtr());
+
+	m_assembler.MarkLabel(doneLabel);
+}
+
 void CCodeGen_AArch32::Emit_RetVal_Reg(const STATEMENT& statement)
 {
 	auto dst = statement.dst->GetSymbol().get();
