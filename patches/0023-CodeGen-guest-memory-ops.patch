+//Loads the page pointer for the address in addressReg into pageReg (sets flags, Z if unmapped).
+void CCodeGen_AArch32::Emit_GuestMemoryPageLookup(uint32 pageTableOffset, CAArch32Assembler::REGISTER addressReg,
+                                                  CAArch32Assembler::REGISTER pageReg, CAArch32Assembler::REGISTER tmpReg)
+{
+	if(pageTableOffset < 0x1000)
+	{
+		m_assembler.Ldr(pageReg, g_baseRegister, CAArch32Assembler::MakeImmediateLdrAddress(pageTableOffset));
+	}
+	else
+	{
+		LoadConstantInRegister(pageReg, pageTableOffset);
+		m_assembler.Ldr(pageReg, g_baseRegister, CAArch32Assembler::MakeRegisterLdrAddress(pageReg));
+	}
+	m_assembler.Mov(tmpReg, CAArch32Assembler::MakeRegisterAluOperand(addressReg, CAArch32Assembler::MakeConstantShift(CAArch32Assembler::SHIFT_LSR, 12)));
+	m_assembler.Ldr(pageReg, pageReg, CAArch32Assembler::MakeRegisterLdrAddress(tmpReg, CAArch32Assembler::SHIFT_LSL, 2));
+	m_assembler.Cmp(pageReg, CAArch32Assembler::MakeImmediateAluOperand(0, 0));
+}
+
+//Calls a handler with parameters already in r0-r2. Allocated GPRs and FP32 registers
+//are callee saved, allocated MD registers are not.
+void CCodeGen_AArch32::Emit_GuestMemoryHandlerCall(uintptr_t handler)
+{
+	bool saveMd = (m_mdRegisterFirst != -1);
+	auto firstMd = static_cast<CAArch32Assembler::DOUBLE_REGISTER>(CAArch32Assembler::d16 + (m_mdRegisterFirst * 2));
+	uint8 mdCount = saveMd ? static_cast<uint8>((m_mdRegisterLast - m_mdRegisterFirst + 1) * 2) : 0;
+	if(saveMd)
+	{
+		m_assembler.Vpush(firstMd, mdCount);
+	}
+	LoadConstantPtrInRegister(CAArch32Assembler::r12, handler);
+	m_assembler.Blx(CAArch32Assembler::r12);
+	if(saveMd)
+	{
+		m_assembler.Vpop(firstMd, mdCount);
+	}
+}
