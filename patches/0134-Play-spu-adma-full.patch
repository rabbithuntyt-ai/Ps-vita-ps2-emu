+uint32 CSubSystem::ReceiveSpuDma(CSpuBase& core, uint8* buffer, uint32 blockSize, uint32 blockAmount, uint32 direction)
+{
+	if(m_spuReadAccess)
+	{
+		//A sound driver streaming PCM through a core's input (ADMA) keeps starting the transfer
+		//while the input buffer is full (RE4: 93% of its core 1 DMAs move nothing). With no write
+		//queued, the mode is the one set, and "full" ends only when the mixer has read the buffer:
+		//answering 0 blocks without pausing the mixer is the paused answer a little earlier, which
+		//the read path's lag already allows
+		uint32 key = (&core == &m_spuCore0) ? 0xD000 : 0xD100;
+		if(g_fastSpuAdmaFull && m_spuWritesPending && !m_spuWritesPending() && core.IsBlockInputFull())
+		{
+			if(g_spuSlowCounts) (*g_spuSlowCounts)[key + 0x800]++;
+			return 0;
+		}
+		//Same rule as register reads: the game picks where to write from the playback position
+		//it reads, which lags as much as the mixer
+		uint32 result = 0;
+		m_spuReadAccess([&]() { result = core.ReceiveDma(buffer, blockSize, blockAmount, direction); });
+		if(g_spuSlowCounts)
+		{
+			(*g_spuSlowCounts)[key + core.GetTransferMode() * 0x10 + direction]++;
+			(*g_spuSlowCounts)[key + 0x400 + ((result == 0) ? 0 : ((result < blockAmount) ? 1 : 2))]++;
+		}
+		return result;
+	}
+	SyncSpu();
+	return core.ReceiveDma(buffer, blockSize, blockAmount, direction);
+}
