diff --git a/Source/EmuProfile.h b/Source/EmuProfile.h
new file mode 100644
--- /dev/null
+++ b/Source/EmuProfile.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <atomic>
+#include "Types.h"
+
+//Cheap statistical profiling of the emulation thread: code marks which
+//subsystem it is running (one relaxed store), a sampler thread reads it.
+namespace EmuProfile
+{
+	enum SECTION : uint8
+	{
+		SECTION_OTHER,
+		SECTION_EE,
+		SECTION_VU0,
+		SECTION_VU1,
+		SECTION_IOP,
+		SECTION_SPU,
+		SECTION_VIF,
+		SECTION_GIF,
+		SECTION_IPU,
+		SECTION_SIF,
+		SECTION_JIT,
+		SECTION_GS_WAIT,
+		SECTION_LIMITER,
+		SECTION_COUNT
+	};
+
+	inline const char* GetSectionName(unsigned int section)
+	{
+		static const char* names[SECTION_COUNT] = {"other", "EE", "VU0", "VU1", "IOP", "SPU", "VIF", "GIF", "IPU", "SIF", "JIT", "GSwait", "idle"};
+		return (section < SECTION_COUNT) ? names[section] : "?";
+	}
+
+	inline std::atomic<uint8> g_section{SECTION_OTHER};
+
+	class CScope
+	{
+	public:
+		explicit CScope(SECTION section)
+		    : m_previous(g_section.load(std::memory_order_relaxed))
+		{
+			g_section.store(section, std::memory_order_relaxed);
+		}
+		~CScope()
+		{
+			g_section.store(m_previous, std::memory_order_relaxed);
+		}
+		CScope(const CScope&) = delete;
+		CScope& operator=(const CScope&) = delete;
+
+	private:
+		uint8 m_previous;
+	};
+}
