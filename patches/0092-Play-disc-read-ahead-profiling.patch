+	//The read-ahead block: requested at m_aheadStart, filled by the thread
+	void RequestAhead(int64 start)
+	{
+		if(!m_aheadThread.joinable() || (start >= m_size)) return;
+		{
+			std::lock_guard<std::mutex> lock(m_aheadMutex);
+			if(m_aheadBusy) return; //still reading an older one
+			m_aheadStart = start;
+			m_aheadReady = false;
+			m_aheadRequested = true;
+		}
+		m_aheadWake.notify_one();
+	}
+
+	//The block at start from the read-ahead (waits if it is being read)
+	bool TakeAhead(int64 start, int& result)
+	{
+		if(!m_aheadThread.joinable()) return false;
+		std::unique_lock<std::mutex> lock(m_aheadMutex);
+		if(m_aheadStart != start) return false;
+		//Polled: condition variables lose wakeups on the Vita (a lost one here stopped the
+		//emulation thread for good: RE4 hung while loading)
+		while(!(m_aheadReady || (!m_aheadRequested && !m_aheadBusy)))
+		{
+			lock.unlock();
+			sceKernelDelayThread(100);
+			lock.lock();
+		}
+		if(!m_aheadReady) return false;
+		m_aheadReady = false;
+		m_aheadStart = -1;
+		std::swap(m_buffer, m_ahead);
+		result = m_aheadValid;
+		return true;
+	}
+
+	void AheadThread()
+	{
+		sceKernelChangeThreadCpuAffinityMask(sceKernelGetThreadId(), 0x20000 /* SCE_KERNEL_CPU_MASK_USER_1 */);
+		std::unique_lock<std::mutex> lock(m_aheadMutex);
+		while(true)
+		{
+			while(!(m_aheadRequested || m_aheadQuit))
+			{
+				lock.unlock();
+				sceKernelDelayThread(200);
+				lock.lock();
+			}
+			if(m_aheadQuit) break;
+			m_aheadRequested = false;
+			m_aheadBusy = true;
+			int64 start = m_aheadStart;
+			lock.unlock();
+			int result = -1;
+			if(sceIoLseek(m_aheadFd, start, SCE_SEEK_SET) == start) result = sceIoRead(m_aheadFd, m_ahead.data(), BUFFER_SIZE);
+			lock.lock();
+			m_aheadBusy = false;
+			if(m_aheadStart == start)
+			{
+				m_aheadValid = result;
+				m_aheadReady = (result > 0);
+			}
+			m_aheadDone.notify_all();
+		}
+	}
+
