+bool CBasicBlock::EnableIndirectDispatch(bool enabled)
+{
+	g_indirectDispatch = false;
+#if defined(__arm__) && !defined(__aarch64__) && !defined(AOT_ENABLED)
+	if(enabled && Jitter::CCodeGen_AArch32::GetChainedFrames())
+	{
+		Jitter::CCodeGen_AArch32::INDIRECT_DISPATCH info;
+		info.tableOffset = offsetof(CMIPS, m_indirectTable);
+		info.pcOffset = offsetof(CMIPS, m_State.nPC);
+		info.maskOffset = offsetof(CMIPS, m_indirectAddressMask);
+		info.tableBits = CMIPS::INDIRECT_TABLE_BITS;
+		static_assert(sizeof(CMIPS::INDIRECT_ENTRY) == 8, "the dispatcher reads 8 byte entries");
+		Jitter::CCodeGen_AArch32::SetIndirectDispatch(reinterpret_cast<uintptr_t>(&BranchBlockTrampoline), info);
+		g_indirectDispatch = true;
+	}
+#else
+	(void)enabled;
+#endif
+	return g_indirectDispatch;
+}
+
+uintptr_t CBasicBlock::GetLinkEntryAddress() const
+{
+#if !defined(AOT_USE_CACHE)
+	return reinterpret_cast<uintptr_t>(m_function.GetCode()) + m_linkEntryOffset;
+#else
+	return 0;
+#endif
+}
