-			statement.op = OP_MOV;
-			statement.src1 = MakeSymbolRef(MakeSymbol(SYM_CONSTANT, result ? 1 : 0));
-			statement.src2.reset();
-		}
-	}
-
-	assert(!(src1cst && src2cst && !changed));
