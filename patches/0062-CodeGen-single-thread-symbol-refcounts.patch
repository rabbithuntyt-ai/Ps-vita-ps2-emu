-		else if(src1cst && (src1cst->m_valueLow == 0) && (src1cst->m_valueHigh == 0))
-		{
-			statement.op = OP_MOV;
-			statement.src2.reset();
-			changed = true;
-		}
-	}
-
-	return changed;
