-bool CJitter::MergeCmpSelectOps(StatementList& statements)
-{
-	bool changed = false;
-
-	//Move a CMP down to the SELECT using its result when the statements in
-	//between neither read the predicate nor change the compared values (e.g.
-	//a branch computes its target between the two). Then they can merge.
-	for(auto selectIterator(statements.begin()); selectIterator != statements.end(); ++selectIterator)
-	{
-		const auto& select = *selectIterator;
-		if(select.op != OP_SELECT) continue;
-		if(selectIterator == statements.begin()) continue;
-		auto prevIterator = std::prev(selectIterator);
-		if(prevIterator->op == OP_CMP) continue;
-		auto predicate = select.src1->GetSymbol();
-		if(!predicate->IsTemporary()) continue;
-
-		auto cmpIterator = statements.end();
-		bool blocked = false;
-		for(auto it = prevIterator;; --it)
-		{
-			const auto& candidate = *it;
-			if((candidate.op == OP_CMP) && candidate.dst && candidate.dst->GetSymbol()->Equals(predicate.get()))
-			{
-				cmpIterator = it;
-				break;
-			}
-			if((candidate.op == OP_CALL) || (candidate.op == OP_PARAM) || (candidate.op == OP_PARAM_RET) ||
-			   (candidate.op == OP_LABEL) || (candidate.op == OP_GUESTLOAD) || (candidate.op == OP_GUESTSTORE) ||
-			   IsStoreThroughReference(candidate.op))
-			{
-				blocked = true;
-				break;
-			}
-			if(it == statements.begin()) break;
-		}
-		if(blocked || (cmpIterator == statements.end())) continue;
-
-		const auto& cmp = *cmpIterator;
-		bool safe = true;
-		for(auto it = std::next(cmpIterator); it != selectIterator; ++it)
-		{
-			const auto& between = *it;
-			between.VisitSources([&](const SymbolRefPtr& src, bool) {
-				if(src->GetSymbol()->Equals(predicate.get())) safe = false;
-			});
-			if(between.dst)
-			{
-				auto dstSymbol = between.dst->GetSymbol();
-				if(dstSymbol->Equals(predicate.get())) safe = false;
-				cmp.VisitSources([&](const SymbolRefPtr& src, bool) {
-					auto srcSymbol = src->GetSymbol();
-					if(srcSymbol->Equals(dstSymbol.get()) || srcSymbol->Aliases(dstSymbol.get())) safe = false;
-				});
-			}
-			if(!safe) break;
-		}
-		if(!safe) continue;
-
-		statements.splice(selectIterator, statements, cmpIterator);
-		changed = true;
-	}
-
-	for(auto statementIterator(statements.begin());
-	    statements.end() != statementIterator; ++statementIterator)
-	{
-		auto& statement = *statementIterator;
-		auto nextStatementIterator = statementIterator;
-		nextStatementIterator++;
-
-		if(nextStatementIterator == std::end(statements)) continue;
-		auto& nextStatement = *nextStatementIterator;
-
-		if(nextStatement.op != OP_SELECT) continue;
-		if(statement.op != OP_CMP) continue;
-
-		auto predicateSymbol = statement.dst;
-
-		if(!nextStatement.src1->Equals(predicateSymbol.get())) continue;
-
-		auto innerStatementIterator = nextStatementIterator;
-		innerStatementIterator++;
-
-		//Make sure predicate isn't used later
-		bool used = false;
-		for(; innerStatementIterator != statements.end(); ++innerStatementIterator)
-		{
-			const auto& innerStatement = *innerStatementIterator;
-			innerStatement.VisitSources([&](const SymbolRefPtr& src, bool isDst) { used |= src->Equals(predicateSymbol.get()); });
-			if(used) break;
-		}
-
-		if(used) continue;
-
-		nextStatement.op = OP_CMPSELECT_P2;
-		nextStatement.jmpCondition = statement.jmpCondition;
-		nextStatement.src1 = nextStatement.src2;
-		nextStatement.src2 = nextStatement.src3;
-		nextStatement.src3.reset();
-
-		statement.op = OP_CMPSELECT_P1;
-		statement.jmpCondition = Jitter::CONDITION_NEVER;
-		statement.dst.reset();
-
-		changed = true;
-	}
-
-	return changed;
-}
-
-bool CJitter::DeadcodeElimination(VERSIONED_STATEMENT_LIST& versionedStatementList)
-{
-	bool changed = false;
-
-	typedef std::list<StatementList::iterator> ToDeleteList;
-	ToDeleteList toDelete;
-
-	for(auto outerStatementIterator(versionedStatementList.statements.begin());
-	    versionedStatementList.statements.end() != outerStatementIterator; ++outerStatementIterator)
-	{
-		auto& outerStatement(*outerStatementIterator);
-		const auto& symbolRef(outerStatement.dst);
-
-		//Guest loads might have side effects (I/O registers): keep the ones writing to
-		//relatives. One writing to an unused temporary was moved by copy propagation.
-		if((outerStatement.op == OP_GUESTLOAD) && !outerStatement.dst->GetSymbol()->IsTemporary()) continue;
-
-		CSymbol* candidate = nullptr;
-		if(symbolRef && symbolRef->GetSymbol()->IsTemporary())
-		{
-			candidate = symbolRef->GetSymbol().get();
-		}
-		else if(auto relativeSymbol = dynamic_symbolref_cast(SYM_RELATIVE, symbolRef))
-		{
-			assert(symbolRef->IsVersioned());
-			if(symbolRef->GetVersion() != versionedStatementList.relativeVersions.GetRelativeVersion(relativeSymbol->m_valueLow))
-			{
-				candidate = relativeSymbol;
-			}
-		}
-
-		if(!candidate) continue;
-
-		//Look for any possible use of this symbol
-		bool used = false;
-		for(auto innerStatementIterator(outerStatementIterator);
-		    versionedStatementList.statements.end() != innerStatementIterator; ++innerStatementIterator)
-		{
-			if(outerStatementIterator == innerStatementIterator) continue;
-
-			const auto& innerStatement(*innerStatementIterator);
-
-			innerStatement.VisitSources(
-			    [&](const SymbolRefPtr& innerSymbolRef, bool) {
-				    if(innerSymbolRef->Equals(symbolRef.get()))
-				    {
-					    used = true;
-					    return;
-				    }
-
-				    auto symbol(innerSymbolRef->GetSymbol());
-				    if(!symbol->Equals(candidate) && symbol->Aliases(candidate))
-				    {
-					    used = true;
-					    return;
-				    }
-			    });
-
-			if(used) break;
-		}
-
-		if(!used)
-		{
-			//Kill it!
-			toDelete.push_back(outerStatementIterator);
-		}
-	}
-
-	for(ToDeleteList::const_iterator deleteIterator(toDelete.begin());
-	    toDelete.end() != deleteIterator; ++deleteIterator)
-	{
-		versionedStatementList.statements.erase(*deleteIterator);
-		changed = true;
-	}
-
-	return changed;
-}
-
-//Loop register promotion. A loop is a chain of blocks, entered only at its
-//header (by falling through, or the back jump ending the chain), with side
-//exits (conditional jumps out). Context symbols the chain uses most get a
-//register for the whole loop: loaded once in a preheader block, stored on
-//the way out through each exit (stub blocks), never in the loop itself.
-//Only symbols guest memory handlers can't touch, and only chains without
-//calls or external jumps, so nothing else can read the context meanwhile.
-void CJitter::PromoteLoopRegisters()
-{
-	static const bool disabled = (getenv("JITTER_NO_LOOP_PROMOTION") != nullptr); //for A/B testing
-	if(disabled) return;
-
-	unsigned int gprCount = m_codeGen->GetAvailableRegisterCount();
-	const unsigned int keepForTemporaries = 3;
-	if(gprCount <= keepForTemporaries) return;
-	unsigned int maxPromoted = std::min<unsigned int>(gprCount - keepForTemporaries, 4);
-
-	for(auto tailIterator = m_basicBlocks.begin(); tailIterator != m_basicBlocks.end(); ++tailIterator)
-	{
-		auto& tail = *tailIterator;
-		if(tail.statements.empty()) continue;
-		const auto& backJump = tail.statements.back();
-		if(backJump.op != OP_JMP) continue;
-		uint32 headerId = backJump.jmpBlock;
-
-		auto headerIterator = m_basicBlocks.begin();
-		for(; headerIterator != tailIterator; ++headerIterator)
-		{
-			if(headerIterator->id == headerId) break;
-		}
-		if((headerIterator == tailIterator) && (tail.id != headerId)) continue;
-		if(headerIterator == m_basicBlocks.begin()) continue;
-
-		auto chainEnd = std::next(tailIterator);
-		std::set<uint32> chainIds;
-		for(auto it = headerIterator; it != chainEnd; ++it) chainIds.insert(it->id);
-
-		//Single entry: nothing but the back jump targets the chain
-		bool ok = true;
-		for(const auto& block : m_basicBlocks)
-		{
-			for(const auto& statement : block.statements)
-			{
-				if((statement.op != OP_JMP) && (statement.op != OP_CONDJMP)) continue;
-				if(chainIds.count(statement.jmpBlock) == 0) continue;
-				if(&statement != &backJump) ok = false;
-			}
-		}
-		if(!ok) continue;
-
-		//No calls or external jumps; jumps only as side exits or the back jump
-		std::map<uint32, unsigned int> useCounts;
-		std::vector<CSymbol*> otherRelatives;
-		for(auto it = headerIterator; ok && (it != chainEnd); ++it)
-		{
-			for(const auto& statement : it->statements)
-			{
-				switch(statement.op)
-				{
-				case OP_CALL:
-				case OP_PARAM:
-				case OP_PARAM_RET:
-				case OP_RETVAL:
-				case OP_EXTERNJMP:
-				case OP_EXTERNJMP_DYN:
-				case OP_GOTO:
-				case OP_LABEL:
-					ok = false;
-					break;
-				case OP_JMP:
-					if(&statement != &backJump) ok = false;
-					break;
-				default:
-					break;
-				}
-				statement.VisitOperands([&](const SymbolRefPtr& symbolRef, bool) {
-					auto symbol = symbolRef->GetSymbol().get();
-					if((symbol->m_type == SYM_RELATIVE) && IsGuestMemorySafeSymbol(symbol))
-					{
-						useCounts[symbol->m_valueLow]++;
-					}
-					else if(symbol->IsRelative() || (symbol->m_type == SYM_REL_REFERENCE))
-					{
-						otherRelatives.push_back(symbol);
-					}
-				});
-			}
-		}
-		if(!ok) continue;
-
-		//Candidates not overlapped by other accesses (64/128-bit, references...)
-		std::vector<std::pair<unsigned int, uint32>> candidates;
-		for(const auto& useCount : useCounts)
-		{
-			CSymbol candidate(SYM_RELATIVE, useCount.first, 0);
-			bool aliased = false;
-			for(auto* other : otherRelatives)
-			{
-				if((other->m_type == SYM_REL_REFERENCE) || candidate.Aliases(other)) aliased = true;
-			}
-			if(!aliased) candidates.push_back(std::make_pair(useCount.second, useCount.first));
-		}
-		if(candidates.empty()) continue;
-		std::sort(candidates.begin(), candidates.end(), [](const auto& a, const auto& b) {
-			return (a.first != b.first) ? (a.first > b.first) : (a.second < b.second);
-		});
-		if(candidates.size() > maxPromoted) candidates.resize(maxPromoted);
-
-		//Highest register ids, so the block allocator keeps the low ones
-		std::map<uint32, unsigned int> promoted; //offset -> register id
-		uint32 reservedMask = 0;
-		for(unsigned int i = 0; i < candidates.size(); i++)
-		{
-			unsigned int registerId = gprCount - 1 - i;
-			promoted[candidates[i].second] = registerId;
-			reservedMask |= (1 << registerId);
-		}
-
-		//Rewrite the chain; remember what it writes
-		std::set<uint32> defined;
-		for(auto it = headerIterator; it != chainEnd; ++it)
-		{
-			auto& block = *it;
-			block.reservedRegisters |= reservedMask;
-			for(auto& statement : block.statements)
-			{
-				if(statement.dst)
-				{
-					auto dstSymbol = statement.dst->GetSymbol();
-					if((dstSymbol->m_type == SYM_RELATIVE) && promoted.count(dstSymbol->m_valueLow)) defined.insert(dstSymbol->m_valueLow);
-				}
-				statement.VisitOperands([&](SymbolRefPtr& symbolRef, bool) {
-					auto symbol = symbolRef->GetSymbol();
-					if(symbol->m_type != SYM_RELATIVE) return;
-					auto promotedIterator = promoted.find(symbol->m_valueLow);
-					if(promotedIterator == promoted.end()) return;
-					symbolRef = MakeSymbolRef(MakeSymbol(&block, SYM_REGISTER, promotedIterator->second, 0));
-				});
-			}
-		}
-
-		//Preheader: load everything once
-		{
-			BASIC_BLOCK preheader;
-			preheader.id = m_nextBlockId++;
-			preheader.optimized = true;
-			preheader.reservedRegisters = reservedMask;
-			for(const auto& promotedPair : promoted)
-			{
-				STATEMENT statement;
-				statement.op = OP_MOV;
-				statement.dst = MakeSymbolRef(MakeSymbol(&preheader, SYM_REGISTER, promotedPair.second, 0));
-				statement.src1 = MakeSymbolRef(MakeSymbol(&preheader, SYM_RELATIVE, promotedPair.first, 0));
-				preheader.statements.push_back(statement);
-			}
-			m_basicBlocks.insert(headerIterator, std::move(preheader));
-		}
-
-		//Exits: side exits go through stubs that store what the loop wrote. The
-		//stubs follow the tail, which ends with the back jump (no fall through).
-		auto stubPosition = chainEnd;
-		for(auto it = headerIterator; it != chainEnd; ++it)
-		{
-			for(auto& statement : it->statements)
-			{
-				if(statement.op != OP_CONDJMP) continue;
-				if(chainIds.count(statement.jmpBlock) != 0) continue;
-				BASIC_BLOCK stub;
-				stub.id = m_nextBlockId++;
-				stub.optimized = true;
-				stub.hasJumpRef = true;
-				stub.reservedRegisters = reservedMask;
-				for(auto offset : defined)
-				{
-					STATEMENT store;
-					store.op = OP_MOV;
-					store.dst = MakeSymbolRef(MakeSymbol(&stub, SYM_RELATIVE, offset, 0));
-					store.src1 = MakeSymbolRef(MakeSymbol(&stub, SYM_REGISTER, promoted[offset], 0));
-					stub.statements.push_back(store);
-				}
-				STATEMENT jump;
-				jump.op = OP_JMP;
-				jump.jmpBlock = statement.jmpBlock;
-				stub.statements.push_back(jump);
-				statement.jmpBlock = stub.id;
-				m_basicBlocks.insert(stubPosition, std::move(stub));
-			}
-		}
-		//One loop per function (blocks loop on themselves)
-		return;
-	}
-}
-
-//"t = op(...); ...; rel = t" -> "rel = op(...); ...": the operation writes the
-//context symbol directly (later uses of t read rel), which saves a copy once
-//registers are allocated. Only when nothing in between touches rel and
-//nothing can observe the context (calls, guest memory ops, jumps).
-void CJitter::CoalesceIntoRelatives(BASIC_BLOCK& basicBlock)
-{
-	static const bool disabled = (getenv("JITTER_NO_COALESCE_REL") != nullptr); //for A/B testing
-	if(disabled) return;
-	auto& statements = basicBlock.statements;
-	auto isSimpleOp = [](OPERATION op) {
-		switch(op)
-		{
-		case OP_ADD:
-		case OP_SUB:
-		case OP_AND:
-		case OP_OR:
-		case OP_XOR:
-		case OP_NOT:
-		case OP_SRA:
-		case OP_SRL:
-		case OP_SLL:
-		case OP_CMP:
-		case OP_SELECT:
-		case OP_CMPSELECT_P2:
-		case OP_LZC:
-			return true;
-		default:
-			return false;
-		}
-	};
-	auto isBarrier = [](const STATEMENT& statement) {
-		switch(statement.op)
-		{
-		case OP_CALL:
-		case OP_PARAM:
-		case OP_PARAM_RET:
-		case OP_RETVAL:
-		case OP_LABEL:
-		case OP_JMP:
-		case OP_CONDJMP:
-		case OP_GOTO:
-		case OP_EXTERNJMP:
-		case OP_EXTERNJMP_DYN:
-		case OP_GUESTLOAD:
-		case OP_GUESTSTORE:
-		case OP_STOREATREF:
-		case OP_STORE8ATREF:
-		case OP_STORE16ATREF:
-		case OP_MD_STOREATREF_MASKED:
-			return true;
-		default:
-			return false;
-		}
-	};
-	auto touches = [](const STATEMENT& statement, CSymbol* symbol) {
-		bool result = false;
-		statement.VisitOperands([&](const SymbolRefPtr& symbolRef, bool) {
-			auto other = symbolRef->GetSymbol().get();
-			if(other->Equals(symbol) || other->Aliases(symbol)) result = true;
-		});
-		return result;
-	};
-
-	for(auto copyIterator = statements.begin(); copyIterator != statements.end();)
-	{
-		auto& copy = *copyIterator;
-		if((copy.op != OP_MOV) || !copy.dst || !copy.src1)
-		{
-			++copyIterator;
-			continue;
-		}
-		auto rel = copy.dst->GetSymbol();
-		auto tmp = copy.src1->GetSymbol();
-		if((rel->m_type != SYM_RELATIVE) || (tmp->m_type != SYM_TEMPORARY))
-		{
-			++copyIterator;
-			continue;
-		}
-
-		//The single definition of tmp, before the copy, with nothing in between that
-		//touches rel or could observe the context
-		auto defIterator = statements.end();
-		bool ok = true;
-		for(auto it = copyIterator; it != statements.begin();)
-		{
-			--it;
-			const auto& statement = *it;
-			if(statement.dst && statement.dst->GetSymbol()->Equals(tmp.get()))
-			{
-				defIterator = it;
-				break;
-			}
-			if(isBarrier(statement) || touches(statement, rel.get()))
-			{
-				ok = false;
-				break;
-			}
-		}
-		if(!ok || (defIterator == statements.end()) || !isSimpleOp(defIterator->op))
-		{
-			++copyIterator;
-			continue;
-		}
-		//No other definition of tmp in the block
-		unsigned int defCount = 0;
-		for(const auto& statement : statements)
-		{
-			if(statement.dst && statement.dst->GetSymbol()->Equals(tmp.get())) defCount++;
-		}
-		if(defCount != 1)
-		{
-			++copyIterator;
-			continue;
-		}
-		//Uses of tmp after the copy must come before rel changes again
-		bool relChanged = false;
-		for(auto it = std::next(copyIterator); it != statements.end(); ++it)
-		{
-			const auto& statement = *it;
-			bool usesTmp = false;
-			statement.VisitSources([&](const SymbolRefPtr& src, bool) {
-				if(src->GetSymbol()->Equals(tmp.get())) usesTmp = true;
-			});
-			if(usesTmp && relChanged)
-			{
-				ok = false;
-				break;
-			}
-			if(statement.dst)
-			{
-				auto dstSymbol = statement.dst->GetSymbol();
-				if(dstSymbol->Equals(rel.get()) || dstSymbol->Aliases(rel.get())) relChanged = true;
-			}
-			if(isBarrier(statement)) relChanged = true;
-		}
-		if(!ok)
-		{
-			++copyIterator;
-			continue;
-		}
-
-		defIterator->dst = MakeSymbolRef(rel);
-		for(auto it = std::next(defIterator); it != statements.end(); ++it)
-		{
-			it->VisitSources([&](SymbolRefPtr& src, bool) {
-				if(src->GetSymbol()->Equals(tmp.get())) src = MakeSymbolRef(rel);
-			});
-		}
-		copyIterator = statements.erase(copyIterator);
-	}
