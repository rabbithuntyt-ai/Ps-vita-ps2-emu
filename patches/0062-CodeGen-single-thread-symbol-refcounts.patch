-{
-	uint32 valueLo = static_cast<uint32>(value);
-	uint32 valueHi = static_cast<uint32>(value >> 32);
-	return MakeSymbol(m_currentBlock, SYM_CONSTANT64, valueLo, valueHi);
-}
