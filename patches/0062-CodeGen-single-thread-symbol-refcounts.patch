-				}
-				if(innerStatement.src1)
-				{
-					auto symbol(innerStatement.src1->GetSymbol());
-					if(symbol->Equals(tempSymbol))
-					{
-						innerStatement.src1 = MakeSymbolRef(candidatePtr);
-					}
-				}
-				if(innerStatement.src2)
-				{
-					auto symbol(innerStatement.src2->GetSymbol());
