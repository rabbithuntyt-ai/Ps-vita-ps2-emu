-	{
-		newStatement.VisitOperands(
-		    [](SymbolRefPtr& symbolRef, bool) {
-			    if(symbolRef->IsVersioned())
-			    {
-				    symbolRef = std::make_shared<CSymbolRef>(symbolRef->GetSymbol());
-			    }
-		    });
