+#include "Jitter.h"
+#include <iostream>
+#include <set>
+
+#ifdef _DEBUG
+//#define DUMP_STATEMENTS
+#endif
+
+#ifdef DUMP_STATEMENTS
+#include <iostream>
+#endif
+
+using namespace Jitter;
+
+void CJitter::AllocateRegisters(BASIC_BLOCK& basicBlock)
+{
+	//Statements inserted before the statement at a given index (spills first, then loads,
+	//since a register can be handed over from one symbol to another at the same point)
+	InsertionMap spillStatements;
+	InsertionMap loadStatements;
+#ifdef DUMP_STATEMENTS
+	DumpStatementList(basicBlock.statements);
+	std::cout << std::endl;
+#endif
+
+	//Register allocation is done per "range". A range is a sequence of instructions
+	//that ends with a OP_CALL or with the block's end. We do allocation per range
+	//because changes to relative symbols might need to be visible by functions
+	//called by the block.
+
+	//Within a range, a symbol holds its register from its first to its last access:
+	//it is loaded right before its first use and saved right after its last definition.
+	//Nothing else reads the context during a range (calls end ranges), except the
+	//guest memory handlers, which only see symbols declared safe for them.
+
+	//Keep in mind that a temporary can remain live across a OP_CALL.
+
+	auto allocRanges = ComputeAllocationRanges(basicBlock);
+	for(const auto& allocRange : allocRanges)
+	{
+		bool isLastRange = (allocRange.second + 1) == basicBlock.statements.size();
+
+		SymbolRegAllocInfo symbolRegAllocs;
+		ComputeLivenessForRange(basicBlock, allocRange, symbolRegAllocs);
+
+		MarkAliasedSymbols(basicBlock, allocRange, symbolRegAllocs);
+
+		RegisterOccupancy occupancy;
+		//Registers holding promoted loop symbols are taken for the whole block
+		for(unsigned int i = 0; i < 32; i++)
+		{
+			if(basicBlock.reservedRegisters & (1 << i))
+			{
+				occupancy[std::make_pair(SYM_REGISTER, i)].push_back(std::make_pair(0U, ~0U));
+			}
+		}
+		AssociateSymbolsToRegisters(symbolRegAllocs, allocRange, occupancy);
+		CommitRegisterAllocation(basicBlock, allocRange, isLastRange, symbolRegAllocs, spillStatements, loadStatements);
+
+		//Context symbols that can't stay in registers across guest memory ops get
+		//registers between them
+		AllocateGuestMemoryUnsafeSymbols(basicBlock, allocRange, occupancy, spillStatements, loadStatements);
+	}
+
+	//Insert loads and spills
+	{
+		std::vector<StatementList::iterator> positions;
+		positions.reserve(basicBlock.statements.size() + 1);
+		for(auto it = basicBlock.statements.begin(); it != basicBlock.statements.end(); ++it)
+		{
+			positions.push_back(it);
+		}
+		positions.push_back(basicBlock.statements.end());
+
+		for(unsigned int index = 0; index < positions.size(); index++)
+		{
+			for(auto it = spillStatements.lower_bound(index); it != spillStatements.upper_bound(index); ++it)
+			{
+				basicBlock.statements.insert(positions[index], it->second);
+			}
+			for(auto it = loadStatements.lower_bound(index); it != loadStatements.upper_bound(index); ++it)
+			{
+				basicBlock.statements.insert(positions[index], it->second);
+			}
+		}
+	}
+
+#ifdef DUMP_STATEMENTS
+	DumpStatementList(basicBlock.statements);
+	std::cout << std::endl;
+#endif
+}
+
+void CJitter::CommitRegisterAllocation(BASIC_BLOCK& basicBlock, const AllocationRange& allocRange, bool isLastRange,
+                                       const SymbolRegAllocInfo& symbolRegAllocs, InsertionMap& spillStatements, InsertionMap& loadStatements)
+{
+	auto& symbolTable = basicBlock.symbolTable;
+
+	//Replace all references to symbols by references to allocated registers
+	for(const auto& statementInfo : IndexedStatementList(basicBlock.statements))
+	{
+		auto& statement(statementInfo.statement);
+		const auto& statementIdx(statementInfo.index);
+		if(statementIdx < allocRange.first) continue;
+		if(statementIdx > allocRange.second) break;
+
+		statement.VisitOperands(
+		    [&](SymbolRefPtr& symbolRef, bool) {
+			    auto symbolRegAllocIterator = symbolRegAllocs.find(symbolRef->GetSymbol());
+			    if(symbolRegAllocIterator == std::end(symbolRegAllocs)) return;
+			    const auto& symbolRegAlloc = symbolRegAllocIterator->second;
+			    if(symbolRegAlloc.registerId == -1) return;
+			    symbolRef = MakeSymbolRef(symbolTable.MakeSymbol(symbolRegAlloc.registerType, symbolRegAlloc.registerId));
+		    });
+	}
+
+	for(const auto& symbolRegAllocPair : symbolRegAllocs)
+	{
+		const auto& symbol = symbolRegAllocPair.first;
+		const auto& symbolRegAlloc = symbolRegAllocPair.second;
+
+		//Check if it's actually allocated
+		if(symbolRegAlloc.registerId == -1) continue;
+
+		//firstUse == -1 means it is written to but never used afterwards in this block
+
+		//If symbol is read and we use this symbol before we define it, so we need to load it first
+		if((symbolRegAlloc.firstUse != -1) && (symbolRegAlloc.firstUse <= symbolRegAlloc.firstDef))
+		{
+			STATEMENT statement;
+			statement.op = OP_MOV;
+			statement.dst = MakeSymbolRefPtr(
+			    symbolTable.MakeSymbol(symbolRegAlloc.registerType, symbolRegAlloc.registerId));
+			statement.src1 = MakeSymbolRefPtr(symbol);
+			loadStatements.insert(std::make_pair(symbolRegAlloc.firstUse, statement));
+		}
+
+		//If symbol is defined, we need to save it after its last definition
+		//Exception: Temporaries can be discarded if we're in the last range of the block
+		bool deadTemporary = symbol->IsTemporary() && isLastRange;
+		if(!deadTemporary && (symbolRegAlloc.firstDef != -1))
+		{
+			STATEMENT statement;
+			statement.op = OP_MOV;
+			statement.dst = MakeSymbolRefPtr(symbol);
+			statement.src1 = MakeSymbolRefPtr(
+			    symbolTable.MakeSymbol(symbolRegAlloc.registerType, symbolRegAlloc.registerId));
+			spillStatements.insert(std::make_pair(symbolRegAlloc.lastDef + 1, statement));
+		}
+	}
+}
+
+void CJitter::AllocateGuestMemoryUnsafeSymbols(BASIC_BLOCK& basicBlock, const AllocationRange& allocRange, RegisterOccupancy& occupancy,
+                                               InsertionMap& spillStatements, InsertionMap& loadStatements)
+{
+	//Sub ranges: statements between guest memory ops (the op ends its sub range)
+	std::vector<unsigned int> guestOpIndices;
+	for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+	{
+		const auto& statement(statementInfo.statement);
+		const auto& statementIdx(statementInfo.index);
+		if(statementIdx < allocRange.first) continue;
+		if(statementIdx > allocRange.second) break;
+		if((statement.op == OP_GUESTLOAD) || (statement.op == OP_GUESTSTORE))
+		{
+			guestOpIndices.push_back(statementIdx);
+		}
+	}
+	if(guestOpIndices.empty()) return;
+
+	AllocationRangeArray subRanges;
+	unsigned int subStart = allocRange.first;
+	for(auto guestOpIndex : guestOpIndices)
+	{
+		if(guestOpIndex > subStart) subRanges.push_back(std::make_pair(subStart, guestOpIndex));
+		subStart = guestOpIndex + 1;
+	}
+	if(subStart <= allocRange.second) subRanges.push_back(std::make_pair(subStart, allocRange.second));
+
+	for(const auto& subRange : subRanges)
+	{
+		SymbolRegAllocInfo symbolRegAllocs;
+		ComputeLivenessForRange(basicBlock, subRange, symbolRegAllocs);
+		MarkAliasedSymbols(basicBlock, subRange, symbolRegAllocs, false);
+
+		//Only unsafe symbols, not used by the guest memory op ending the sub range
+		//(they are loaded after the previous op and saved before the next one)
+		for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+		{
+			const auto& statement(statementInfo.statement);
+			if(statementInfo.index != subRange.second) continue;
+			if((statement.op != OP_GUESTLOAD) && (statement.op != OP_GUESTSTORE)) break;
+			statement.VisitOperands(
+			    [&](const SymbolRefPtr& symbolRef, bool) {
+				    auto symbolIterator = symbolRegAllocs.find(symbolRef->GetSymbol());
+				    if(symbolIterator != std::end(symbolRegAllocs)) symbolIterator->second.aliased = true;
+			    });
+			break;
+		}
+		for(auto& symbolRegAllocPair : symbolRegAllocs)
+		{
+			if(IsGuestMemorySafeSymbol(symbolRegAllocPair.first.get()))
+			{
+				symbolRegAllocPair.second.aliased = true;
+			}
+		}
+
+		AssociateSymbolsToRegisters(symbolRegAllocs, subRange, occupancy);
+		CommitRegisterAllocation(basicBlock, subRange, false, symbolRegAllocs, spillStatements, loadStatements);
+	}
+}
+
+void CJitter::AssociateSymbolsToRegisters(SymbolRegAllocInfo& symbolRegAllocs, const AllocationRange& allocRange, RegisterOccupancy& occupancy) const
+{
+	//Some notes:
+	//- MD and FP registers are lumped together since MD registers are used for both
+	//  MD and FP operations on all of our target platforms.
+	//- A register can hold several symbols whose live intervals (first to last access)
+	//  in the range don't overlap.
+
+	unsigned int gprCount = m_codeGen->GetAvailableRegisterCount();
+	unsigned int mdCount = m_codeGen->GetAvailableMdRegisterCount();
+
+	auto getInterval =
+	    [&](const SymbolPtr&, const SYMBOL_REGALLOCINFO& symbolRegAlloc) {
+		    unsigned int start = std::min(symbolRegAlloc.firstUse, symbolRegAlloc.firstDef);
+		    unsigned int end = 0;
+		    if(symbolRegAlloc.lastUse != -1) end = std::max(end, symbolRegAlloc.lastUse);
+		    if(symbolRegAlloc.lastDef != -1) end = std::max(end, symbolRegAlloc.lastDef);
+		    assert((start >= allocRange.first) && (end <= allocRange.second) && (start <= end));
+		    return std::make_pair(start, end);
+	    };
+
+	//Best fit: prefer a register already holding other (non overlapping) intervals,
+	//keeping free registers for symbols live across the whole range
+	auto tryTakeRegister =
+	    [&](SYM_TYPE poolType, unsigned int poolCount, const std::pair<unsigned int, unsigned int>& interval) -> int {
+		    int bestRegister = -1;
+		    size_t bestOccupancy = 0;
+		    for(unsigned int i = 0; i < poolCount; i++)
+		    {
+			    const auto& intervals = occupancy[std::make_pair(poolType, i)];
+			    bool overlaps = false;
+			    for(const auto& other : intervals)
+			    {
+				    if((interval.first <= other.second) && (other.first <= interval.second))
+				    {
+					    overlaps = true;
+					    break;
+				    }
+			    }
+			    if(overlaps) continue;
+			    if((bestRegister == -1) || (intervals.size() > bestOccupancy))
+			    {
+				    bestRegister = i;
+				    bestOccupancy = intervals.size();
+			    }
+		    }
+		    if(bestRegister != -1)
+		    {
+			    occupancy[std::make_pair(poolType, bestRegister)].push_back(interval);
+		    }
+		    return bestRegister;
+	    };
+
+	bool fpInMdRegisters = m_codeGen->CanAllocateFpInMdRegisters();
+	auto isRegisterAllocatable =
+	    [fpInMdRegisters](SYM_TYPE symbolType) {
+		    return (symbolType == SYM_RELATIVE) || (symbolType == SYM_TEMPORARY) ||
+		           (symbolType == SYM_REL_REFERENCE) || (symbolType == SYM_TMP_REFERENCE) ||
+		           (fpInMdRegisters && ((symbolType == SYM_FP_RELATIVE32) || (symbolType == SYM_FP_TEMPORARY32))) ||
+		           (symbolType == SYM_RELATIVE128) || (symbolType == SYM_TEMPORARY128);
+	    };
+
+	//Sort symbols by usage count
+	std::list<SymbolRegAllocInfo::value_type*> sortedSymbols;
+	for(auto& symbolRegAllocPair : symbolRegAllocs)
+	{
+		const auto& symbol(symbolRegAllocPair.first);
+		const auto& symbolRegAlloc(symbolRegAllocPair.second);
+		if(!isRegisterAllocatable(symbol->m_type)) continue;
+		if(symbolRegAlloc.aliased) continue;
+		sortedSymbols.push_back(&symbolRegAllocPair);
+	}
+	sortedSymbols.sort(
+	    [](SymbolRegAllocInfo::value_type* symbolRegAllocPair1, SymbolRegAllocInfo::value_type* symbolRegAllocPair2) {
+		    const auto& symbol1(symbolRegAllocPair1->first);
+		    const auto& symbol2(symbolRegAllocPair2->first);
+		    const auto& symbolRegAlloc1(symbolRegAllocPair1->second);
+		    const auto& symbolRegAlloc2(symbolRegAllocPair2->second);
+		    if(symbolRegAlloc1.useCount == symbolRegAlloc2.useCount)
+		    {
+			    if(symbol1->m_type == symbol2->m_type)
+			    {
+				    return symbol1->m_valueLow > symbol2->m_valueLow;
+			    }
+			    else
+			    {
+				    return symbol1->m_type > symbol2->m_type;
+			    }
+		    }
+		    else
+		    {
+			    return symbolRegAlloc1.useCount > symbolRegAlloc2.useCount;
+		    }
+	    });
+
+	for(auto& symbolRegAllocPair : sortedSymbols)
+	{
+		const auto& symbol = symbolRegAllocPair->first;
+		auto& symbolRegAlloc = symbolRegAllocPair->second;
+
+		//Find suitable register for this symbol
+		auto poolType = SYM_REGISTER;
+		auto registerSymbolType = SYM_REGISTER;
+		if((symbol->m_type == SYM_RELATIVE) || (symbol->m_type == SYM_TEMPORARY))
+		{
+			registerSymbolType = SYM_REGISTER;
+		}
+		else if((symbol->m_type == SYM_REL_REFERENCE) || (symbol->m_type == SYM_TMP_REFERENCE))
+		{
+			registerSymbolType = SYM_REG_REFERENCE;
+		}
+		else if((symbol->m_type == SYM_FP_RELATIVE32) || (symbol->m_type == SYM_FP_TEMPORARY32))
+		{
+			poolType = SYM_REGISTER128;
+			registerSymbolType = SYM_FP_REGISTER32;
+		}
+		else if((symbol->m_type == SYM_RELATIVE128) || (symbol->m_type == SYM_TEMPORARY128))
+		{
+			poolType = SYM_REGISTER128;
+			registerSymbolType = SYM_REGISTER128;
+		}
+		int registerId = tryTakeRegister(poolType, (poolType == SYM_REGISTER) ? gprCount : mdCount,
+		                                 getInterval(symbol, symbolRegAlloc));
+		if(registerId != -1)
+		{
+			symbolRegAlloc.registerType = registerSymbolType;
+			symbolRegAlloc.registerId = registerId;
+		}
+	}
+}
+
+CJitter::AllocationRangeArray CJitter::ComputeAllocationRanges(const BASIC_BLOCK& basicBlock)
+{
+	AllocationRangeArray result;
+	unsigned int currentStart = 0;
+	for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+	{
+		const auto& statement(statementInfo.statement);
+		const auto& statementIdx(statementInfo.index);
+		if(statement.op == OP_CALL)
+		{
+			//Gotta split here
+			result.push_back(std::make_pair(currentStart, statementIdx));
+			currentStart = statementIdx + 1;
+		}
+	}
+	result.push_back(std::make_pair(currentStart, basicBlock.statements.size() - 1));
+	return result;
+}
+
+void CJitter::ComputeLivenessForRange(const BASIC_BLOCK& basicBlock, const AllocationRange& allocRange, SymbolRegAllocInfo& symbolRegAllocs) const
+{
+	for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+	{
+		const auto& statement(statementInfo.statement);
+		unsigned int statementIdx(statementInfo.index);
+		if(statementIdx < allocRange.first) continue;
+		if(statementIdx > allocRange.second) continue;
+
+		statement.VisitDestination(
+		    [&](const SymbolRefPtr& symbolRef, bool) {
+			    auto symbol(symbolRef->GetSymbol());
+			    auto& symbolRegAlloc = symbolRegAllocs[symbol];
+			    symbolRegAlloc.useCount++;
+			    if(symbolRegAlloc.firstDef == -1)
+			    {
+				    symbolRegAlloc.firstDef = statementIdx;
+			    }
+			    if((symbolRegAlloc.lastDef == -1) || (statementIdx > symbolRegAlloc.lastDef))
+			    {
+				    symbolRegAlloc.lastDef = statementIdx;
+			    }
+		    });
+
+		//Parameters are read when the call is emitted: they are used up to the call
+		bool isParam = (statement.op == OP_PARAM) || (statement.op == OP_PARAM_RET);
+		unsigned int useIdx = isParam ? allocRange.second : statementIdx;
+
+		statement.VisitSources(
+		    [&](const SymbolRefPtr& symbolRef, bool) {
+			    auto symbol(symbolRef->GetSymbol());
+			    auto& symbolRegAlloc = symbolRegAllocs[symbol];
+			    symbolRegAlloc.useCount++;
+			    if(symbolRegAlloc.firstUse == -1)
+			    {
+				    symbolRegAlloc.firstUse = statementIdx;
+			    }
+			    if((symbolRegAlloc.lastUse == -1) || (useIdx > symbolRegAlloc.lastUse))
+			    {
+				    symbolRegAlloc.lastUse = useIdx;
+			    }
+		    });
+	}
+}
+
+void CJitter::MarkAliasedSymbols(const BASIC_BLOCK& basicBlock, const AllocationRange& allocRange, SymbolRegAllocInfo& symbolRegAllocs, bool checkGuestMemoryOps) const
+{
+	bool hasGuestMemoryOp = false;
+	for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+	{
+		auto& statement(statementInfo.statement);
+		const auto& statementIdx(statementInfo.index);
+		if(statementIdx < allocRange.first) continue;
+		if(statementIdx > allocRange.second) break;
+		if(checkGuestMemoryOps && ((statement.op == OP_GUESTLOAD) || (statement.op == OP_GUESTSTORE)))
+		{
+			hasGuestMemoryOp = true;
+			break;
+		}
+	}
+
+	if(hasGuestMemoryOp)
+	{
+		//Guest memory ops can call a handler that may read or write context
+		//state: only symbols declared safe can stay in registers across them.
+		for(auto& symbolRegAlloc : symbolRegAllocs)
+		{
+			if(!IsGuestMemorySafeSymbol(symbolRegAlloc.first.get()))
+			{
+				symbolRegAlloc.second.aliased = true;
+			}
+		}
+	}
+
+	for(const auto& statementInfo : ConstIndexedStatementList(basicBlock.statements))
+	{
+		auto& statement(statementInfo.statement);
+		const auto& statementIdx(statementInfo.index);
+		if(statementIdx < allocRange.first) continue;
+		if(statementIdx > allocRange.second) break;
+		if(statement.op == OP_PARAM_RET)
+		{
+			//This symbol will end up being written to by the callee, thus will be aliased
+			auto& symbolRegAlloc = symbolRegAllocs[statement.src1->GetSymbol()];
+			symbolRegAlloc.aliased = true;
+		}
+		for(auto& symbolRegAlloc : symbolRegAllocs)
+		{
+			if(symbolRegAlloc.second.aliased) continue;
+			auto testedSymbol = symbolRegAlloc.first;
+			statement.VisitOperands(
+			    [&](const SymbolRefPtr& symbolRef, bool) {
+				    auto symbol = symbolRef->GetSymbol();
+				    if(symbol->Equals(testedSymbol.get())) return;
+				    if(symbol->Aliases(testedSymbol.get()))
+				    {
+					    symbolRegAlloc.second.aliased = true;
+				    }
+			    });
+		}
+	}
+}
