-static bool IsStoreThroughReference(OPERATION op)
-{
-	switch(op)
-	{
-	case OP_MD_STOREATREF_MASKED:
-	case OP_STORE16ATREF:
-	case OP_STORE8ATREF:
-	case OP_STOREATREF:
-		return true;
-	default:
-		return false;
-	}
-}
