@@ -76,6 +76,38 @@
 	//its unpack and program time showed as the EE thread's
 	inline std::atomic<uint8> g_vu1Section{SECTION_LIMITER};
 	inline thread_local std::atomic<uint8>* t_section = &g_section;
+	//The current thread's section without thread_local: on the Vita thread_local is emulated (a
+	//call into the runtime and a walk of its key list at every access), so the emulation thread,
+	//the VU1 worker and the IOP thread register the thread register TPIDRURO (one instruction to
+	//read) and a scope compares it with them; any other thread goes through t_section
+	inline uintptr_t g_eeThreadKey = 0, g_vu1ThreadKey = 0, g_iopThreadKey = 0;
+	inline bool g_fastScope = true; //fast_scope (Vita)
+	inline uintptr_t CurrentThreadKey()
+	{
+#if defined(__vita__)
+		uintptr_t value;
+		__asm__ volatile("mrc p15, 0, %0, c13, c0, 3" : "=r"(value));
+		return value;
+#else
+		return 0;
+#endif
+	}
+	inline std::atomic<uint8>& CurrentSection()
+	{
+#if defined(__vita__)
+		if(g_fastScope)
+		{
+			uintptr_t key = CurrentThreadKey();
+			if(key != 0)
+			{
+				if(key == g_eeThreadKey) return g_section;
+				if(key == g_vu1ThreadKey) return g_vu1Section;
+				if(key == g_iopThreadKey) return g_iopSection;
+			}
+		}
+#endif
+		return *t_section;
+	}
 	// Time the emulation thread sleeps, in microseconds.
 	inline std::atomic<uint64_t> g_discReadUs{0};
 	inline std::atomic<uint64_t> g_discReads{0};
