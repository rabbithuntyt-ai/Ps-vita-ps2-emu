+void CGSHandler::SubmitWriteBufferThen(CMailBox::FunctionType&& function)
+{
+	if(!g_mergedSubmit || (m_writeBufferSubmitIndex == m_writeBufferSize))
+	{
+		SubmitWriteBuffer();
+		SendGSCall(std::move(function));
+		return;
+	}
+	auto bufferStart = m_currentWriteBuffer + m_writeBufferSubmitIndex;
+	auto bufferEnd = m_currentWriteBuffer + m_writeBufferSize;
+	SendGSCall(
+	    [this, bufferStart, bufferEnd, function = std::move(function)]() {
+		    uint64 submitStart = g_sectionClock ? g_sectionClock() : 0;
+		    SubmitWriteBufferImpl(bufferStart, bufferEnd);
+		    if(g_sectionClock) { g_submitUs += g_sectionClock() - submitStart; g_submitCalls++; g_registerWrites += bufferEnd - bufferStart; }
+		    function();
+	    });
+	m_writeBufferSubmitIndex = m_writeBufferSize;
+}
