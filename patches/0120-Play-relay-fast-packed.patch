 uint32 CGIF::ProcessPacked(const uint8* memory, uint32 address, uint32 end)
 {
+	CGSHandler* gs = m_gs;
+	uint32 room = 0;
+	CGSHandler::RegisterWrite* out = gs->GetWriteCursor(room);
+	//Each qword makes at most one write; when they might not fit, Play's loop (it counts the
+	//writes that do not fit)
+	if(!g_fastPacked || (((end - address + 0xF) / 0x10) > room))
+	{
+		return ProcessPackedSlow(memory, address, end);
+	}
+
+	uint32 start = address;
+	uint32 loops = m_loops;
+	uint32 regs = m_regs;
+	uint32 regsTemp = m_regsTemp;
+	uint32 qtemp = m_qtemp;
+	uint8 descs[16];
+	for(uint32 i = 0; i < 16; i++)
+	{
+		descs[i] = static_cast<uint8>((m_regList >> (i * 4)) & 0x0F);
+	}
+	uint32 count = 0;
+	auto put = [&](uint8 reg, uint64 value) {
+		out[count].first = reg;
+		out[count].second = value;
+		count++;
+	};
+
+	while((loops != 0) && (address < end))
+	{
+		while((regsTemp != 0) && (address < end))
+		{
+			uint32 regDesc = descs[regs - regsTemp];
+			const uint8* qword = memory + address;
+			uint32 v0, v1, v2, v3;
+			uint64 d0, d1;
+			memcpy(&v0, qword + 0, 4);
+			memcpy(&v1, qword + 4, 4);
+			memcpy(&v2, qword + 8, 4);
+			memcpy(&v3, qword + 12, 4);
+			d0 = static_cast<uint64>(v0) | (static_cast<uint64>(v1) << 32);
+			d1 = static_cast<uint64>(v2) | (static_cast<uint64>(v3) << 32);
+
+			switch(regDesc)
+			{
+			case 0x00:
+				//PRIM
+				put(GS_REG_PRIM, v0);
+				break;
+			case 0x01:
+				//RGBA
+				put(GS_REG_RGBAQ, (v0 & 0xFF) | ((v1 & 0xFF) << 8) | ((v2 & 0xFF) << 16) | (static_cast<uint64>(v3 & 0xFF) << 24) | (static_cast<uint64>(qtemp) << 32));
+				break;
+			case 0x02:
+				//ST
+				qtemp = v2;
+				put(GS_REG_ST, d0);
+				break;
+			case 0x03:
+				//UV
+				put(GS_REG_UV, (v0 & 0x7FFF) | ((v1 & 0x7FFF) << 16));
+				break;
+			case 0x04:
+			{
+				//XYZF2
+				uint64 temp = (v0 & 0xFFFF) | ((v1 & 0xFFFF) << 16);
+				temp |= static_cast<uint64>(v2 & 0x0FFFFFF0) << 28;
+				temp |= static_cast<uint64>(v3 & 0x00000FF0) << 52;
+				put((v3 & 0x8000) ? GS_REG_XYZF3 : GS_REG_XYZF2, temp);
+			}
+			break;
+			case 0x05:
+			{
+				//XYZ2
+				uint64 temp = (v0 & 0xFFFF) | ((v1 & 0xFFFF) << 16);
+				temp |= static_cast<uint64>(v2) << 32;
+				put((v3 & 0x8000) ? GS_REG_XYZ3 : GS_REG_XYZ2, temp);
+			}
+			break;
+			case 0x06:
+				put(GS_REG_TEX0_1, d0);
+				break;
+			case 0x07:
+				put(GS_REG_TEX0_2, d0);
+				break;
+			case 0x08:
+				put(GS_REG_CLAMP_1, d0);
+				break;
+			case 0x09:
+				put(GS_REG_CLAMP_2, d0);
+				break;
+			case 0x0A:
+				//FOG
+				put(GS_REG_FOG, (d1 >> 36) << 56);
+				break;
+			case 0x0D:
+				put(GS_REG_XYZ3, d0);
+				break;
+			case 0x0E:
+				//A + D
+				{
+					uint8 reg = static_cast<uint8>(d1);
+					if(reg == GS_REG_SIGNAL)
+					{
+						//Check if there's already a signal pending
+						auto csr = gs->ReadPrivRegister(CGSHandler::GS_CSR);
+						if((m_signalState == SIGNAL_STATE_ENCOUNTERED) || ((csr & CGSHandler::CSR_SIGNAL_EVENT) != 0))
+						{
+							//If there is, we need to wait for previous signal to be cleared
+							m_signalState = SIGNAL_STATE_PENDING;
+							gs->CommitWrites(count);
+							m_loops = static_cast<uint16>(loops);
+							m_regsTemp = static_cast<uint8>(regsTemp);
+							m_qtemp = qtemp;
+							return address - start;
+						}
+						m_signalState = SIGNAL_STATE_ENCOUNTERED;
+					}
+					put(reg, d0);
+				}
+				break;
+			case 0x0F:
+				//NOP
+				break;
+			default:
+				assert(0);
+				break;
+			}
+
+			address += 0x10;
+			regsTemp--;
+		}
+
+		if(regsTemp == 0)
+		{
+			loops--;
+			regsTemp = regs;
+		}
+	}
+
+	gs->CommitWrites(count);
+	m_loops = static_cast<uint16>(loops);
+	m_regsTemp = static_cast<uint8>(regsTemp);
+	m_qtemp = qtemp;
+	return address - start;
+}
