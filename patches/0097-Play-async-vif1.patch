+bool CVpu::ProcessAsyncQueue()
+{
+	bool worked = false;
+	while(!m_stopWorker)
+	{
+		if(m_asyncStalled.load(std::memory_order_acquire)) return worked;
+		if(!m_asyncInProgress)
+		{
+			{
+				std::lock_guard<std::mutex> lock(m_asyncMutex);
+				if(m_asyncQueue.empty()) return worked;
+				m_asyncCurrent = std::move(m_asyncQueue.front());
+				m_asyncQueue.pop_front();
+			}
+			m_asyncInProgress = true;
+			m_vif->BeginAsyncPacket(m_asyncCurrent.data.data(), static_cast<uint32>(m_asyncCurrent.data.size()), m_asyncCurrent.tagIncluded);
 		}
-		while((m_vuState == VU_STATE_RUNNING) && !m_stopWorker)
+		worked = true;
+		if(!m_vif->ContinueAsyncPacket())
 		{
-			ExecuteInternal(5000);
+			//VIF1 stalls (interrupt, or a stopped program): the EE resumes it
+			g_asyncStats.stalls.fetch_add(1, std::memory_order_relaxed);
+			m_asyncStalled.store(true, std::memory_order_release);
+			return worked;
+		}
+		m_asyncInProgress = false;
+		m_asyncCurrent.data.clear();
+		{
+			//The buffer keeps its memory for the next packet
+			std::lock_guard<std::mutex> lock(m_asyncMutex);
+			if(m_asyncFree.size() < 64) m_asyncFree.push_back(std::move(m_asyncCurrent.data));
+		}
+		m_asyncQueued.fetch_sub(1, std::memory_order_acq_rel);
+	}
+	return worked;
+}
+
+void CVpu::QueueVifData(const uint8* data, uint32 size, bool tagIncluded)
+{
+	g_asyncStats.bytes.fetch_add(size, std::memory_order_relaxed);
+	{
+		std::lock_guard<std::mutex> lock(m_asyncMutex);
+		//Games send VIF1 data in small DMA chunks (Resident Evil 4: about 260 bytes): data
+		//without a tag goes after the last packet the worker has not taken yet. The stream
+		//reads it the same way as two transfers.
+		if(!tagIncluded && !m_asyncQueue.empty() && (m_asyncQueue.back().data.size() < 0x10000))
+		{
+			auto& last = m_asyncQueue.back().data;
+			last.insert(last.end(), data, data + size);
+			return;
+		}
+		ASYNC_PACKET packet;
+		if(!m_asyncFree.empty())
+		{
+			packet.data = std::move(m_asyncFree.back());
+			m_asyncFree.pop_back();
 		}
+		packet.data.assign(data, data + size);
+		packet.tagIncluded = tagIncluded;
+		m_asyncQueue.push_back(std::move(packet));
+	}
+	g_asyncStats.packets.fetch_add(1, std::memory_order_relaxed);
+	m_asyncQueued.fetch_add(1, std::memory_order_acq_rel);
+	WakeWorker();
+}
+
+void CVpu::QueueDirect(const uint8* data, uint32 size)
+{
+	PENDING_KICK kick;
+	kick.packet.assign(data, data + size);
+	kick.path = 2;
+	std::lock_guard<std::mutex> lock(m_kickMutex);
+	m_pendingKicks.push_back(std::move(kick));
+	m_hasPendingKicks = true;
+}
+
+void CVpu::QueuePath3Mask(bool masked)
+{
+	PENDING_KICK kick;
+	kick.mask = masked ? 1 : 0;
+	std::lock_guard<std::mutex> lock(m_kickMutex);
+	m_pendingKicks.push_back(std::move(kick));
+	m_hasPendingKicks = true;
+}
+
+void CVpu::WaitAsyncQuiet()
+{
+	if(IsAsyncQuiet()) return;
+	EmuProfile::CScope profileScope(EmuProfile::SECTION_VU1);
+	auto start = std::chrono::steady_clock::now();
+	for(uint32 spins = 0; !IsAsyncQuiet(); spins++)
+	{
+		if((spins & 63) == 63) std::this_thread::yield();
 	}
+	g_asyncStats.quietWaits.fetch_add(1, std::memory_order_relaxed);
+	g_asyncStats.quietWaitUs.fetch_add(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count(), std::memory_order_relaxed);
+}
+
+void CVpu::ResumeAsync()
+{
+	if(m_asyncStalled.exchange(false, std::memory_order_acq_rel)) WakeWorker();
