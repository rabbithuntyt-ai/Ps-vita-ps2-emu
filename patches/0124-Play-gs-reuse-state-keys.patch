+uint64 CGSHandler::HashShadowState() const
+{
+	//Every register a packet's result can depend on: all but the per-vertex ones and the
+	//event/transfer triggers
+	uint64 hash = 0xCBF29CE484222325ULL;
+	for(uint32 reg = 0; reg < 0x80; reg++)
+	{
+		switch(reg)
+		{
+		case GS_REG_RGBAQ: case GS_REG_ST: case GS_REG_UV: case GS_REG_XYZF2: case GS_REG_XYZ2:
+		case GS_REG_XYZF3: case GS_REG_XYZ3: case GS_REG_FOG: case GS_REG_HWREG: case GS_REG_TRXDIR:
+		case GS_REG_SIGNAL: case GS_REG_FINISH: case GS_REG_LABEL:
+			continue;
+		}
+		uint64 value = m_shadowReg[reg];
+		for(int b = 0; b < 8; b++)
+		{
+			hash ^= (value >> (b * 8)) & 0xFF;
+			hash *= 0x100000001B3ULL;
+		}
+	}
+	return hash;
+}
