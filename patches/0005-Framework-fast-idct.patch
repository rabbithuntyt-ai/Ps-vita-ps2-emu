+void CIEEE1180::Transform(const int16* pUV, int16* pXY)
+{
+	int block[64];
+	for(int i = 0; i < 64; i++)
+	{
+		block[i] = pUV[i];
+	}
+	for(int i = 0; i < 8; i++)
+	{
+		IdctRow(block + 8 * i);
+	}
+	for(int i = 0; i < 8; i++)
+	{
+		IdctCol(block + i, pXY + i);
 	}
