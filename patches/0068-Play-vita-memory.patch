@@ -197,14 +199,19 @@ bool CJitCache::Find(const KEY& key, ENTRY& entry)
 	if(!m_file) return false;
 	auto iterator = m_entries.find(key);
 	if(iterator == m_entries.end()) return false;
-	entry = iterator->second;
+	// Taken out: the block's code now lives in the JIT's memory (a second copy
+	// held here cost the Vita's heap ~10 MB per game). Its key stays known so
+	// that a recompile does not append it to the file again.
+	entry = std::move(iterator->second);
+	m_entries.erase(iterator);
+	m_known.insert(key);
 	return true;
 }
 
