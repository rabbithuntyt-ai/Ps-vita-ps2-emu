+
+void CPS2VM::IopWorkerProc()
+{
+	ParallelIop::t_iopThread = true;
+	EmuProfile::t_section = &EmuProfile::g_iopSection;
+	if(g_iopThreadInit) g_iopThreadInit();
+	auto& s = ParallelIop::g_state;
+	s.workerStage = 1;
+	std::unique_lock<std::mutex> lock(s.mutex);
+	while(true)
+	{
+		auto ready = [&]() {
+			if(s.quit) return true;
+			if(s.pauseIop.load()) return false;
+			int64 need = s.draining ? 1 : static_cast<int64>(IOP_BATCH_SLICES) * std::max(m_iopTickStep, 1);
+			return s.credit.load() >= need;
+		};
+		if(!ready())
+		{
+			s.iopParked = true;
+			s.NotifyAll();
+			s.workerStage = 2;
+			ParallelIop::WaitLogged(lock, "worker", ready, false);
+		}
+		s.workerStage = 3;
+		s.workerWakes++;
+		if(s.quit) break;
+		s.iopParked = false;
+		lock.unlock();
+		while(!s.pauseIop.load(std::memory_order_acquire))
+		{
+			int64 credit = s.credit.load(std::memory_order_acquire);
+			if(credit <= 0) break;
+			int step = static_cast<int>(std::min<int64>(credit, std::max(m_iopTickStep, 1)));
+			m_iopExecutionTicks += step;
+			s.workerStage = 4;
+			UpdateIop();
+			s.workerStage = 5;
+			s.credit.fetch_sub(step, std::memory_order_acq_rel);
+		}
+		lock.lock();
+	}
+	s.iopParked = true;
+	s.NotifyAll();
+}
+
+void CPS2VM::GrantIop(int ticks)
+{
+	auto& s = ParallelIop::g_state;
+	int64 credit = s.credit.fetch_add(ticks, std::memory_order_acq_rel) + ticks;
+	int64 step = std::max(m_iopTickStep, 1);
+	if((credit >= IOP_BATCH_SLICES * step) && s.iopParked.load(std::memory_order_acquire))
+	{
+		std::lock_guard<std::mutex> lock(s.mutex);
+		s.NotifyAll();
+	}
+	if(credit > IOP_MAX_LAG_SLICES * step) DrainIop();
+}
+
+void CPS2VM::DrainIop()
+{
+	auto& s = ParallelIop::g_state;
+	if(!s.active.load(std::memory_order_acquire)) return;
+	EmuProfile::CScope profileScope(EmuProfile::SECTION_IOP_WAIT);
+	std::unique_lock<std::mutex> lock(s.mutex);
+	s.draining = true;
+	s.eeParked = true;
+	s.NotifyAll();
+	ParallelIop::WaitLogged(lock, "DrainIop", [&]() { return s.iopParked.load() && (s.credit.load() <= 0) && !s.pauseEe.load(); });
+	s.draining = false;
+	s.eeParked = false;
+}
+
+void CPS2VM::StopIopWorker()
+{
+	auto& s = ParallelIop::g_state;
+	if(!m_iopWorker.joinable()) return;
+	DrainIop();
+	{
+		std::lock_guard<std::mutex> lock(s.mutex);
+		s.quit = true;
+		s.NotifyAll();
+	}
+	m_iopWorker.join();
+	s.active = false;
+}
