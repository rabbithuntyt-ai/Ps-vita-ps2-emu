diff --git a/Source/ParallelIop.h b/Source/ParallelIop.h
new file mode 100644
--- /dev/null
+++ b/Source/ParallelIop.h
@@ -0,0 +1,204 @@
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <thread>
+#ifdef __vita__
+#include <psp2/kernel/threadmgr.h>
+#endif
+#include "EmuProfile.h"
+
+//The IOP on its own thread (CPS2VM::g_parallelIop). The emulation thread runs the
+//EE and grants the IOP its ticks slice by slice (credit); the IOP thread runs them,
+//a few slices behind at most. They meet:
+//- at vblanks and VM calls (state saves...): the EE thread waits until the IOP has
+//  run all its credit (Drain);
+//- where one CPU's code touches the other's side (the SIF: DMA, registers, HLE
+//  modules): CCrossing makes the other CPU park first. The IOP parks between its
+//  slices, the EE at the top of the VM loop (between its slices).
+namespace ParallelIop
+{
+	struct STATE
+	{
+		std::mutex mutex;
+		//One per waiting thread (one shared by a timed and an untimed waiter lost
+		//wakeups on the Vita); every state change wakes both
+		std::condition_variable cvEe, cvIop;
+		void NotifyAll()
+		{
+#ifdef __vita__
+			//The IOP thread sleeps on a kernel semaphore (keeps the signal: no lost wakeups)
+			if(iopSema >= 0) sceKernelSignalSema(iopSema, 1);
+#endif
+			cvEe.notify_all();
+			cvIop.notify_all();
+		}
+#ifdef __vita__
+		SceUID iopSema = -1;
+#endif
+		std::atomic<bool> active{false};      //the IOP thread runs the IOP
+		std::atomic<int64_t> credit{0};       //IOP ticks granted, not run yet
+		std::atomic<bool> iopParked{true};    //IOP between slices (or waiting to cross)
+		std::atomic<bool> eeParked{false};    //EE thread between slices
+		std::atomic<bool> pauseIop{false};    //the EE thread crosses: IOP stays parked
+		std::atomic<bool> pauseEe{false};     //the IOP thread crosses: EE stays parked
+		bool draining = false;                //the EE thread waits for the credit to be run
+		bool quit = false;
+		std::atomic<uint32_t> eeCrossings{0}, iopCrossings{0};
+		std::atomic<int> workerStage{0}; //diagnostics: 1 started, 2 waiting, 3 woken, 4 in UpdateIop, 5 slice done
+		std::atomic<uint32_t> workerWakes{0};
+	};
+	inline STATE g_state;
+	inline thread_local bool t_iopThread = false;
+	inline thread_local int t_crossingDepth = 0;
+
+	//Diagnostics: a wait longer than 2 s writes the state (Vita: iopsync.txt)
+	inline void LogStall(const char* where)
+	{
+#ifdef __vita__
+		auto& s = g_state;
+		if(FILE* file = std::fopen("ux0:data/VitaPS2/iopsync.txt", "a"))
+		{
+			std::fprintf(file, "%s: credit %lld iopParked %d eeParked %d pauseIop %d pauseEe %d draining %d quit %d crossings ee %u iop %u stage %d wakes %u\n", where,
+			             static_cast<long long>(s.credit.load()), s.iopParked.load() ? 1 : 0, s.eeParked.load() ? 1 : 0, s.pauseIop.load() ? 1 : 0,
+			             s.pauseEe.load() ? 1 : 0, s.draining ? 1 : 0, s.quit ? 1 : 0, s.eeCrossings.load(), s.iopCrossings.load(), s.workerStage.load(), s.workerWakes.load());
+			std::fclose(file);
+		}
+#endif
+	}
+	//Polls: the condition is checked, the lock released for 50 us, again (condition
+	//variables lost wakeups on the Vita, even with timed waits). Logs every 2 s stuck.
+	template <typename Predicate>
+	inline void WaitLogged(std::unique_lock<std::mutex>& lock, const char* where, Predicate predicate, bool log = true)
+	{
+		auto start = std::chrono::steady_clock::now();
+		while(!predicate())
+		{
+			lock.unlock();
+			//The EE thread has its core to itself and is the critical path: it spins,
+			//without the lock (taking it in a tight loop kept the IOP thread from parking).
+			//The IOP thread shares its core: it sleeps.
+			if(!t_iopThread)
+			{
+				for(int spin = 0; (spin < 4096) && !predicate(); spin++)
+				{
+				}
+			}
+			else
+			{
+#ifdef __vita__
+				if(g_state.iopSema < 0) g_state.iopSema = sceKernelCreateSema("PS2 IOP wake", 0, 0, 1, nullptr);
+				SceUInt timeout = 1000;
+				sceKernelWaitSema(g_state.iopSema, 1, &timeout);
+#else
+				std::this_thread::sleep_for(std::chrono::microseconds(50));
+#endif
+			}
+			lock.lock();
+			if(log && (std::chrono::steady_clock::now() - start > std::chrono::seconds(2)))
+			{
+				LogStall(where);
+				start = std::chrono::steady_clock::now();
+			}
+		}
+	}
+
+	//EE thread: returns once the IOP is parked; it stays parked until ResumeIop
+	inline void PauseIop()
+	{
+		EmuProfile::CScope profileScope(EmuProfile::SECTION_IOP_WAIT);
+		auto& s = g_state;
+		std::unique_lock<std::mutex> lock(s.mutex);
+		s.pauseIop = true;
+		s.NotifyAll();
+		WaitLogged(lock, "PauseIop", [&]() { return s.iopParked.load(); });
+	}
+
+	inline void ResumeIop()
+	{
+		auto& s = g_state;
+		std::lock_guard<std::mutex> lock(s.mutex);
+		s.pauseIop = false;
+		s.NotifyAll();
+	}
+
+	//IOP thread: returns once the EE thread is parked; it stays parked until ResumeEe.
+	//Meanwhile the IOP counts as parked (an EE crossing may go first).
+	inline void PauseEe()
+	{
+		auto& s = g_state;
+		std::unique_lock<std::mutex> lock(s.mutex);
+		s.pauseEe = true;
+		s.iopParked = true;
+		s.NotifyAll();
+		WaitLogged(lock, "PauseEe", [&]() { return s.eeParked.load() && !s.pauseIop.load(); });
+		s.iopParked = false;
+	}
+
+	inline void ResumeEe()
+	{
+		auto& s = g_state;
+		std::lock_guard<std::mutex> lock(s.mutex);
+		s.pauseEe = false;
+		s.NotifyAll();
+	}
+
+	//EE thread, top of the VM loop: parks while the IOP crosses
+	inline void EeParkPoint()
+	{
+		auto& s = g_state;
+		if(!s.pauseEe.load(std::memory_order_acquire)) return;
+		std::unique_lock<std::mutex> lock(s.mutex);
+		s.eeParked = true;
+		s.NotifyAll();
+		WaitLogged(lock, "EeParkPoint", [&]() { return !s.pauseEe.load(); });
+		s.eeParked = false;
+	}
+
+	//Code touching the other CPU's side. Nested crossings on the same thread count once.
+	class CCrossing
+	{
+	public:
+		CCrossing()
+		{
+			if(!g_state.active.load(std::memory_order_acquire)) return;
+			if(t_crossingDepth++ != 0)
+			{
+				m_counted = true;
+				return;
+			}
+			m_counted = true;
+			m_paused = true;
+			if(t_iopThread)
+			{
+				g_state.iopCrossings.fetch_add(1, std::memory_order_relaxed);
+				PauseEe();
+			}
+			else
+			{
+				g_state.eeCrossings.fetch_add(1, std::memory_order_relaxed);
+				PauseIop();
+			}
+		}
+		~CCrossing()
+		{
+			if(!m_counted) return;
+			t_crossingDepth--;
+			if(!m_paused) return;
+			if(t_iopThread)
+				ResumeEe();
+			else
+				ResumeIop();
+		}
+		CCrossing(const CCrossing&) = delete;
+		CCrossing& operator=(const CCrossing&) = delete;
+
+	private:
+		bool m_counted = false;
+		bool m_paused = false;
+	};
+}
