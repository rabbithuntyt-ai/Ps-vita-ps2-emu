+CEeOverlayBlock::CEeOverlayBlock(CMIPS& context, uint32 begin, uint32 end, BLOCK_CATEGORY category, const EeOverlay::HOOK& hook)
+    : CEeBasicBlock(context, begin, end, category)
+    , m_hook(hook)
+{
+}
+
+void CEeOverlayBlock::CompileProlog(CMipsJitter* jitter)
+{
+	CEeBasicBlock::CompileProlog(jitter);
+	m_slowExitLabel = jitter->CreateLabel();
+
+	//cycles = overlay(context, id); quota -= cycles (0: not taken, the code below runs)
+	jitter->PushCtx();
+	jitter->PushCst(m_hook.id);
+	jitter->Call(reinterpret_cast<void*>(m_hook.function), 2, Jitter::CJitter::RETURN_VALUE_32);
+	jitter->PushTop();
+	jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+	jitter->Swap();
+	jitter->Sub();
+	jitter->PullRel(offsetof(CMIPS, m_State.cycleQuota));
+	jitter->PushCst(0);
+	jitter->BeginIf(Jitter::CONDITION_NE);
+	{
+		//Taken: return to the caller (jr ra)
+		jitter->PushRel(offsetof(CMIPS, m_State.nGPR[CMIPS::RA].nV[0]));
+		jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(0);
+		jitter->BeginIf(Jitter::CONDITION_GT);
+		{
+			jitter->JumpToDynamic(reinterpret_cast<void*>(&RegionExitTrampoline));
+		}
+		jitter->EndIf();
+		jitter->Goto(m_slowExitLabel);
+	}
+	jitter->EndIf();
+}
+
+void CEeOverlayBlock::CompileEpilog(CMipsJitter* jitter, bool loopsOnItself)
+{
+	CEeBasicBlock::CompileEpilog(jitter, loopsOnItself);
+
+	//Back to the executor with nPC set (the usual slow exit falls through here
+	//too: it has done the same already, so this changes nothing for it)
+	jitter->MarkLabel(m_slowExitLabel);
+	CompileQuotaPoisonFix(jitter);
+	jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+	jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+	jitter->PushCst(0);
+	jitter->Cmp(Jitter::CONDITION_LE);
+	jitter->Shl(7);
+	jitter->Or();
+	jitter->PullRel(offsetof(CMIPS, m_State.nHasException));
+}
