+//A block at a native overlay's entry (EeOverlay.h): the overlay is called first; when
+//it took the call the block leaves to ra, else the block's own code runs.
+class CEeOverlayBlock : public CEeBasicBlock
+{
+public:
+	CEeOverlayBlock(CMIPS&, uint32 begin, uint32 end, BLOCK_CATEGORY, const EeOverlay::HOOK&);
+
+protected:
+	void CompileProlog(CMipsJitter*) override;
+	void CompileEpilog(CMipsJitter*, bool) override;
+	bool CanUseLikelyExit() const override
+	{
+		return false;
+	}
+
+private:
+	EeOverlay::HOOK m_hook;
+	unsigned int m_slowExitLabel = 0;
+};
