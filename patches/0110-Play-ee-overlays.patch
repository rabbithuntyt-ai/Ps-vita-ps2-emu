+#pragma once
+
+#include "Types.h"
+
+class CMIPS;
+
+//Native overlays of game functions (frontend: src/common/EeOverlays). Two ways in:
+//- a hook where a block is compiled: the block at the function's entry first calls
+//  the overlay, which returns the EE cycles the function took (the block then leaves
+//  to ra, as the function's jr ra would) or 0 (the block's own code runs: the
+//  original function, for calls the overlay declines or checks);
+//- a syscall stub patched over the function's entry by the frontend
+//  (addiu v1, zero, SYSCALL; syscall; jr ra; nop), for code a hook can't see.
+namespace EeOverlay
+{
+	using Function = uint32 (*)(CMIPS*, uint32 id);
+
+	struct HOOK
+	{
+		Function function = nullptr;
+		uint32 id = 0;
+		uint32 codeSize = 0; //bytes of guest code it stands for (write protected with the block)
+	};
+
+	//Asked before a block is partitioned at 'address' (EE RAM, 0x100000 and up):
+	//true, with 'hook' set, when an overlay takes the function there over.
+	using Lookup = bool (*)(void* context, CMIPS&, uint32 address, HOOK&);
+	inline Lookup g_lookup = nullptr;
+	inline void* g_lookupContext = nullptr;
+
+	enum
+	{
+		SYSCALL = 0xA0E, //in CPS2OS's HLE range, unused by the movie HLE
+	};
+	using Handler = void (*)(void* context, CMIPS&);
+	inline Handler g_syscall = nullptr; //SYSCALL
+	inline void* g_syscallContext = nullptr;
+	inline Handler g_vblank = nullptr; //EE thread, each vblank start (stubs are patched in here)
+	inline void* g_vblankContext = nullptr;
+}
