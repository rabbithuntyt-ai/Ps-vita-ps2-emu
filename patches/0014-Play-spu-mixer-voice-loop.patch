+void CSpuBase::Render(int16* samples, unsigned int sampleCount)
+{
+	//Long requests are rendered in chunks (per voice buffers live on the stack)
+	constexpr unsigned int maxChunk = 256;
+	while(sampleCount > maxChunk)
+	{
+		RenderChunk(samples, maxChunk);
+		samples += maxChunk;
+		sampleCount -= maxChunk;
+	}
+	RenderChunk(samples, sampleCount);
+}
 
