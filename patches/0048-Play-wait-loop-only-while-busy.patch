diff --git a/Source/ee/Ee_SubSystem.cpp b/Source/ee/Ee_SubSystem.cpp
--- a/Source/ee/Ee_SubSystem.cpp
+++ b/Source/ee/Ee_SubSystem.cpp
@@ -537,15 +537,50 @@ uint32 CSubSystem::IOPortReadHandler(uint32 nAddress)
 		//Games also need to catch the interrupt flag before the interrupt is serviced,
 		//extra care is needed in NotifyVBlankStart not to break this
 
+		//A read that finds the unit done is not waiting: the IPU and DMA
+		//registers are also read once per command to collect a finished result
+		//(movie decoders: ~10 IPU commands per macroblock). Counting those
+		//would end the EE's slice on every command once the count saturates,
+		//capping movies at a few frames per second.
+		bool waiting = true;
+		switch(nAddress)
+		{
+		case CIPU::IPU_CMD:
+		case CIPU::IPU_CMD + 4:
+		case CIPU::IPU_CTRL:
+			waiting = m_ipu.WillExecuteCommand();
+			break;
+		case CDMAC::D0_CHCR:
+		case CDMAC::D1_CHCR:
+		case CDMAC::D2_CHCR:
+		case CDMAC::D3_CHCR:
+		case CDMAC::D4_CHCR:
+		case CDMAC::D5_CHCR:
+		case CDMAC::D6_CHCR:
+		case CDMAC::D8_CHCR:
+		case CDMAC::D9_CHCR:
+			waiting = (nReturn & 0x100) != 0; //STR: transfer still running
+			break;
+		default:
+			break;
+		}
+
 		//Only consider user code (non-kernel code) for idle loop detection
 		if(m_EE.m_State.nPC < PS2::EE_RAM_SIZE)
 		{
 			static const uint32 checkCountMax = 5000;
 			uint32& checkCount = m_statusRegisterCheckers[m_EE.m_State.nPC];
-			checkCount = std::min<uint32>(checkCount + 1, checkCountMax);
-			if(checkCount == checkCountMax)
+			if(!waiting)
+			{
+				checkCount = 0;
+			}
+			else
 			{
-				m_EE.m_State.nHasException = MIPS_EXCEPTION_IDLE;
+				checkCount = std::min<uint32>(checkCount + 1, checkCountMax);
+				if(checkCount == checkCountMax)
+				{
+					m_EE.m_State.nHasException = MIPS_EXCEPTION_IDLE;
+				}
 			}
 		}
 	}
