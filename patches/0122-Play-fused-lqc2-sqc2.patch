@@ -114,6 +124,15 @@
 //3E
 void CCOP_VU::SQC2()
 {
+	if(m_codeGen->SupportsGuestMemoryOps() && (m_pCtx->m_pageLookup != nullptr))
+	{
+		//As SQ
+		ComputeMemAccessAddrNoXlat();
+		m_codeGen->MD_PushRel(offsetof(CMIPS, m_State.nCOP2[m_nFT]));
+		m_codeGen->GuestStore(offsetof(CMIPS, m_pageLookup), 0x10, reinterpret_cast<void*>(&MemoryUtils_SetQuadProxyPtr));
