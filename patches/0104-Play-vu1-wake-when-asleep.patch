diff --git a/Source/ee/Vpu.cpp b/Source/ee/Vpu.cpp
--- a/Source/ee/Vpu.cpp
+++ b/Source/ee/Vpu.cpp
@@ -153,6 +153,11 @@
 void CVpu::WakeWorker()
 {
 #ifdef __vita__
+	//A busy worker finds the work itself: signal only one that is going to sleep (a signal is a
+	//system call, and Resident Evil 4 queues VIF1 data about 7,000 times a game frame). The
+	//worker marks itself, then checks for work, then sleeps; this side made the work visible
+	//before it reads the mark, so one of the two sees the other (both sequentially consistent).
+	if(!m_workerSleeping.load(std::memory_order_seq_cst)) return;
 	if(m_workerSema >= 0) sceKernelSignalSema(m_workerSema, 1);
 #else
 	{
@@ -207,8 +212,13 @@
 			if(found) continue;
 		}
 		//Timed waits: a lost or early wakeup costs at most a millisecond.
-		SceUInt timeout = 1000;
-		sceKernelWaitSema(m_workerSema, 1, &timeout);
+		m_workerSleeping.store(true, std::memory_order_seq_cst);
+		if(!hasWork())
+		{
+			SceUInt timeout = 1000;
+			sceKernelWaitSema(m_workerSema, 1, &timeout);
+		}
+		m_workerSleeping.store(false, std::memory_order_seq_cst);
 #else
 		std::unique_lock<std::mutex> lock(m_workerMutex);
 		m_workerCondition.wait_for(lock, std::chrono::milliseconds(1), hasWork);
