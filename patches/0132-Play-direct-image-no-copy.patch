+		storage->resize(size + 0x10, 0);
+		kick.shared = std::move(storage);
+	}
+	else
+		kick.packet.assign(data, data + size);
 	kick.path = 2;
 	g_asyncStats.directs.fetch_add(1, std::memory_order_relaxed);
 	g_asyncStats.directBytes.fetch_add(size, std::memory_order_relaxed);
@@ -529,11 +541,14 @@
 			//VIF1 DIRECT data (asynchronous VIF1)
