 #include "../EmuProfile.h"
@@ -391,7 +392,18 @@
 void CVpu::QueueDirect(const uint8* data, uint32 size)
 {
 	PENDING_KICK kick;
-	kick.packet.assign(data, data + size);
+	if(CGSHandler::g_imageNoCopy)
+	{
+		//image_no_copy: shared storage the GS thread can keep a reference to (image data in it is not
+		//copied again); 0x10 zero bytes after it, as FeedImageData's own copies have
+		auto storage = std::make_shared<std::vector<uint8>>();
+		storage->reserve(size + 0x10);
