diff --git a/Source/gs/GSHandler.h b/Source/gs/GSHandler.h
--- a/Source/gs/GSHandler.h
+++ b/Source/gs/GSHandler.h
@@ -856,6 +856,13 @@
 	//it has none for [data, data + length); else it holds length + 0x10 readable bytes
 	//and stays alive as long as the returned pointer.
 	static inline std::function<std::shared_ptr<const uint8>(const void* data, uint32 length)> g_imageDataSource;
+	//image_no_copy (off until measured on the Vita): while the EE thread relays a VIF1 DIRECT packet
+	//(CVpu::FlushPendingXgKicks), this holds the packet's storage (with 0x10 bytes of padding after it);
+	//image data inside it goes to the GS thread as a reference to it instead of a copy (Resident Evil
+	//4: ~1.5 MB of textures a game frame, about 200 allocations)
+	static inline const std::shared_ptr<std::vector<uint8>>* g_imageDataOwner = nullptr;
+	static inline bool g_imageNoCopy = false;
+	static inline uint64 g_imageNoCopyBytes = 0, g_imageCopyBytes = 0;
 	//GS thread section times (microseconds, inclusive: draws inside count too) and counts, when
 	//g_sectionClock is set (VitaPS2 perf.csv: gs_feed_ms, gs_regs_ms, gs_reg_writes...)
 	static inline uint64 (*g_sectionClock)() = nullptr;
diff --git a/Source/gs/GSHandler.cpp b/Source/gs/GSHandler.cpp
--- a/Source/gs/GSHandler.cpp
+++ b/Source/gs/GSHandler.cpp
@@ -667,6 +667,28 @@
 		}
 	}
 
+	if(g_imageNoCopy && g_imageDataOwner && *g_imageDataOwner)
+	{
+		//image_no_copy: inside the packet being relayed (its storage keeps 0x10 bytes after the
+		//data, as the copy below does)
+		const auto& owner = *g_imageDataOwner;
+		const uint8* begin = owner->data();
+		const uint8* bytes = reinterpret_cast<const uint8*>(data);
+		if((bytes >= begin) && (bytes + length + 0x10 <= begin + owner->size()))
+		{
+			std::shared_ptr<const uint8> view(owner, bytes);
+			g_imageNoCopyBytes += length;
+			SendGSCall(
+			    [this, view, length]() {
+				    uint64 feedStart = g_sectionClock ? g_sectionClock() : 0;
+				    FeedImageDataImpl(view.get(), length);
+				    if(g_sectionClock) { g_feedUs += g_sectionClock() - feedStart; g_feedCalls++; g_feedBytes += length; }
+			    });
+			return;
+		}
+	}
+	g_imageCopyBytes += length;
+
 	//Allocate 0x10 more bytes to allow transfer handlers
 	//to read beyond the actual length of the buffer (ie.: PSMCT24)
 
