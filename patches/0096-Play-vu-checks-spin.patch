+bool VUShared::g_flagTracking = true;
+
+namespace
+{
+	struct FLAG_QUEUE_ENTRY
+	{
+		uint32 readyTime; //relativePipeTime + latency
+		uint32 epoch;     //pipeTime changes emitted before the entry was queued
+	};
+
+	struct FLAG_TRACK
+	{
+		bool active = false;
+		uint32 epoch = 0;
+		std::vector<FLAG_QUEUE_ENTRY> queues[3];
+	};
+
+	thread_local FLAG_TRACK t_flagTrack;
+
+	int GetFlagPipeIndex(const VUShared::FLAG_PIPEINFO& pipeInfo)
+	{
+		if(pipeInfo.valueArray == VUShared::g_pipeInfoMac.valueArray) return 0;
+		if(pipeInfo.valueArray == VUShared::g_pipeInfoSticky.valueArray) return 1;
+		if(pipeInfo.valueArray == VUShared::g_pipeInfoClip.valueArray) return 2;
+		return -1;
+	}
+}
+
+void VUShared::BeginFlagTracking()
+{
+	t_flagTrack.active = g_flagTracking;
+	t_flagTrack.epoch = 0;
+	for(auto& queue : t_flagTrack.queues) queue.clear();
+}
+
+void VUShared::EndFlagTracking()
+{
+	t_flagTrack.active = false;
+}
+
+void VUShared::NotePipeTimeChange()
+{
+	t_flagTrack.epoch++;
+}
+
 void VUShared::CheckFlagPipeline(const FLAG_PIPEINFO& pipeInfo, CMipsJitter* codeGen, uint32 relativePipeTime)
 {
+	//An entry queued by this block that is ready (at the same pipeTime as the check or an
+	//earlier one: pipeTime only grows) is the value, when every newer entry of this block is
+	//not ready: queued at the check's pipeTime (no change emitted since) and not ready at
+	//compile time. Slot times grow in queue order, so no older slot can be the newest ready.
+	int pipeIndex = GetFlagPipeIndex(pipeInfo);
+	if(t_flagTrack.active && (pipeIndex != -1))
+	{
+		const auto& queue = t_flagTrack.queues[pipeIndex];
+		int ready = -1;
+		bool newerSafe = true;
+		for(int j = static_cast<int>(queue.size()) - 1; j >= 0; j--)
+		{
+			if(queue[j].readyTime <= relativePipeTime)
+			{
+				ready = j;
+				break;
+			}
+			if(queue[j].epoch != t_flagTrack.epoch)
+			{
+				newerSafe = false;
+				break;
+			}
+		}
+		uint32 distance = static_cast<uint32>(queue.size()) - ready;
+		if(newerSafe && (ready != -1) && (distance <= FLAG_PIPELINE_SLOTS))
+		{
+			codeGen->PushRelAddrRef(pipeInfo.valueArray);
+
+			codeGen->PushRel(pipeInfo.index);
+			codeGen->PushCst(distance);
+			codeGen->Sub();
+			codeGen->PushCst(FLAG_PIPELINE_SLOTS - 1);
+			codeGen->And();
+
+			codeGen->LoadFromRefIdx();
+			codeGen->PullRel(pipeInfo.value);
+			return;
+		}
+	}
+
+
 	//This will check every slot in the pipeline and update
 	//the flag register every time (pipeTimes[i] <= (pipeTime + relativePipeTime))
 	for(unsigned int i = 0; i < FLAG_PIPELINE_SLOTS; i++)
