+void CVpu::PublishHeld()
+{
+	m_asyncHeld = false;
+	g_asyncStats.packets.fetch_add(1, std::memory_order_relaxed);
+	m_asyncQueued.fetch_add(1, std::memory_order_acq_rel);
+	m_asyncWrite.store(m_asyncHeldEnd, std::memory_order_release);
+	EmuProfile::CScope wakeScope(EmuProfile::SECTION_VIF_WAKE);
+	WakeWorker();
+}
 
