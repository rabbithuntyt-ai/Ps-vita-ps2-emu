+
 	unsigned int regCount = (m_regSize == MIPS_REGSIZE_64) ? 2 : 1;
 	for(unsigned int i = 0; i < regCount; i++)
 	{
@@ -1198,6 +1378,17 @@ void CMA_MIPSIV::DADD()
 //2D
 void CMA_MIPSIV::DADDU()
 {
+	//Register move of a sign-extended value
+	if((m_regSize == MIPS_REGSIZE_64) && (m_nRD != 0) &&
+	   (((m_nRT == 0) && IsSignExt32(m_nRS)) || ((m_nRS == 0) && IsSignExt32(m_nRT))))
+	{
+		m_codeGen->PushRel(offsetof(CMIPS, m_State.nGPR[(m_nRT == 0) ? m_nRS : m_nRT].nV[0]));
