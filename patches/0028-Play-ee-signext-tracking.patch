+//rd = rs op rt on the lower halves; the upper half is the sign of the result
+//(both sources are sign-extended 32-bit values)
+void CMA_MIPSIV::Template_Logic32SignExt(const TemplateOperationFunctionType& function)
+{
+	m_codeGen->PushRel(offsetof(CMIPS, m_State.nGPR[m_nRS].nV[0]));
+	m_codeGen->PushRel(offsetof(CMIPS, m_State.nGPR[m_nRT].nV[0]));
+	function();
+	m_codeGen->PushTop();
+	m_codeGen->SignExt();
+	m_codeGen->PullRel(offsetof(CMIPS, m_State.nGPR[m_nRD].nV[1]));
+	m_codeGen->PullRel(offsetof(CMIPS, m_State.nGPR[m_nRD].nV[0]));
+}
