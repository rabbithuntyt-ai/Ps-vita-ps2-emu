 	for(unsigned int i = 0; i < regCount; i++)
@@ -1147,6 +1315,12 @@ void CMA_MIPSIV::XOR()
 {
 	if(m_nRD == 0) return;
 
+	if((m_regSize == MIPS_REGSIZE_64) && IsSignExt32(m_nRS) && IsSignExt32(m_nRT))
+	{
+		Template_Logic32SignExt([this]() { m_codeGen->Xor(); });
+		return;
+	}
+
 	unsigned int regCount = (m_regSize == MIPS_REGSIZE_64) ? 2 : 1;
 	for(unsigned int i = 0; i < regCount; i++)
 	{
@@ -1164,6 +1338,12 @@ void CMA_MIPSIV::NOR()
 {
 	if(m_nRD == 0) return;
 
+	if((m_regSize == MIPS_REGSIZE_64) && IsSignExt32(m_nRS) && IsSignExt32(m_nRT))
