+//Knowledge after the current instruction (computed before it is compiled, since
+//destination and sources can be the same register)
+uint32 CMA_MIPSIV::ComputeSignExtKnowledge() const
+{
+	uint32 known = m_signExtKnown;
+	auto set = [&](unsigned int reg, bool isKnown) {
+		if(reg == 0) return;
+		if(isKnown)
+			known |= (1 << reg);
+		else
+			known &= ~(1 << reg);
+	};
+	uint32 op = m_nOpcode >> 26;
+	switch(op)
+	{
+	case 0x00: //SPECIAL
+		switch(m_nOpcode & 0x3F)
+		{
+		case 0x00: //SLL
+		case 0x02: //SRL
+		case 0x03: //SRA
+		case 0x04: //SLLV
+		case 0x06: //SRLV
+		case 0x07: //SRAV
+		case 0x20: //ADD
+		case 0x21: //ADDU
+		case 0x22: //SUB
+		case 0x23: //SUBU
+		case 0x2A: //SLT
+		case 0x2B: //SLTU
+			set(m_nRD, true);
+			break;
+		case 0x0A: //MOVZ
+		case 0x0B: //MOVN
+			set(m_nRD, IsSignExt32(m_nRD) && IsSignExt32(m_nRS));
+			break;
+		case 0x24: //AND
+		case 0x25: //OR
+		case 0x26: //XOR
+		case 0x27: //NOR
+			set(m_nRD, IsSignExt32(m_nRS) && IsSignExt32(m_nRT));
+			break;
+		case 0x2D: //DADDU
+			set(m_nRD, ((m_nRT == 0) && IsSignExt32(m_nRS)) || ((m_nRS == 0) && IsSignExt32(m_nRT)));
+			break;
+		case 0x08: //JR
+		case 0x0F: //SYNC
+		case 0x11: //MTHI
+		case 0x13: //MTLO
+			break;
+		case 0x0C: //SYSCALL
+		case 0x0D: //BREAK
+			known = 0;
+			break;
+		default:
+			set(m_nRD, false);
+			break;
+		}
+		break;
+	case 0x01: //REGIMM
+		if((m_nRT & 0x1C) == 0x10) set(31, false); //Branch and link
+		else if(m_nRT >= 0x18) known = 0;
+		break;
+	case 0x02: //J
+	case 0x04: //BEQ
+	case 0x05: //BNE
+	case 0x06: //BLEZ
+	case 0x07: //BGTZ
+	case 0x14: //BEQL
+	case 0x15: //BNEL
+	case 0x16: //BLEZL
+	case 0x17: //BGTZL
+	case 0x1F: //SQ
+	case 0x28: //SB
+	case 0x29: //SH
+	case 0x2A: //SWL
+	case 0x2B: //SW
+	case 0x2C: //SDL
+	case 0x2D: //SDR
+	case 0x2E: //SWR
+	case 0x2F: //CACHE
+	case 0x31: //LWC1
+	case 0x33: //PREF
+	case 0x36: //LQC2
+	case 0x39: //SWC1
+	case 0x3E: //SQC2
+	case 0x3F: //SD
+		break;
+	case 0x03: //JAL
+		set(31, false);
+		break;
+	case 0x08: //ADDI
+	case 0x09: //ADDIU
+	case 0x0A: //SLTI
+	case 0x0B: //SLTIU
+	case 0x0C: //ANDI
+	case 0x0F: //LUI
+	case 0x20: //LB
+	case 0x21: //LH
+	case 0x22: //LWL
+	case 0x23: //LW
+	case 0x24: //LBU
+	case 0x25: //LHU
+	case 0x26: //LWR
+		set(m_nRT, true);
+		break;
+	case 0x0D: //ORI
+	case 0x0E: //XORI
+		set(m_nRT, IsSignExt32(m_nRS));
+		break;
+	case 0x10: //COP0
+	case 0x11: //COP1
+	case 0x12: //COP2
+	case 0x18: //DADDI
+	case 0x19: //DADDIU
+	case 0x1A: //LDL
+	case 0x1B: //LDR
+	case 0x1E: //LQ
+	case 0x27: //LWU
+	case 0x37: //LD
+		set(m_nRT, false);
+		break;
+	default:
+		known = 0;
+		break;
+	}
+	return known;
+}
