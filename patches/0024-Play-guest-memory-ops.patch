+void MemoryUtils_GetDoubleProxyPtr(CMIPS* context, uint32 vAddress, void* value)
+{
+	uint64 result = MemoryUtils_GetDoubleProxy(context, vAddress);
+	memcpy(value, &result, sizeof(result));
+}
+
+void MemoryUtils_GetQuadProxyPtr(CMIPS* context, uint32 vAddress, void* value)
+{
+	uint128 result = MemoryUtils_GetQuadProxy(context, vAddress);
+	memcpy(value, &result, sizeof(result));
+}
+
+void MemoryUtils_SetDoubleProxyPtr(CMIPS* context, uint32 vAddress, const void* value)
+{
+	uint64 data = 0;
+	memcpy(&data, value, sizeof(data));
+	MemoryUtils_SetDoubleProxy(context, data, vAddress);
+}
+
+void MemoryUtils_SetQuadProxyPtr(CMIPS* context, uint32 vAddress, const void* value)
+{
+	uint128 data;
+	memcpy(&data, value, sizeof(data));
+	MemoryUtils_SetQuadProxy(context, data, vAddress);
+}
