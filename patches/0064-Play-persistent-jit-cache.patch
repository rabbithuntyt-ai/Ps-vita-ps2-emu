+bool CBasicBlock::ExportToJitCache(CJitCache::ENTRY& entry) const
+{
+#if defined(__arm__) && !defined(__aarch64__) && !defined(AOT_ENABLED)
+	auto& cache = CJitCache::GetInstance();
+	if(m_function.IsEmpty() || (m_function.GetSize() == 0)) return false;
+	auto code = static_cast<const uint8*>(m_function.GetCode());
+	size_t size = m_function.GetSize();
+	entry.code.assign(code, code + size);
+	entry.relocs.clear();
+	for(const auto& ref : m_externalRefs)
+	{
+		CJitCache::RELOC reloc;
+		reloc.offset = ref.offset;
+		if(ref.offset + 8 > size) return false;
+		// Check the code holds what was reported: anything else is a pointer
+		// the cache doesn't know how to rebuild.
+		if(ref.type == Jitter::CCodeGen::SYMBOL_REF_TYPE::ARMV7_LOAD_HALF)
+		{
+			if(CJitCache::ReadMovwMovt(code, ref.offset) != ref.symbol) return false;
+			reloc.type = CJitCache::RELOC_MOVW_MOVT;
+		}
+		else if(ref.type == Jitter::CCodeGen::SYMBOL_REF_TYPE::NATIVE_POINTER)
+		{
+			uint32 word = 0;
+			memcpy(&word, code + ref.offset, 4);
+			if(word == ref.symbol) reloc.type = CJitCache::RELOC_WORD;
+			else if(word == Jitter::CCodeGen_AArch32::GetChainedThunk(ref.symbol)) reloc.type = CJitCache::RELOC_THUNK;
+			else return false;
+		}
+		else
+		{
+			return false;
+		}
+		if(!cache.Classify(ref.symbol, reloc.range, reloc.rangeOffset)) return false;
+		entry.relocs.push_back(reloc);
+	}
+	entry.linkEntryOffset = m_linkEntryOffset;
+	entry.trampolineOffset[0] = m_linkBlockTrampolineOffset[LINK_SLOT_NEXT];
+	entry.trampolineOffset[1] = m_linkBlockTrampolineOffset[LINK_SLOT_BRANCH];
+	return true;
+#else
+	(void)entry;
+	return false;
+#endif
+}
+
+bool CBasicBlock::ImportFromJitCache(const CJitCache::ENTRY& entry)
+{
+#if defined(__arm__) && !defined(__aarch64__) && !defined(AOT_ENABLED)
+	auto& cache = CJitCache::GetInstance();
+	if(entry.code.empty()) return false;
+	std::vector<uint8> code = entry.code;
+	for(const auto& reloc : entry.relocs)
+	{
+		uintptr_t value = cache.Resolve(reloc.range, reloc.rangeOffset);
+		if(reloc.type == CJitCache::RELOC_THUNK) value = Jitter::CCodeGen_AArch32::GetChainedThunk(value);
+		CJitCache::ApplyReloc(code.data(), reloc.type, reloc.offset, value);
+	}
+	m_function = CMemoryFunction(code.data(), code.size());
+	m_linkEntryOffset = entry.linkEntryOffset;
+	m_linkBlockTrampolineOffset[LINK_SLOT_NEXT] = entry.trampolineOffset[0];
+	m_linkBlockTrampolineOffset[LINK_SLOT_BRANCH] = entry.trampolineOffset[1];
+	// As at the end of Compile(): what an unlinked slot points to.
+	for(uint32 i = 0; i < LINK_SLOT_MAX; i++)
+	{
+		m_linkSlotDefault[i] = 0;
+		if(m_linkBlockTrampolineOffset[i] == INVALID_LINK_SLOT) continue;
+		if(m_linkBlockTrampolineOffset[i] + 4 > code.size()) return false;
+		auto installed = reinterpret_cast<const uint8*>(m_function.GetCode());
+		m_linkSlotDefault[i] = *reinterpret_cast<const uintptr_t*>(installed + m_linkBlockTrampolineOffset[i]);
+	}
+	return true;
+#else
+	(void)entry;
+	return false;
+#endif
+}
