+void CCOP_VU::BeginMacroBlock(uint32 begin, uint32 end)
+{
+	//Not the branch and its delay slot (a likely branch may skip the slot)
+	t_macroEnd = (g_macroFlagRuns && (end >= begin + 8)) ? (end - 4) : 0;
+	t_stickyDeferred = false;
+}
+
+void CCOP_VU::EndMacroBlock()
+{
+	assert(!t_stickyDeferred);
+	t_macroEnd = 0;
+	t_stickyDeferred = false;
+}
+
+CCOP_VU::MACRO_KIND CCOP_VU::ClassifyMacro(uint32 opcode)
+{
+	uint32 major = opcode >> 26;
+	if(major == 0x36) return MACRO_NEUTRAL;  //LQC2
+	if(major == 0x3E) return MACRO_BOUNDARY; //SQC2: a store (the VIF0 FIFO can start VU0)
+	if(major == 0x12)
+	{
+		uint32 rs = (opcode >> 21) & 0x1F;
+		if((rs & 0x10) == 0)
+		{
+			//QMFC2, QMTC2 without interlock move data; CFC2, CTC2, BC2 and the interlocked forms may read flags
+			if(((rs == 0x01) || (rs == 0x05)) && ((opcode & 1) == 0)) return MACRO_NEUTRAL;
+			return MACRO_BOUNDARY;
+		}
+		uint32 funct = opcode & 0x3F;
+		if(funct < 0x3C)
+		{
+			if(funct <= 0x0F) return MACRO_FMAC;                       //ADD/SUB/MADD/MSUB bc
+			if(funct <= 0x17) return MACRO_NEUTRAL;                    //MAX/MINI bc
+			if(funct <= 0x1C) return MACRO_FMAC;                       //MULbc, MULq
+			if(funct == 0x1E) return MACRO_FMAC;                       //MULi
+			if((funct == 0x1D) || (funct == 0x1F)) return MACRO_NEUTRAL; //MAXi, MINIi
+			if(funct <= 0x2A) return MACRO_FMAC;                       //q/i forms, ADD, MADD, MUL
+			if((funct == 0x2C) || (funct == 0x2D) || (funct == 0x2E)) return MACRO_FMAC; //SUB, MSUB, OPMSUB
+			if((funct == 0x2B) || (funct == 0x2F)) return MACRO_NEUTRAL; //MAX, MINI
+			if((funct >= 0x30) && (funct <= 0x35)) return MACRO_NEUTRAL; //IADD, ISUB, IADDI, IAND, IOR
+			return MACRO_BOUNDARY;                                     //VCALLMS, VCALLMSR, others
+		}
+		uint32 funct2 = (((opcode >> 6) & 0x1F) << 2) | (opcode & 3);
+		if(funct2 <= 0x0F) return MACRO_FMAC;                          //ADDA/SUBA/MADDA/MSUBA bc
+		if(funct2 <= 0x17) return MACRO_NEUTRAL;                       //ITOF, FTOI
+		if(funct2 <= 0x1C) return MACRO_FMAC;                          //MULAbc, MULAq
+		if(funct2 == 0x1E) return MACRO_FMAC;                          //MULAi
+		if((funct2 == 0x1D) || (funct2 == 0x1F)) return MACRO_NEUTRAL; //ABS, CLIP (clip flags only)
+		if(funct2 <= 0x2A) return MACRO_FMAC;                          //q/i forms, ADDA, MADDA, MULA
+		if((funct2 == 0x2C) || (funct2 == 0x2D) || (funct2 == 0x2E)) return MACRO_FMAC; //SUBA, MSUBA, OPMULA
+		if((funct2 == 0x2B) || (funct2 == 0x2F)) return MACRO_NEUTRAL; //NOP
+		if((funct2 == 0x30) || (funct2 == 0x31)) return MACRO_NEUTRAL; //MOVE, MR32
+		if((funct2 >= 0x34) && (funct2 <= 0x37)) return MACRO_NEUTRAL; //LQI, SQI, LQD, SQD (VU0 memory)
+		if((funct2 >= 0x3C) && (funct2 <= 0x43)) return MACRO_NEUTRAL; //MTIR, MFIR, ILWR, ISWR, R*
+		return MACRO_BOUNDARY;                                         //DIV, SQRT, RSQRT, WAITQ, others
+	}
+	//EE instructions: stores (a VIF0 or DMA register can start VU0), syscall/break, COP0 end runs
+	if((major >= 0x28) && (major <= 0x2F)) return MACRO_BOUNDARY; //SB..SWR, SDL/SDR
+	if((major == 0x39) || (major == 0x3F) || (major == 0x1F)) return MACRO_BOUNDARY; //SWC1, SD, SQ
+	if(major == 0x10) return MACRO_BOUNDARY;                    //COP0
+	if((major == 0x00) && (((opcode & 0x3F) == 0x0C) || ((opcode & 0x3F) == 0x0D))) return MACRO_BOUNDARY; //SYSCALL, BREAK
+	return MACRO_NEUTRAL;
+}
+
+void CCOP_VU::EmitStickyFlush(CMipsJitter* codeGen)
+{
+	VUShared::FlushDeferredSticky(codeGen, 0);
+	codeGen->PushCst(0);
+	codeGen->PullRel(offsetof(CMIPS, m_vuStickyAccumulator));
+	if(codeGen->SupportsMdSignZeroAccumulate())
+	{
+		codeGen->MD_PushCstExpandW(0U);
+		codeGen->MD_PullRel(offsetof(CMIPS, m_vuStickyAccumulator128));
+	}
+	t_stickyDeferred = false;
+}
