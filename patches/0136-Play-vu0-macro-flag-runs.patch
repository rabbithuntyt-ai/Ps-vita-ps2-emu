@@ -10,6 +10,19 @@
 	CCOP_VU(MIPS_REGSIZE);
 
 	void CompileInstruction(uint32, CMipsJitter*, CMIPS*, uint32) override;
+
+	//vu0_macro_flags: in a run of VU0 macro arithmetic instructions (FMAC: they set the MAC and
+	//sticky flags) with nothing between them that can read the flags, all but the last skip the
+	//MAC flag update and accumulate their sticky bits in a vector register; the last one flushes
+	//them and updates both as before. Macro mode never moves pipeTime, so every queued flag value
+	//is visible at once: at every point that can read the flags (CFC2, CTC2, VCALLMS, BC2, DIV and
+	//the other non-FMAC COP2 instructions that touch them, stores, syscalls, COP0, the block's
+	//branch and delay slot) the MAC flag and the sticky flags are the ones the full updates give.
+	static inline bool g_macroFlagRuns = true; //on since 27 Nov 2026: Vita EE 91.7 to 87.0 ms a game frame (RE4), pictures right
+	static inline uint64 g_macroFlagsSkipped = 0; //FMAC instructions compiled without their MAC update (whole run)
+	//The block being compiled (CBasicBlock::CompileRange): runs only look at [begin, end)
+	static void BeginMacroBlock(uint32 begin, uint32 end);
+	static void EndMacroBlock();
 	void GetInstruction(uint32, char*) override;
 	void GetArguments(uint32, uint32, char*) override;
 	uint32 GetEffectiveAddress(uint32, uint32) override;
@@ -18,6 +31,16 @@
 protected:
 	typedef void (CCOP_VU::*InstructionFuncConstant)();
 
+	enum MACRO_KIND
+	{
+		MACRO_NEUTRAL,  //touches neither the MAC nor the sticky flags
+		MACRO_FMAC,     //sets both (all of MAC)
+		MACRO_BOUNDARY, //may read them, or leaves the block
+	};
+	static MACRO_KIND ClassifyMacro(uint32 opcode);
+	static void EmitStickyFlush(CMipsJitter*);
+	uint32 m_macroHints = 0;
+
 	void SetupReflectionTables();
 
 	static void ReflMnemI(MIPSReflection::INSTRUCTION*, CMIPS*, uint32, char*, unsigned int);
