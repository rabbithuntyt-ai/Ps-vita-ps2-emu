+	//Profiling (g_syscallTiming): time spent here by kernel call number
+	struct SYSCALL_TIMER
+	{
+		uint32 slot = 148;
+		std::chrono::steady_clock::time_point start;
+		bool active = g_syscallTiming;
+		SYSCALL_TIMER()
+		{
+			if(active) start = std::chrono::steady_clock::now();
+		}
+		~SYSCALL_TIMER()
+		{
+			if(!active) return;
+			g_syscallTimeUs[slot] += std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count();
+			g_syscallTimedCalls[slot]++;
+		}
+	} timer;
+	{
+		uint32 number = (func & 0x80000000) ? (0 - func) : func;
+		if(func == SYSCALL_CUSTOM_RESCHEDULE) timer.slot = 128;
+		else if(func == SYSCALL_CUSTOM_EXITINTERRUPT) timer.slot = 129;
+		else if((func >= Ee::CLibMc2::SYSCALL_RANGE_START) && (func < Ee::CLibMc2::SYSCALL_RANGE_END)) timer.slot = 130;
+		else if(func == SYSCALL_DISPATCH_UNLOCK) timer.slot = 131;
+		else if((func >= HLE_SYSCALL_START) && (func < HLE_SYSCALL_END)) timer.slot = 132 + (func - HLE_SYSCALL_START);
+		else if(number < 128) timer.slot = number;
+	}
