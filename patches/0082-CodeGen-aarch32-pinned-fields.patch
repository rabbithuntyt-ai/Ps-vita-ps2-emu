+//Pinned context fields (SetPinnedFields): the last two allocatable registers
+static int32 g_pinnedRwField = -1;      //in r9 (g_registers[6])
+static int32 g_pinnedPointerField = -1; //in r10 (g_registers[5])
+static constexpr auto g_pinnedRwRegister = CAArch32Assembler::r9;
+static constexpr auto g_pinnedPointerRegister = CAArch32Assembler::r10;
+static bool g_chainedFramesForPin();
+
+void CCodeGen_AArch32::SetPinnedFields(int32 rwField, int32 pointerField)
+{
+	//Immediate offsets only (prolog/epilog loads and stores)
+	bool valid = (rwField >= 0) && (rwField < 0x1000) && ((rwField & 3) == 0) &&
+	             (pointerField >= 0) && (pointerField < 0x1000) && ((pointerField & 3) == 0);
+	g_pinnedRwField = valid ? rwField : -1;
+	g_pinnedPointerField = valid ? pointerField : -1;
+}
+
+bool CCodeGen_AArch32::GetPinnedFields()
+{
+	return (g_pinnedRwField >= 0) && (g_pinnedPointerField >= 0);
+}
+
 unsigned int CCodeGen_AArch32::GetAvailableRegisterCount() const
 {
-	return MAX_REGISTERS;
+	static_assert(MAX_REGISTERS == 7, "the pinned registers are the last two");
+	return (GetPinnedFields() && g_chainedFramesForPin()) ? MAX_REGISTERS - 2 : MAX_REGISTERS;
+}
+
+bool CCodeGen_AArch32::IsSymbolPinned(const CSymbol* symbol) const
+{
+	//Called while allocating, before GenerateCode sets m_pinned
+	if(!GetPinnedFields() || !g_chainedFramesForPin()) return false;
+	if((symbol->m_type != SYM_RELATIVE) && (symbol->m_type != SYM_REL_REFERENCE)) return false;
+	auto offset = static_cast<int32>(symbol->m_valueLow);
+	return (offset == g_pinnedRwField) || (offset == g_pinnedPointerField);
+}
+
+bool CCodeGen_AArch32::GetPinnedRegister(const CSymbol* symbol, CAArch32Assembler::REGISTER& reg) const
+{
+	if(!m_pinned) return false;
+	if((symbol->m_type != SYM_RELATIVE) && (symbol->m_type != SYM_REL_REFERENCE)) return false;
+	if(static_cast<int32>(symbol->m_valueLow) == g_pinnedRwField)
+	{
+		reg = g_pinnedRwRegister;
+		return true;
+	}
+	if(static_cast<int32>(symbol->m_valueLow) == g_pinnedPointerField)
+	{
+		reg = g_pinnedPointerRegister;
+		return true;
+	}
+	return false;
 }
 
