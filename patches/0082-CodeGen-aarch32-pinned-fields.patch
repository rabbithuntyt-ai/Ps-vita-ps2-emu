+//Pinned fields: loaded on entry from C++, the read/write one stored when leaving to C++
+static void LoadPinnedFields(CAArch32Assembler& assembler)
+{
+	assembler.Ldr(g_pinnedRwRegister, CAArch32Assembler::r11, CAArch32Assembler::MakeImmediateLdrAddress(g_pinnedRwField));
+	assembler.Ldr(g_pinnedPointerRegister, CAArch32Assembler::r11, CAArch32Assembler::MakeImmediateLdrAddress(g_pinnedPointerField));
+}
+
+static void StorePinnedFields(CAArch32Assembler& assembler)
+{
+	assembler.Str(g_pinnedRwRegister, CAArch32Assembler::r11, CAArch32Assembler::MakeImmediateLdrAddress(g_pinnedRwField));
+}
