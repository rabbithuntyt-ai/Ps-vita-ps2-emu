+unsigned int CIPU::CINFIFO::ReadAlignedBytes(uint8* data, unsigned int count)
+{
+	if((m_bitPosition % 8) != 0) return 0;
+	unsigned int total = 0;
+	while(count != 0)
+	{
+		unsigned int position = m_bitPosition / 8;
+		if(position >= m_size) break;
+		//Advance discards consumed data in 16 byte steps: read in chunks
+		unsigned int chunk = std::min(std::min(count, m_size - position), 16U);
+		memcpy(data + total, m_buffer + position, chunk);
+		Advance(static_cast<uint8>(chunk * 8));
+		total += chunk;
+		count -= chunk;
+	}
+	return total;
+}
