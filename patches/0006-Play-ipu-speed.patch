+namespace
+{
+	// 16.16 fixed point YCbCr -> RGB contributions, indexed by Cb or Cr.
+	struct CSC_TABLES
+	{
+		int32 rCr[256], gCb[256], gCr[256], bCb[256];
+
+		CSC_TABLES()
+		{
+			for(int i = 0; i < 256; i++)
+			{
+				int c = i - 128;
+				rCr[i] = static_cast<int32>(1.402 * 65536.0 * c);
+				gCb[i] = static_cast<int32>(-0.34414 * 65536.0 * c);
+				gCr[i] = static_cast<int32>(-0.71414 * 65536.0 * c);
+				bCb[i] = static_cast<int32>(1.772 * 65536.0 * c);
+			}
+		}
+	};
+
+	inline uint32 ClampChannel(int32 value)
+	{
+		if(value < 0) return 0;
+		value >>= 16;
+		return (value > 255) ? 255 : static_cast<uint32>(value);
+	}
+}
+
+void CIPU::ConvertMacroblockToRgba32(const uint8* block, uint32* pixels, uint16 th0, uint16 th1)
+{
+	static const CSC_TABLES tables;
+	const uint8* yBlock = block;
+	const uint8* cbBlock = block + 0x100;
+	const uint8* crBlock = block + 0x140;
+	uint32 alphaTh0 = (th0 & 0x1FF);
+	uint32 alphaTh1 = (th1 & 0x1FF);
+	for(unsigned int i = 0; i < 16; i++)
+	{
+		const uint8* cbRow = cbBlock + (i / 2) * 8;
+		const uint8* crRow = crBlock + (i / 2) * 8;
+		for(unsigned int j = 0; j < 16; j++)
+		{
+			int32 y = static_cast<int32>(yBlock[j]) << 16;
+			uint32 cb = cbRow[j / 2];
+			uint32 cr = crRow[j / 2];
+			uint32 r = ClampChannel(y + tables.rCr[cr]);
+			uint32 g = ClampChannel(y + tables.gCb[cb] + tables.gCr[cr]);
+			uint32 b = ClampChannel(y + tables.bCb[cb]);
+
+			uint32 a = 0x80;
+			if(r < alphaTh0 && g < alphaTh0 && b < alphaTh0)
+			{
+				a = 0;
+			}
+			else if(r < alphaTh1 && g < alphaTh1 && b < alphaTh1)
+			{
+				a = 0x40;
+			}
+			pixels[j] = (a << 24) | (b << 16) | (g << 8) | (r << 0);
+		}
+		yBlock += 0x10;
+		pixels += 0x10;
+	}
+}
