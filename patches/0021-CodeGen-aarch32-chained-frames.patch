+
+namespace
+{
+	//Unwinds a chained frame and tail calls 'target' with the context in r0.
+	//One per target, shared by all functions.
+	class CChainedThunks
+	{
+	public:
+		static uintptr_t Get(uintptr_t target)
+		{
+			static std::mutex mutex;
+			static std::map<uintptr_t, std::unique_ptr<CMemoryFunction>> thunks;
+			std::lock_guard<std::mutex> lock(mutex);
+			auto thunkIterator = thunks.find(target);
+			if(thunkIterator != thunks.end()) return reinterpret_cast<uintptr_t>(thunkIterator->second->GetCode());
+
+			Framework::CMemStream stream;
+			CAArch32Assembler assembler;
+			assembler.SetStream(&stream);
+			assembler.Mov(CAArch32Assembler::r0, CAArch32Assembler::r11);
+			assembler.Add(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(g_chainedStackSize >> 8, 12));
+			assembler.Ldmia(CAArch32Assembler::rSP, (1 << CAArch32Assembler::r3));
+			assembler.Mov(CAArch32Assembler::rSP, CAArch32Assembler::r3);
+			assembler.Vpop(CAArch32Assembler::d8, 4);
+			assembler.Ldmia(CAArch32Assembler::rSP, g_chainedRegisterSave);
+			assembler.Ldr_Pc(CAArch32Assembler::rPC, -4);
+			stream.Write32(static_cast<uint32>(target));
+			auto& thunk = thunks[target];
+			thunk = std::make_unique<CMemoryFunction>(stream.GetBuffer(), stream.GetSize());
+			return reinterpret_cast<uintptr_t>(thunk->GetCode());
+		}
+	};
+}
