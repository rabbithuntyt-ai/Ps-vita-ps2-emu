+namespace
+{
+	//g_syscallTiming: time of a part of a kernel call in a timing slot
+	struct PART_TIMER
+	{
+		uint32 slot;
+		bool active = CPS2OS::g_syscallTiming;
+		std::chrono::steady_clock::time_point start;
+		PART_TIMER(uint32 slot)
+		    : slot(slot)
+		{
+			if(active) start = std::chrono::steady_clock::now();
+		}
+		~PART_TIMER()
+		{
+			if(!active) return;
+			CPS2OS::g_syscallTimeUs[slot] += std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count();
+			CPS2OS::g_syscallTimedCalls[slot]++;
+		}
+	};
+}
