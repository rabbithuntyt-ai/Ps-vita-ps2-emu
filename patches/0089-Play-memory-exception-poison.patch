+void CBasicBlock::CompileQuotaPoisonFix(CMipsJitter* jitter)
+{
+	//A poisoned quota is about -2^30 (top two bits set on a positive quota): add 2^30 back
+	jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+	jitter->PushCst(0xE0000000);
+	jitter->BeginIf(Jitter::CONDITION_LT);
+	{
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(0x40000000);
+		jitter->Add();
+		jitter->PullRel(offsetof(CMIPS, m_State.cycleQuota));
+	}
+	jitter->EndIf();
+}
+
 //Block ending in a likely branch: the branch jumps to m_likelyExitLabel when not taken
 //(the delay slot doesn't run), else falls through here after the delay slot.
 //Each path has its own exit, nDelayedJumpAddr is never set.
