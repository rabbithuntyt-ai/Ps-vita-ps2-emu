diff --git a/Source/ee/Ee_SubSystem.cpp b/Source/ee/Ee_SubSystem.cpp
--- a/Source/ee/Ee_SubSystem.cpp
+++ b/Source/ee/Ee_SubSystem.cpp
@@ -433,6 +433,10 @@ void CSubSystem::SetupEePageTable()
 	m_EE.MapPages(0x30000000, PS2::EE_RAM_SIZE, m_ram); //Uncached + Accelerated
 	m_EE.MapPages(0x70000000, PS2::EE_SPR_SIZE, m_spr);
 	m_EE.MapPages(0x80000000, PS2::EE_RAM_SIZE, m_ram);
+	//kseg1: uncached view of the same RAM, unmapped like kseg0 (DMA buffers
+	//and packets are often written through it). Without this every access
+	//takes the handler path (address translation + memory map lookup).
+	m_EE.MapPages(0xA0000000, PS2::EE_RAM_SIZE, m_ram);
 }
 
