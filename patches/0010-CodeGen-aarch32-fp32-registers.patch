+CAArch32Assembler::SINGLE_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterDefFp32(CSymbol* symbol, CAArch32Assembler::SINGLE_REGISTER workRegister)
+{
+	if(symbol->m_type == SYM_FP_REGISTER32)
+	{
+		assert(symbol->m_valueLow < MAX_MDREGISTERS);
+		return g_registersFp32[symbol->m_valueLow];
+	}
+	return workRegister;
+}
+
+CAArch32Assembler::SINGLE_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterUseFp32(CTempRegisterContext& tempRegContext, CSymbol* symbol, CAArch32Assembler::SINGLE_REGISTER workRegister)
+{
+	if(symbol->m_type == SYM_FP_REGISTER32)
+	{
+		assert(symbol->m_valueLow < MAX_MDREGISTERS);
+		return g_registersFp32[symbol->m_valueLow];
+	}
+	LoadMemoryFp32InRegister(tempRegContext, workRegister, symbol);
+	return workRegister;
+}
+
+CAArch32Assembler::SINGLE_REGISTER CCodeGen_AArch32::PrepareSymbolRegisterUseFp32Copy(CTempRegisterContext& tempRegContext, CSymbol* symbol, CAArch32Assembler::SINGLE_REGISTER workRegister)
+{
+	auto reg = PrepareSymbolRegisterUseFp32(tempRegContext, symbol, workRegister);
+	if(reg != workRegister)
+	{
+		m_assembler.Vmov_F32(workRegister, reg);
+	}
+	return workRegister;
+}
+
+void CCodeGen_AArch32::CommitSymbolRegisterFp32(CTempRegisterContext& tempRegContext, CSymbol* symbol, CAArch32Assembler::SINGLE_REGISTER usedRegister)
+{
+	if(symbol->m_type == SYM_FP_REGISTER32)
+	{
+		auto reg = g_registersFp32[symbol->m_valueLow];
+		if(reg != usedRegister)
+		{
+			m_assembler.Vmov_F32(reg, usedRegister);
+		}
+		return;
+	}
+	StoreRegisterInMemoryFp32(tempRegContext, symbol, usedRegister);
+}
