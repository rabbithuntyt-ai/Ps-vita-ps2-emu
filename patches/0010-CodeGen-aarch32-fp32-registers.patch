+void CAArch32Assembler::Vmov_F32(SINGLE_REGISTER sd, SINGLE_REGISTER sm)
+{
+	uint32 opcode = 0x0EB00A40;
+	opcode |= (CONDITION_AL << 28);
+	opcode |= FPSIMD_EncodeSd(sd);
+	opcode |= FPSIMD_EncodeSm(sm);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Vpush(DOUBLE_REGISTER firstReg, uint8 count)
+{
+	//VSTMDB sp!, {firstReg - firstReg + count - 1}
+	uint32 opcode = 0x0D2D0B00;
+	opcode |= (CONDITION_AL << 28);
+	opcode |= FPSIMD_EncodeDd(firstReg);
+	opcode |= (count * 2);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Vpop(DOUBLE_REGISTER firstReg, uint8 count)
+{
+	//VLDMIA sp!, {firstReg - firstReg + count - 1}
+	uint32 opcode = 0x0CBD0B00;
+	opcode |= (CONDITION_AL << 28);
+	opcode |= FPSIMD_EncodeDd(firstReg);
+	opcode |= (count * 2);
+	WriteWord(opcode);
+}
