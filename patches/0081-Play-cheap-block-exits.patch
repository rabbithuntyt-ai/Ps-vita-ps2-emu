+void CBasicBlock::AnalyseExit()
+{
+	m_exitAlwaysJumps = false;
+	m_exitNoException = false;
+	if(!g_cheapExits || (m_begin == m_end))
+	{
+		return;
+	}
+	auto getOp = [&](uint32 address) { return m_context.m_pMemoryMap->GetInstruction(address); };
+	{
+		uint32 op = getOp(m_end - 4);
+		uint32 top = op >> 26;
+		uint32 funct = op & 0x3F;
+		//j, jal, jr, jalr: the delay slot runs, then the jump is always taken
+		m_exitAlwaysJumps = (top == 0x02) || (top == 0x03) || ((top == 0x00) && ((funct == 0x08) || (funct == 0x09)));
+	}
+	//Instructions that can't set nHasException: integer arithmetic, logic,
+	//shifts, HI/LO moves (SPECIAL without syscall and traps), branches and jumps.
+	//Anything else (memory accesses call handlers on their slow path, COP0/1/2,
+	//MMI, syscall) keeps the test.
+	bool noException = true;
+	for(uint32 address = m_begin; address <= m_end; address += 4)
+	{
+		uint32 op = getOp(address);
+		uint32 top = op >> 26;
+		bool safe = false;
+		switch(top)
+		{
+		case 0x00:
+		{
+			uint32 funct = op & 0x3F;
+			safe = (funct != 0x0C) && (funct < 0x30); //not SYSCALL, not traps
+		}
+		break;
+		case 0x01:
+		{
+			uint32 rt = (op >> 16) & 0x1F;
+			safe = (rt <= 0x03) || ((rt >= 0x10) && (rt <= 0x13)); //BLTZ/BGEZ(L)(AL), not traps
+		}
+		break;
+		case 0x09:
+			//ADDIU R0, R0, x: the IOP's dynamic linking stubs, a syscall (CMA_MIPSIV::ADDIU)
+			safe = ((op >> 16) & 0x3FF) != 0;
+			break;
+		default:
+			safe = ((top >= 0x02) && (top <= 0x0F)) || ((top >= 0x14) && (top <= 0x17));
+			break;
+		}
+		if(!safe)
+		{
+			noException = false;
+			break;
+		}
+	}
+	m_exitNoException = noException;
+}
