+	{
+		g_cheapExits = enabled;
+	}
+	static bool GetCheapExits()
+	{
+		return g_cheapExits;
+	}
+
+
+protected:
+	static inline bool g_cheapExits = true;
+
 	virtual void CompileProlog(CMipsJitter*);
 	virtual void CompileEpilog(CMipsJitter*, bool);
 
