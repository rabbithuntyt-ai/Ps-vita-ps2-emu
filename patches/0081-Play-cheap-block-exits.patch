+	//Cheaper block exits (set by CompileRange from the guest code, MIPS blocks only):
+	//the block ends in j/jal/jr/jalr, so the delayed jump is always taken
+	bool m_exitAlwaysJumps = false;
+	//no instruction of the block can raise an exception (no memory access, syscall,
