@@ -864,19 +881,45 @@ void CPS2VM::SyncSpu()
 	if(!m_spuThreaded) return;
 	EmuProfile::CScope profileScope(EmuProfile::SECTION_SPU);
 	std::unique_lock<std::mutex> lock(m_spuMutex);
+	if(m_spuWork.empty() && !m_spuRendering) return;
+	m_spuFullSyncs++;
+	m_spuIdleWaiters++;
