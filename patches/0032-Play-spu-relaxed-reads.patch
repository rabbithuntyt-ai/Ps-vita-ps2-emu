+	m_spuIdleWaiters--;
+}
+
+void CPS2VM::AccessSpuForRead(const std::function<void()>& access)
+{
+	//The read needs every queued register write applied and the mixer paused
+	//between blocks; it may happen while a few audio blocks are still queued
+	//(the read then sees the mixing state a little earlier than inline).
+	EmuProfile::CScope profileScope(EmuProfile::SECTION_SPU);
+	std::unique_lock<std::mutex> lock(m_spuMutex);
+	auto ready = [this]() { return !m_spuRendering && (m_spuPendingWrites == 0) && (m_spuPendingRenders <= SPU_READ_MAX_LAG); };
+	if(!ready())
+	{
+		m_spuReadAccesses++;
+		m_spuIdleWaiters++;
+		m_spuIdleCondition.wait(lock, ready);
+		m_spuIdleWaiters--;
+	}
+	//The worker can't start the next item while the lock is held
+	access();
 }
 
 bool CPS2VM::QueueSpuWrite(uint32 address, uint32 value, bool spu2)
 {
 	//Register writes are applied by the worker in order with the audio
-	//blocks, exactly where they would have happened inline; reads still sync.
+	//blocks, exactly where they would have happened inline.
+	bool wake = false;
 	{
 		std::lock_guard<std::mutex> lock(m_spuMutex);
 		if(m_spuWork.size() >= 8192) return false; //backpressure: caller syncs
 		m_spuWork.push_back(SPU_WORK{address, value, static_cast<uint8>(spu2 ? SPU_WORK_WRITE_SPU2 : SPU_WORK_WRITE_SPU1)});
+		m_spuPendingWrites++;
+		wake = m_spuWorkerSleeping;
 	}
-	m_spuWorkCondition.notify_one();
+	if(wake) m_spuWorkCondition.notify_one();
 	return true;
 }
 
