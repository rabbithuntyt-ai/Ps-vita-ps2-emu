diff --git a/src/PathUtils.cpp b/src/PathUtils.cpp
index f7a9f8b..f66cd07 100644
--- a/src/PathUtils.cpp
+++ b/src/PathUtils.cpp
@@ -121,6 +121,48 @@ void PathUtils::SetCacheDirPath(const char* cacheDirPath)
 	s_cacheDirPath = cacheDirPath;
 }
 
+#elif defined(__vita__)
+
+//PlayStation Vita: the frontend decides where data lives (ex.: ux0:data/VitaPS2)
+static fs::path s_filesDirPath;
+static fs::path s_cacheDirPath;
+static fs::path s_resourcesPath;
+
+fs::path PathUtils::GetAppResourcesPath()
+{
+	return s_resourcesPath;
+}
+
+fs::path PathUtils::GetRoamingDataPath()
+{
+	return s_filesDirPath;
+}
+
+fs::path PathUtils::GetPersonalDataPath()
+{
+	return s_filesDirPath;
+}
+
+fs::path PathUtils::GetCachePath()
+{
+	return s_cacheDirPath.empty() ? s_filesDirPath : s_cacheDirPath;
+}
+
+void PathUtils::SetFilesDirPath(const char* filesDirPath)
+{
+	s_filesDirPath = filesDirPath;
+}
+
+void PathUtils::SetCacheDirPath(const char* cacheDirPath)
+{
+	s_cacheDirPath = cacheDirPath;
+}
+
+void PathUtils::SetAppResourcesPath(const char* resourcesPath)
+{
+	s_resourcesPath = resourcesPath;
+}
+
 #elif defined(__linux__) || defined(__FreeBSD__) || defined(__EMSCRIPTEN__)
 
 fs::path PathUtils::GetAppResourcesPath()
