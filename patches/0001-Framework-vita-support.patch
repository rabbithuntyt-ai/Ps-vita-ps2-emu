diff --git a/include/AlignedAlloc.h b/include/AlignedAlloc.h
index f5dfa9d..394cb7d 100644
--- a/include/AlignedAlloc.h
+++ b/include/AlignedAlloc.h
@@ -8,6 +8,10 @@
 #include <unistd.h>
 #endif
 
+#if defined(__vita__)
+#include <malloc.h>
+#endif
+
 #include "maybe_unused.h"
 
 FRAMEWORK_MAYBE_UNUSED
@@ -17,6 +21,8 @@ static size_t framework_getpagesize()
 	SYSTEM_INFO si;
 	GetSystemInfo(&si);
 	return si.dwPageSize;
+#elif defined(__vita__)
+	return 4096;
 #else
 	return sysconf(_SC_PAGESIZE);
 #endif
@@ -34,6 +40,8 @@ static void* framework_aligned_alloc(size_t allocSize, size_t alignment)
 		return nullptr;
 	}
 	return result;
+#elif defined(__vita__)
+	return memalign(alignment, allocSize);
 #else
 	return malloc(allocSize);
 #endif
