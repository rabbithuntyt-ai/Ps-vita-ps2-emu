+++ b/Source/ee/Dmac_Channel.cpp
@@ -1,9 +1,11 @@
+#include <algorithm>
 #include <string.h>
 #include <assert.h>
 #include "string_format.h"
 #include "../states/RegisterStateFile.h"
 #include "Log.h"
 #include "Dmac_Channel.h"
+#include "../Ps2Const.h"
 #include "DMAC.h"
 
 #define LOG_NAME ("ee_dmac")
@@ -530,6 +532,22 @@
 
 	if(qwc != 0)
 	{
+		if(g_chainPrefetch && !isMfifo && !(m_nTADR & 0x80000000))
+		{
+			//The next tag (the chain continues at TADR) and the first lines of the data it points to
+			const uint8* tagPointer = m_dmac.m_ram + (m_nTADR & (PS2::EE_RAM_SIZE - 1));
+			__builtin_prefetch(tagPointer);
+			uint64 next = *reinterpret_cast<const uint64*>(tagPointer);
+			uint32 nextId = static_cast<uint32>((next >> 28) & 0x07);
+			uint32 nextQwc = static_cast<uint32>(next & 0xFFFF);
+			uint32 nextAddress = ((nextId == DMATAG_SRC_REF) || (nextId == DMATAG_SRC_REFS) || (nextId == DMATAG_SRC_REFE)) ? static_cast<uint32>((next >> 32) & DMATAG_ADDR_MASK) : (m_nTADR + 0x10);
+			if(!(nextAddress & 0x80000000))
+			{
+				const uint8* data = m_dmac.m_ram + (nextAddress & (PS2::EE_RAM_SIZE - 1));
+				uint32 bytes = std::min<uint32>(nextQwc * 0x10, 512);
+				for(uint32 offset = 0; offset < bytes; offset += 64) __builtin_prefetch(data + offset);
+			}
+		}
 		uint32 nRecv = m_receive(m_nMADR, qwc, CHCR_DIR_FROM, false);
 
 		m_nMADR += nRecv * 0x10;
