diff --git a/Source/ee/Vif.cpp b/Source/ee/Vif.cpp
--- a/Source/ee/Vif.cpp
+++ b/Source/ee/Vif.cpp
@@ -718,6 +718,13 @@ void CVif::Cmd_UNPACK(StreamType& stream, CODE nCommand, uint32 nDstAddr)
 	bool useMask = (nCommand.nCMD & 0x10) != 0;
 	bool usn = (m_CODE.nIMM & 0x4000) != 0;
 	uint8 mode = m_MODE & 0x3;
+	{
+		uint32 values = (m_NUM == 0) ? 256 : m_NUM;
+		EmuProfile::g_unpackValues[nCommand.nCMD & 0x0F].fetch_add(values, std::memory_order_relaxed);
