+	// The PSMCT32 block layout the column path assumes: chunk c (8 bytes) of a block holds pixels
+	// 2j, 2j+1 of block row 2k + (c % 2), with k = c / 8 and j = (c % 8) / 2
+	template <typename Storage>
+	bool ColumnLayoutMatches()
+	{
+		static const bool matches = []() {
+			if(sizeof(typename Storage::Unit) != 4) return false;
+			const auto& chunks = GetBlockChunks<Storage>();
+			if(!chunks.valid) return false;
+			for(uint32 c = 0; c < CGsPixelFormats::BLOCKSIZE / 8; c++)
+			{
+				uint32 k = c / 8, j = (c % 8) / 2;
+				if((chunks.x[c] != 2 * j) || (chunks.y[c] != 2 * k + (c % 2))) return false;
+			}
+			return true;
+		}();
+		return matches;
+	}
+
+	// One PSMCT32 block from 8 transfer rows 'rrw' pixels apart, by columns (ColumnLayoutMatches)
+	inline void WriteColumnsBlock32(uint8* block, const uint32* base, uint32 rrw)
+	{
+		for(uint32 k = 0; k < 4; k++)
+		{
+			const uint32* r0 = base + (2 * k) * rrw;
+			const uint32* r1 = r0 + rrw;
+			uint8* out = block + k * 64;
+#if defined(__ARM_NEON)
+			uint64x2_t a0 = vreinterpretq_u64_u32(vld1q_u32(r0)), a1 = vreinterpretq_u64_u32(vld1q_u32(r0 + 4));
+			uint64x2_t b0 = vreinterpretq_u64_u32(vld1q_u32(r1)), b1 = vreinterpretq_u64_u32(vld1q_u32(r1 + 4));
+			vst1q_u64(reinterpret_cast<uint64_t*>(out + 0), vcombine_u64(vget_low_u64(a0), vget_low_u64(b0)));
+			vst1q_u64(reinterpret_cast<uint64_t*>(out + 16), vcombine_u64(vget_high_u64(a0), vget_high_u64(b0)));
+			vst1q_u64(reinterpret_cast<uint64_t*>(out + 32), vcombine_u64(vget_low_u64(a1), vget_low_u64(b1)));
+			vst1q_u64(reinterpret_cast<uint64_t*>(out + 48), vcombine_u64(vget_high_u64(a1), vget_high_u64(b1)));
+#else
+			for(uint32 j = 0; j < 4; j++)
+			{
+				std::memcpy(out + j * 16, r0 + 2 * j, 8);
+				std::memcpy(out + j * 16 + 8, r1 + 2 * j, 8);
+			}
+#endif
+		}
+	}
+
