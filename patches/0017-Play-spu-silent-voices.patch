 	if(fixedLeft) channel.volumeLeftAbs = ComputeChannelVolume(channel.volumeLeft, channel.volumeLeftAbs);
 	if(fixedRight) channel.volumeRightAbs = ComputeChannelVolume(channel.volumeRight, channel.volumeRightAbs);
 
+	if((channel.status == STOPPED) && (channel.adsrVolume == 0) && fixedLeft && fixedRight)
+	{
+		//Silent voice (most voices, most of the time): its samples are scaled
