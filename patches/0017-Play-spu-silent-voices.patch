+bool CSpuBase::CSampleReader::IsFrozen() const
+{
+	return (m_sampleStep == 0) && ((m_srcSampleIdx / PITCH_BASE) < BUFFER_SAMPLES);
+}
+
+void CSpuBase::CSampleReader::SkipSample()
+{
+	uint32 srcSampleIdx = m_srcSampleIdx / PITCH_BASE;
+	m_srcSampleIdx += m_sampleStep;
+	if(srcSampleIdx >= BUFFER_SAMPLES)
+	{
+		m_srcSampleIdx -= BUFFER_SAMPLES * PITCH_BASE;
+		AdvanceBuffer();
+	}
+}
