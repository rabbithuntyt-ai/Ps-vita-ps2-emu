+		//only the sample reader (address, loop flags, IRQ checks) advances.
+		for(unsigned int j = 0; j < ticks; j++)
+		{
+			if(reader.IsDone())
+			{
+				reader.ClearIsDone();
+			}
+			if(reader.DidChangeRepeat() && !channel.repeatSet)
+			{
+				channel.repeat = reader.GetRepeat();
+				reader.ClearDidChangeRepeat();
+			}
+			reader.SetRepeat(channel.repeat);
+			if(reader.IsFrozen())
+			{
+				//Nothing moves anymore: the remaining samples are identical.
+				break;
+			}
+			reader.SkipSample();
+		}
+		channel.current = reader.GetCurrent();
+		return;
+	}
