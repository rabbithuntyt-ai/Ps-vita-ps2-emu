+	// For one block of a format with whole-byte units: the source pixel (x, y in the block) of
+	// each 8 bytes of the block, when each 8 bytes are pixels next to each other in one row
+	// (PSMCT32: 2 pixels; built from Play's page offsets on first use). 'valid' false: some
+	// are not, the unit path is used.
+	struct CHUNK_TABLE
+	{
+		bool valid = false;
+		uint8 x[CGsPixelFormats::BLOCKSIZE / 8];
+		uint8 y[CGsPixelFormats::BLOCKSIZE / 8];
+	};
+
+	template <typename Storage>
+	const CHUNK_TABLE& GetBlockChunks()
+	{
+		static const CHUNK_TABLE table = []() {
+			typedef typename Storage::Unit Unit;
+			const uint32 unitsPerChunk = 8 / sizeof(Unit);
+			CHUNK_TABLE t;
+			const uint32* pageOffsets = CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets();
+			int unitX[CGsPixelFormats::BLOCKSIZE], unitY[CGsPixelFormats::BLOCKSIZE];
+			for(uint32 i = 0; i < CGsPixelFormats::BLOCKSIZE; i++) unitX[i] = unitY[i] = -1;
+			for(uint32 y = 0; y < Storage::BLOCKHEIGHT; y++)
+			{
+				for(uint32 x = 0; x < Storage::BLOCKWIDTH; x++)
+				{
+					uint32 offset = pageOffsets[y * Storage::PAGEWIDTH + x];
+					if((offset >= CGsPixelFormats::BLOCKSIZE) || (offset % sizeof(Unit))) return t;
+					unitX[offset / sizeof(Unit)] = x;
+					unitY[offset / sizeof(Unit)] = y;
+				}
+			}
+			for(uint32 c = 0; c < CGsPixelFormats::BLOCKSIZE / 8; c++)
+			{
+				uint32 first = c * unitsPerChunk;
+				if(unitX[first] < 0) return t;
+				for(uint32 u = 1; u < unitsPerChunk; u++)
+				{
+					if((unitY[first + u] != unitY[first]) || (unitX[first + u] != unitX[first] + static_cast<int>(u))) return t;
+				}
+				t.x[c] = static_cast<uint8>(unitX[first]);
+				t.y[c] = static_cast<uint8>(unitY[first]);
+			}
+			t.valid = true;
+			return t;
+		}();
+		return table;
+	}
