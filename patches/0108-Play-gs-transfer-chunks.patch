+	// A whole PSMT4 block (32x16 pixels, 4 columns of 4 rows) from 16 source rows of 16 bytes.
+	// In the PSMT4 layout every byte of a column holds pixels of two rows: the low nibble pixel
+	// x of row y (0 or 1 in the column), the high one pixel x ^ 4 of row y + 2. So a column is
+	// made from two 32-byte row pairs (byte x: row y's pixel x | row y+2's pixel x ^ 4 << 4; x ^ 4
+	// is the source bytes with the 16-bit halves of each word swapped) and each 8 bytes of it
+	// are a lookup into one of them (vtbl on ARM). Tables built from Play's page offsets on
+	// first use; if the layout ever stopped being this, 'valid' is false and the nibble path is
+	// used.
+	struct PSMT4_BLOCK_TABLES
+	{
+		bool valid = false;
+		uint8 pair[4][8];     //[column][8-byte chunk]: row pair 0 (rows 0/2) or 1 (rows 1/3)
+		uint8 index[4][8][8]; //[column][chunk][byte]: pixel x in the row pair
+	};
+
+	inline const PSMT4_BLOCK_TABLES& GetPsmt4BlockTables()
+	{
+		static const PSMT4_BLOCK_TABLES tables = []() {
+			typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+			PSMT4_BLOCK_TABLES t;
+			const uint32* pageOffsets = CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets();
+			//The page's first block: for each byte, its two (x, y) sources
+			int lowX[256], lowY[256], highX[256], highY[256];
+			for(int i = 0; i < 256; i++) lowX[i] = lowY[i] = highX[i] = highY[i] = -1;
+			for(uint32 y = 0; y < Storage::BLOCKHEIGHT; y++)
+			{
+				for(uint32 x = 0; x < Storage::BLOCKWIDTH; x++)
+				{
+					uint32 nibble = pageOffsets[y * Storage::PAGEWIDTH + x];
+					if(nibble >= CGsPixelFormats::BLOCKSIZE * 2) return t;
+					uint32 byte = nibble >> 1;
+					if(nibble & 1)
+					{
+						highX[byte] = x;
+						highY[byte] = y;
+					}
+					else
+					{
+						lowX[byte] = x;
+						lowY[byte] = y;
+					}
+				}
+			}
+			for(uint32 column = 0; column < 4; column++)
+			{
+				for(uint32 chunk = 0; chunk < 8; chunk++)
+				{
+					for(uint32 b = 0; b < 8; b++)
+					{
+						uint32 byte = column * 64 + chunk * 8 + b;
+						int row = lowY[byte] - static_cast<int>(column * 4);
+						if((lowX[byte] < 0) || (row < 0) || (row > 1) || (highX[byte] != (lowX[byte] ^ 4)) || (highY[byte] != lowY[byte] + 2)) return t;
+						if((b != 0) && (t.pair[column][chunk] != row)) return t;
+						t.pair[column][chunk] = static_cast<uint8>(row);
+						t.index[column][chunk][b] = static_cast<uint8>(lowX[byte]);
+					}
+				}
+			}
+			t.valid = true;
+			return t;
+		}();
+		return tables;
+	}
+
+	// One PSMT4 block: 'rows' points at the block's first source row (byte aligned), 'stride'
+	// bytes between rows. Returns whether the block changed.
+	inline bool WritePsmt4Block(uint8* block, const uint8* rows, uint32 stride, const PSMT4_BLOCK_TABLES& t)
+	{
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+		uint8x16_t changed = vdupq_n_u8(0);
+		for(uint32 column = 0; column < 4; column++)
+		{
+			const uint8* r = rows + column * 4 * stride;
+			uint8x16_t r0 = vld1q_u8(r), r1 = vld1q_u8(r + stride);
+			//Rows 2 and 3 with pixel x ^ 4 at pixel x (bytes i ^ 2)
+			uint8x16_t r2 = vreinterpretq_u8_u16(vrev32q_u16(vreinterpretq_u16_u8(vld1q_u8(r + 2 * stride))));
+			uint8x16_t r3 = vreinterpretq_u8_u16(vrev32q_u16(vreinterpretq_u16_u8(vld1q_u8(r + 3 * stride))));
+			//Even pixels: low nibbles of both rows; odd pixels: high nibbles
+			uint8x16x2_t p0 = vzipq_u8(vsliq_n_u8(r0, r2, 4), vsriq_n_u8(r2, r0, 4));
+			uint8x16x2_t p1 = vzipq_u8(vsliq_n_u8(r1, r3, 4), vsriq_n_u8(r3, r1, 4));
+			uint8x8x4_t pairs[2];
+			pairs[0].val[0] = vget_low_u8(p0.val[0]);
+			pairs[0].val[1] = vget_high_u8(p0.val[0]);
+			pairs[0].val[2] = vget_low_u8(p0.val[1]);
+			pairs[0].val[3] = vget_high_u8(p0.val[1]);
+			pairs[1].val[0] = vget_low_u8(p1.val[0]);
+			pairs[1].val[1] = vget_high_u8(p1.val[0]);
+			pairs[1].val[2] = vget_low_u8(p1.val[1]);
+			pairs[1].val[3] = vget_high_u8(p1.val[1]);
+			uint8* out = block + column * 64;
+			for(uint32 chunk = 0; chunk < 8; chunk += 2)
+			{
+				uint8x8_t a = vtbl4_u8(pairs[t.pair[column][chunk]], vld1_u8(t.index[column][chunk]));
+				uint8x8_t b = vtbl4_u8(pairs[t.pair[column][chunk + 1]], vld1_u8(t.index[column][chunk + 1]));
+				uint8x16_t value = vcombine_u8(a, b);
+				uint8x16_t old = vld1q_u8(out + chunk * 8);
+				changed = vorrq_u8(changed, veorq_u8(value, old));
+				vst1q_u8(out + chunk * 8, value);
+			}
+		}
+		uint32x2_t folded = vorr_u32(vget_low_u32(vreinterpretq_u32_u8(changed)), vget_high_u32(vreinterpretq_u32_u8(changed)));
+		return (vget_lane_u32(folded, 0) | vget_lane_u32(folded, 1)) != 0;
+#else
+		bool dirty = false;
+		for(uint32 column = 0; column < 4; column++)
+		{
+			const uint8* r = rows + column * 4 * stride;
+			uint8 pairs[2][32];
+			for(uint32 p = 0; p < 2; p++)
+			{
+				const uint8* lo = r + p * stride;
+				const uint8* hi = r + (p + 2) * stride;
+				for(uint32 i = 0; i < 16; i++)
+				{
+					uint8 h = hi[i ^ 2]; //pixel x ^ 4
+					pairs[p][i * 2] = static_cast<uint8>((lo[i] & 0x0F) | (h << 4));
+					pairs[p][i * 2 + 1] = static_cast<uint8>((lo[i] >> 4) | (h & 0xF0));
+				}
+			}
+			uint8* out = block + column * 64;
+			for(uint32 chunk = 0; chunk < 8; chunk++)
+			{
+				const uint8* pair = pairs[t.pair[column][chunk]];
+				for(uint32 b = 0; b < 8; b++)
+				{
+					uint8 value = pair[t.index[column][chunk][b]];
+					if(out[chunk * 8 + b] != value)
+					{
+						out[chunk * 8 + b] = value;
+						dirty = true;
+					}
+				}
+			}
+		}
+		return dirty;
+#endif
+	}
