+	// WritePsmt4Block against a nibble at a time write through Play's page offsets, on random
+	// blocks: the number of blocks that differ (memory or "changed"). For builds the tests do
+	// not run on (the NEON path on the Vita).
+	inline uint32 SelfTestPsmt4Blocks(uint32 trials)
+	{
+		typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+		const auto& tables = GetPsmt4BlockTables();
+		if(!tables.valid) return trials;
+		const uint32* pageOffsets = CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets();
+		uint32 seed = 0x12345678;
+		auto next = [&seed]() { seed = seed * 1664525 + 1013904223; return static_cast<uint8>(seed >> 24); };
+		uint32 failures = 0;
+		for(uint32 trial = 0; trial < trials; trial++)
+		{
+			uint32 stride = 16 * (1 + trial % 4);
+			uint8 rows[16 * 64];
+			uint8 block[256], expected[256];
+			for(auto& b : rows) b = next();
+			for(uint32 i = 0; i < 256; i++) block[i] = expected[i] = (trial & 1) ? next() : 0;
+			if(trial % 8 == 7)
+			{
+				//An unchanged block: written once already
+				WritePsmt4Block(block, rows, stride, tables);
+				std::copy(block, block + 256, expected);
+			}
+			bool expectedChange = false;
+			for(uint32 y = 0; y < Storage::BLOCKHEIGHT; y++)
+			{
+				for(uint32 x = 0; x < Storage::BLOCKWIDTH; x++)
+				{
+					uint8 value = (rows[y * stride + x / 2] >> ((x & 1) * 4)) & 0x0F;
+					uint32 nibble = pageOffsets[y * Storage::PAGEWIDTH + x];
+					uint8& byte = expected[nibble >> 1];
+					uint32 shift = (nibble & 1) * 4;
+					uint8 updated = static_cast<uint8>((byte & ~(0x0F << shift)) | (value << shift));
+					if(updated != byte) expectedChange = true;
+					byte = updated;
+				}
+			}
+			bool changed = WritePsmt4Block(block, rows, stride, tables);
+			if((changed != expectedChange) || !std::equal(block, block + 256, expected)) failures++;
+		}
+		return failures;
+	}
