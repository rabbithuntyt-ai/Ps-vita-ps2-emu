+void CVpu::SetThreaded(bool threaded, const std::function<void()>& workerInit)
+{
+	if(threaded == m_threaded) return;
+	if(m_threaded)
+	{
+		Sync();
+		{
+			std::lock_guard<std::mutex> lock(m_workerMutex);
+			m_stopWorker = true;
+		}
+		m_workerCondition.notify_all();
+		m_worker.join();
+		m_threaded = false;
+		return;
+	}
+	assert(m_vuState != VU_STATE_RUNNING);
+	m_stopWorker = false;
+	m_workPending = false;
+	m_threaded = true;
+	m_worker = std::thread(
+	    [this, workerInit]() {
+		    if(workerInit) workerInit();
+		    WorkerProc();
+	    });
+	m_workerId = m_worker.get_id();
+}
+
+void CVpu::WorkerProc()
+{
+	while(true)
+	{
+		{
+			std::unique_lock<std::mutex> lock(m_workerMutex);
+			m_workerCondition.wait(lock, [this]() { return m_workPending || m_stopWorker; });
+			if(m_stopWorker) break;
+			m_workPending = false;
+		}
+		while((m_vuState == VU_STATE_RUNNING) && !m_stopWorker)
+		{
+			ExecuteInternal(5000);
+		}
+		{
+			std::lock_guard<std::mutex> lock(m_workerMutex);
+		}
+		m_idleCondition.notify_all();
+	}
+}
+
+void CVpu::Sync()
+{
+	if(!m_threaded) return;
+	{
+		std::unique_lock<std::mutex> lock(m_workerMutex);
+		m_idleCondition.wait(lock, [this]() { return !m_workPending && (m_vuState != VU_STATE_RUNNING); });
+	}
+	FlushPendingXgKicks();
+	RaisePendingInterrupt();
+}
+
+void CVpu::RaisePendingInterrupt()
+{
+	if(m_pendingInterrupt.exchange(false))
+	{
+		VuStateChanged(m_vuState);
+		VuInterruptTriggered();
+	}
+}
+
+void CVpu::FlushPendingXgKicks()
+{
+	if(!m_hasPendingKicks) return;
+	std::vector<std::vector<uint8>> kicks;
+	{
+		std::lock_guard<std::mutex> lock(m_kickMutex);
+		kicks.swap(m_pendingKicks);
+		m_hasPendingKicks = false;
+	}
+	CGsPacketMetadata metadata;
+	metadata.pathIndex = 1;
+	for(const auto& packet : kicks)
+	{
+		uint32 size = static_cast<uint32>(packet.size());
+		uint32 processed = 0;
+		while(processed < size)
+		{
+			uint32 consumed = m_gif.ProcessSinglePacket(packet.data(), size, processed, size, metadata);
+			if(consumed == 0) break;
+			processed += consumed;
+			if(m_gif.GetActivePath() == 0) break;
+		}
+	}
+}
+
+void CVpu::QueueXgKick(uint32 address)
+{
+	//Copy the whole GIF packet (tags until EOP) out of VU memory now: the
+	//program keeps running and may overwrite it.
+	uint32 memoryMask = m_vuMemSize - 1;
+	uint32 position = address;
+	uint32 size = 0;
+	while(size < m_vuMemSize)
+	{
+		uint64 tag = *reinterpret_cast<const uint64*>(m_vuMem + (position & memoryMask));
+		uint32 nloop = static_cast<uint32>(tag & 0x7FFF);
+		bool eop = ((tag >> 15) & 1) != 0;
+		uint32 flg = static_cast<uint32>((tag >> 58) & 3);
+		uint32 nreg = static_cast<uint32>((tag >> 60) & 0xF);
+		if(nreg == 0) nreg = 16;
+		uint32 dataSize = 0;
+		switch(flg)
+		{
+		case 0: //PACKED
+			dataSize = nloop * nreg * 0x10;
+			break;
+		case 1: //REGLIST
+			dataSize = ((nloop * nreg * 8) + 0xF) & ~0xF;
+			break;
+		default: //IMAGE
+			dataSize = nloop * 0x10;
+			break;
+		}
+		uint32 packetSize = 0x10 + dataSize;
+		size += packetSize;
+		position += packetSize;
+		if(eop) break;
+	}
+	size = std::min(size, m_vuMemSize);
+
+	std::vector<uint8> packet(size);
+	uint32 start = address & memoryMask;
+	uint32 firstPart = std::min(size, m_vuMemSize - start);
+	memcpy(packet.data(), m_vuMem + start, firstPart);
+	if(firstPart < size)
+	{
+		memcpy(packet.data() + firstPart, m_vuMem, size - firstPart);
+	}
+	{
+		std::lock_guard<std::mutex> lock(m_kickMutex);
+		m_pendingKicks.push_back(std::move(packet));
+		m_hasPendingKicks = true;
+	}
+}
