+void CAArch32Assembler::Vbit(DOUBLE_REGISTER dd, DOUBLE_REGISTER dn, DOUBLE_REGISTER dm)
+{
+	uint32 opcode = 0xF3200110;
+	opcode |= ((dd >> 4) & 1) << 22;
+	opcode |= (dn & 0xF) << 16;
+	opcode |= (dd & 0xF) << 12;
+	opcode |= ((dn >> 4) & 1) << 7;
+	opcode |= ((dm >> 4) & 1) << 5;
+	opcode |= (dm & 0xF);
+	WriteWord(opcode);
+}
+
+void CAArch32Assembler::Vmov_I64(DOUBLE_REGISTER dd, uint8 imm8)
+{
+	uint32 opcode = 0xF2800E30;
+	opcode |= ((imm8 >> 7) & 1) << 24;
+	opcode |= ((dd >> 4) & 1) << 22;
+	opcode |= ((imm8 >> 4) & 7) << 16;
+	opcode |= (dd & 0xF) << 12;
+	opcode |= (imm8 & 0xF);
+	WriteWord(opcode);
+}
