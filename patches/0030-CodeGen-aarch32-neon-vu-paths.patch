+
+//Lane flags: sign in bit 31, zero in bit 0. Lanes outside the dest mask (bit 3 = x)
+//are not accumulated.
+void CCodeGen_AArch32::Emit_Md_AccumSz_VarVarVar(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+	auto src2 = statement.src2->GetSymbol().get();
+	uint8 dest = static_cast<uint8>(statement.jmpCondition) & 0xF;
+
+	auto valueReg = PrepareSymbolRegisterUseMd(src2, CAArch32Assembler::q0);
+	auto flagsReg = CAArch32Assembler::q1;
+	auto zeroReg = CAArch32Assembler::q2;
+
+	m_assembler.Vceqz_F32(zeroReg, valueReg);
+	m_assembler.Vshr_U32(zeroReg, zeroReg, 31);
+	m_assembler.Vshr_U32(flagsReg, valueReg, 31);
+	m_assembler.Vshl_I32(flagsReg, flagsReg, 31);
+	m_assembler.Vorr(flagsReg, flagsReg, zeroReg);
+	if(dest != 0xF)
+	{
+		auto maskReg = CAArch32Assembler::q3;
+		//VU dest: x = bit 3 = lane 0
+		uint8 lo = ((dest & 8) ? 0x0F : 0) | ((dest & 4) ? 0xF0 : 0);
+		uint8 hi = ((dest & 2) ? 0x0F : 0) | ((dest & 1) ? 0xF0 : 0);
+		m_assembler.Vmov_I64(static_cast<CAArch32Assembler::DOUBLE_REGISTER>(maskReg + 0), lo);
+		m_assembler.Vmov_I64(static_cast<CAArch32Assembler::DOUBLE_REGISTER>(maskReg + 1), hi);
+		m_assembler.Vand(flagsReg, flagsReg, maskReg);
+	}
+	auto accReg = PrepareSymbolRegisterUseMd(src1, CAArch32Assembler::q0);
+	auto dstReg = PrepareSymbolRegisterDefMd(dst, CAArch32Assembler::q0);
+	m_assembler.Vorr(dstReg, accReg, flagsReg);
+	CommitSymbolRegisterMd(dst, dstReg);
+}
+
+void CCodeGen_AArch32::Emit_Md_MakeSzAcc_VarVar(const STATEMENT& statement)
+{
+	auto dst = statement.dst->GetSymbol().get();
+	auto src1 = statement.src1->GetSymbol().get();
+
+	//Rebuild a value with the accumulated flags: sign bit kept, zero lanes as +/-0,
+	//other lanes 0x7FFFFFFF (NaN, not equal to zero)
+	auto accReg = PrepareSymbolRegisterUseMd(src1, CAArch32Assembler::q0);
+	auto valueReg = CAArch32Assembler::q0;
+	auto nonZeroReg = CAArch32Assembler::q2;
+	auto zeroCstReg = CAArch32Assembler::q3;
+	m_assembler.Vshl_I32(nonZeroReg, accReg, 31);
+	m_assembler.Veor(zeroCstReg, zeroCstReg, zeroCstReg);
+	m_assembler.Vceq_I32(nonZeroReg, nonZeroReg, zeroCstReg);
+	m_assembler.Vshr_U32(nonZeroReg, nonZeroReg, 1);
+	m_assembler.Vshr_U32(valueReg, accReg, 31);
+	m_assembler.Vshl_I32(valueReg, valueReg, 31);
+	m_assembler.Vorr(valueReg, valueReg, nonZeroReg);
+
+	auto dstReg = PrepareSymbolRegisterDef(dst, CAArch32Assembler::r0);
+	MdMakeSignZero(dstReg, valueReg);
+	CommitSymbolRegister(dst, dstReg);
+}
