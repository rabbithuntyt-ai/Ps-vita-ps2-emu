+//Block ending in a likely branch: the branch jumps to m_likelyExitLabel when not taken
+//(the delay slot doesn't run), else falls through here after the delay slot.
+//Each path has its own exit, nDelayedJumpAddr is never set.
+void CBasicBlock::CompileLikelyEpilog(CMipsJitter* jitter, bool loopsOnItself)
+{
+	auto endLabel = jitter->CreateLabel();
+	auto exitPath = [&](bool taken) {
+		int32 pcOffset = taken ? m_exitLikelyOffset : static_cast<int32>(m_end - m_begin + 4);
+		auto pushNextPc = [&]() {
+			jitter->PushRel(offsetof(CMIPS, m_State.nPC));
+			jitter->PushCst(pcOffset);
+			jitter->Add();
+		};
+
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(((m_end - m_begin) / 4) + 1);
+		jitter->Sub();
+		jitter->PullRel(offsetof(CMIPS, m_State.cycleQuota));
+
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(0);
+		jitter->BeginIf(Jitter::CONDITION_GT);
+		{
+			auto leave = [&]() {
+				if(taken && loopsOnItself)
+				{
+					//nPC is the block's start already
+					jitter->Goto(jitter->GetFirstBlockLabel());
+					return;
+				}
+				pushNextPc();
+				jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+				jitter->JumpToDynamic(reinterpret_cast<void*>(taken ? &BranchBlockTrampoline : &NextBlockTrampoline));
+			};
+			if(m_exitNoException)
+			{
+				leave();
+			}
+			else
+			{
+				jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+				jitter->PushCst(0);
+				jitter->BeginIf(Jitter::CONDITION_EQ);
+				leave();
+				jitter->EndIf();
+			}
+		}
+		jitter->EndIf();
+
+		//Slow path: back to the executor
+		jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+		jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
+		jitter->PushCst(0);
+		jitter->Cmp(Jitter::CONDITION_LE);
+		jitter->Shl(7);
+		jitter->Or();
+		jitter->PullRel(offsetof(CMIPS, m_State.nHasException));
+
+		pushNextPc();
+		jitter->PullRel(offsetof(CMIPS, m_State.nPC));
+		if(taken) jitter->Goto(endLabel);
+	};
+	exitPath(true);
+	jitter->MarkLabel(m_likelyExitLabel);
+	exitPath(false);
+	jitter->MarkLabel(endLabel);
+}
+
 void CBasicBlock::CompileEpilog(CMipsJitter* jitter, bool loopsOnItself)
 {
+	if(m_exitLikely)
+	{
+		CompileLikelyEpilog(jitter, loopsOnItself);
+		return;
+	}
+
 	//Fast path (quota left, no exception): dispatch to the next block directly.
 	//Slow path: flag the quota and leave with nPC updated.
 	jitter->PushRel(offsetof(CMIPS, m_State.cycleQuota));
