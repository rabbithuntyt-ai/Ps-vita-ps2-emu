+	//Outer product lanes: result lane i = fs[first] * ft[second]
+	const unsigned int g_outerProductLanes[3][2] = {{VUShared::VECTOR_COMPY, VUShared::VECTOR_COMPZ}, {VUShared::VECTOR_COMPZ, VUShared::VECTOR_COMPX}, {VUShared::VECTOR_COMPX, VUShared::VECTOR_COMPY}};
+
+	//dst.xyz = fs.yzx * ft.zxy, each lane from two broadcasts (VF registers are only read as
+	//128-bit values: the register allocator can keep them in host registers)
+	void PullOuterProduct(CMipsJitter* codeGen, size_t dst, uint8 fs, uint8 ft)
+	{
+		for(unsigned int i = 0; i < 3; i++)
+		{
+			VUShared::PushBcElement(codeGen, VUShared::GetVectorElement(fs, g_outerProductLanes[i][0]));
+			VUShared::PushBcElement(codeGen, VUShared::GetVectorElement(ft, g_outerProductLanes[i][1]));
+			codeGen->MD_MulS();
+			codeGen->MD_PullRel(dst, i == 0, i == 1, i == 2, false);
+		}
+	}
+}
