+void CVpu::NoteReuse(int kind, const uint8* data, uint32 size)
+{
+	static std::unordered_map<uint64, uint32> lastSeen;
+	constexpr uint32 REUSE_WINDOW = 6;
+	//FNV-1a, 64 bits
+	uint64 hash = 0xCBF29CE484222325ULL ^ size;
+	for(uint32 i = 0; i < size; i++)
+	{
+		hash ^= data[i];
+		hash *= 0x100000001B3ULL;
+	}
+	auto& counts = g_reuse[kind];
+	counts[0]++;
+	counts[1] += size;
+	auto it = lastSeen.find(hash);
+	if((it != lastSeen.end()) && ((g_reuseVBlank - it->second) <= REUSE_WINDOW))
+	{
+		counts[2]++;
+		counts[3] += size;
+	}
+	bool repeated = (it != lastSeen.end()) && ((g_reuseVBlank - it->second) <= REUSE_WINDOW);
+	if((kind == 1) && (size >= 16))
+	{
+		uint64 tag = 0;
+		memcpy(&tag, data, 8);
+		uint32 flg = static_cast<uint32>(tag >> 58) & 3;
+		g_reuseDirectMode[flg][0] += size;
+		if(repeated) g_reuseDirectMode[flg][1] += size;
+	}
+	lastSeen[hash] = g_reuseVBlank;
+}
