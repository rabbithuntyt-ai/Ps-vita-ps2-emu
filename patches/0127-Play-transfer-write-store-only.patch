+	template <typename Storage>
+	uint64 TimeTransfers(uint8* ram, const uint8* source, uint32 w, uint32 h, uint32 transfers, bool compare, uint64 (*clock)())
+	{
+		bool saved = g_compare;
+		g_compare = compare;
+		constexpr bool nibbles = std::is_same<Storage, CGsPixelFormats::STORAGEPSMT4>::value;
+		uint32 bytes = nibbles ? (w * h / 2) : (w * h * static_cast<uint32>(sizeof(typename Storage::Unit)));
+		uint32 bufferWidth = std::max<uint32>(1, w / 64);
+		uint64 start = clock();
+		for(uint32 n = 0; n < transfers; n++)
+		{
+			uint32 pointer = (n * ((bytes + CGsPixelFormats::PAGESIZE - 1) & ~(CGsPixelFormats::PAGESIZE - 1))) % (0x400000 - 0x40000);
+			uint32 rrx = 0, rry = 0;
+			POSITION position{rrx, rry, 0, 0, w};
+			if constexpr(nibbles)
+				WritePsmt4(ram, 0x400000, pointer, bufferWidth, position, source, bytes);
+			else
+				WriteUnits<Storage>(ram, 0x400000, pointer, bufferWidth, position, reinterpret_cast<const typename Storage::Unit*>(source), w * h);
+		}
+		uint64 elapsed = clock() - start;
+		g_compare = saved;
+		return elapsed;
+	}
