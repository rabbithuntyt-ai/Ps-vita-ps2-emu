-void CCodeGen_AArch32::LoadClampConstants()
-{
-	m_assembler.Adrl(CAArch32Assembler::r1, g_fpClampMask1);
-	m_assembler.Vld1_32x4(g_clampMask1Register, CAArch32Assembler::r1);
-	m_assembler.Adrl(CAArch32Assembler::r1, g_fpClampMask2);
-	m_assembler.Vld1_32x4(g_clampMask2Register, CAArch32Assembler::r1);
-}
-
-void CCodeGen_AArch32::Emit_Prolog()
-{
-	if(m_chained)
-	{
-		m_assembler.Stmdb(CAArch32Assembler::rSP, m_registerSave);
-		m_assembler.Vpush(CAArch32Assembler::d8, 8);
-		m_assembler.Mov(CAArch32Assembler::r11, CAArch32Assembler::r0);
-		//Every chained function may clamp: the masks stay loaded across the chain
-		LoadClampConstants();
-		m_assembler.Mov(CAArch32Assembler::r0, CAArch32Assembler::rSP);
-		m_assembler.Bic(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(0xF, 0));
-		m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(0xC, 0));
-		m_assembler.Stmdb(CAArch32Assembler::rSP, (1 << CAArch32Assembler::r0));
-		m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(g_chainedStackSize >> 8, 12));
-		//Functions jumping here through a link slot already built the frame
-		m_linkEntryOffset = static_cast<uint32>(m_stream->GetLength());
-		if(m_chainedExtraStack != 0)
-		{
-			LoadConstantInRegister(CAArch32Assembler::r0, m_chainedExtraStack);
-			m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::r0);
-			m_assembler.Mov(CAArch32Assembler::r0, CAArch32Assembler::r11);
-		}
-		m_stackLevel = 0;
-		return;
-	}
-
-	m_assembler.Stmdb(CAArch32Assembler::rSP, m_registerSave);
-	if(m_saveFpRegisters)
-	{
-		m_assembler.Vpush(CAArch32Assembler::d8, 8);
-	}
-	m_assembler.Mov(CAArch32Assembler::r11, CAArch32Assembler::r0);
-	if(m_usesClampConstants)
-	{
-		LoadClampConstants();
-	}
-
-	//Align stack to 16 bytes boundary
-	m_assembler.Mov(CAArch32Assembler::r0, CAArch32Assembler::rSP);
-	m_assembler.Bic(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(0xF, 0));
-	m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(0xC, 0));
-	m_assembler.Stmdb(CAArch32Assembler::rSP, (1 << CAArch32Assembler::r0));
-
-	if(m_stackSize != 0)
-	{
-		uint8 allocImm = 0, allocSa = 0;
-		bool succeeded = TryGetAluImmediateParams(m_stackSize, allocImm, allocSa);
-		if(succeeded)
-		{
-			m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, CAArch32Assembler::MakeImmediateAluOperand(allocImm, allocSa));
-		}
-		else
-		{
-			auto stackResReg = CAArch32Assembler::r0;
-			LoadConstantInRegister(stackResReg, m_stackSize);
-			m_assembler.Sub(CAArch32Assembler::rSP, CAArch32Assembler::rSP, stackResReg);
-		}
-	}
-	m_stackLevel = 0;
-}
