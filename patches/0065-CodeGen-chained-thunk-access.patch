-//Calls a handler with parameters already in r0-r2. Allocated GPRs and FP32 registers
-//are callee saved, allocated MD registers are not.
-void CCodeGen_AArch32::Emit_GuestMemoryHandlerCall(uintptr_t handler)
-{
-	bool saveMd = (m_mdRegisterFirst != -1);
-	auto firstMd = static_cast<CAArch32Assembler::DOUBLE_REGISTER>(CAArch32Assembler::d16 + (m_mdRegisterFirst * 2));
-	uint8 mdCount = saveMd ? static_cast<uint8>((m_mdRegisterLast - m_mdRegisterFirst + 1) * 2) : 0;
-	if(saveMd)
-	{
-		m_assembler.Vpush(firstMd, mdCount);
-	}
-	LoadConstantPtrInRegister(CAArch32Assembler::r12, handler);
-	m_assembler.Blx(CAArch32Assembler::r12);
-	if(saveMd)
-	{
-		m_assembler.Vpop(firstMd, mdCount);
-	}
-}
