+
+	auto src1Reg = PrepareSymbolRegisterUse(src1, CAArch32Assembler::r1);
+	auto src2Reg = PrepareSymbolRegisterUse(src2, CAArch32Assembler::r2);
+
+	m_assembler.Cmp(src1Reg, src2Reg);
+}
