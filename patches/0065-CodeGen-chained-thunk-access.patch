+static bool g_chainedFrames = (getenv("CODEGEN_AARCH32_CHAINED") != nullptr);
+
+//Chained frame layout (identical for every function)
+static constexpr uint16 g_chainedRegisterSave =
+    (1 << CAArch32Assembler::r4) | (1 << CAArch32Assembler::r5) | (1 << CAArch32Assembler::r6) | (1 << CAArch32Assembler::r7) |
+    (1 << CAArch32Assembler::r8) | (1 << CAArch32Assembler::r9) | (1 << CAArch32Assembler::r10) | (1 << CAArch32Assembler::r11) | (1 << CAArch32Assembler::rLR);
+static constexpr uint32 g_chainedStackSize = 0x200; //temporaries and 128-bit parameter spill slots
